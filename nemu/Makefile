# Sanity check
ifeq ($(wildcard $(NEMU_HOME)/src/nemu-main.c),)
  $(error NEMU_HOME=$(NEMU_HOME) is not a NEMU repo)
endif

# Include variables and rules generated by menuconfig
-include $(NEMU_HOME)/include/config/auto.conf
-include $(NEMU_HOME)/include/config/auto.conf.cmd

remove_quote = $(patsubst "%",%,$(1))

# Extract variabls from menuconfig
GUEST_ISA ?= $(call remove_quote,$(CONFIG_ISA))
ENGINE ?= $(call remove_quote,$(CONFIG_ENGINE))
NAME    = $(GUEST_ISA)-nemu-$(ENGINE)

# Include all filelist.mk to merge file lists
FILELIST_MK = $(shell find -L ./src -name "filelist.mk")
include $(FILELIST_MK)

# Filter out directories and files in blacklist to obtain the final set of source files
DIRS-BLACKLIST-y += $(DIRS-BLACKLIST)
SRCS-BLACKLIST-y += $(if $(DIRS-BLACKLIST-y), $(shell find -L $(DIRS-BLACKLIST-y) -name "*.c"),)
SRCS-BLACKLIST-y += $(SRCS-BLACKLIST)
SRCS-y += $(if $(DIRS-y), $(shell find -L $(DIRS-y) -name "*.c"),)
SRCS = $(filter-out $(SRCS-BLACKLIST-y),$(SRCS-y))

# Extract compiler and options from menuconfig
ifneq ($(CONFIG_CC),)
CC = $(call remove_quote,$(CONFIG_CC))
endif
CFLAGS_BUILD += $(call remove_quote,$(CONFIG_CC_OPT))
CFLAGS_BUILD += $(if $(CONFIG_CC_LTO),-flto,)
CFLAGS_BUILD += $(if $(CONFIG_CC_DEBUG),-Og -ggdb3,)
CFLAGS_BUILD += $(if $(CONFIG_CC_ASAN),-fsanitize=address,)
CFLAGS_TRACE += -DITRACE_COND=$(if $(CONFIG_ITRACE_COND),$(call remove_quote,$(CONFIG_ITRACE_COND)),true)
CFLAGS_TRACE += -DMTRACE_COND=$(if $(CONFIG_MTRACE_COND),$(call remove_quote,$(CONFIG_MTRACE_COND)),true)
CFLAGS_TRACE += -DFTRACE_COND=$(if $(CONFIG_FTRACE_COND),$(call remove_quote,$(CONFIG_FTRACE_COND)),true)
CFLAGS  += $(CFLAGS_BUILD) $(CFLAGS_TRACE) -D__GUEST_ISA__=$(GUEST_ISA)
LDFLAGS += $(CFLAGS_BUILD)

# Include rules for menuconfig
include $(NEMU_HOME)/scripts/config.mk

ifdef CONFIG_TARGET_AM
include $(AM_HOME)/Makefile
LINKAGE += $(ARCHIVES)
else
# Include rules to build NEMU
include $(NEMU_HOME)/scripts/native.mk
endif
# =======================
# Expr test: 存在测试文件的情况
# =======================

# 默认的测试文件和可执行文件位置
TEST_DIR   ?= $(NEMU_HOME)/tools/gen-expr
EXPR_FILE  ?= $(TEST_DIR)/expr.txt
RES_FILE   ?= $(TEST_DIR)/result.txt

# 执行的条数
TEST_N     ?= 100

# 是否显示详细信息
TEST_VERBOSE ?= 0

# 打印默认信息
TEST_PRINT ?= 0

# 真正的nemu可执行文件
NEMU_BIN := $(NEMU_HOME)/build/$(NAME)

.PHONY: gen-expr test testv testp

# 生成 expr.txt / result.txt
gen-expr:
	@echo "[GEN] generating $(TEST_N) cases -> $(EXPR_FILE), $(RES_FILE)"
	@$(TEST_DIR)/gen-expr $(TEST_N) $(EXPR_FILE) $(RES_FILE)

# 跑测试（默认只打印 FAIL + 统计）
test: $(NEMU_BIN)
	@echo "[TEST] $(NEMU_BIN) --test $(EXPR_FILE) $(RES_FILE)"
	@$(NEMU_BIN) --test $(if $(filter 1,$(TEST_VERBOSE)),--test-verbose,) \
	$(if $(filter-out 0,$(TEST_PRINT)),--test-print=$(TEST_PRINT),) \
	$(EXPR_FILE) $(RES_FILE)

# 一键：生成 + 测试
test-all: gen-expr test

# 快捷：强制 verbose
testv: $(NEMU_BIN)
	@$(NEMU_BIN) --test --test-verbose $(EXPR_FILE) $(RES_FILE)

# 快捷：打印前 N 条（用 TEST_PRINT 指定）
testp: $(NEMU_BIN)
	@if [ "$(TEST_PRINT)" = "0" ]; then echo "Usage: make testp TEST_PRINT=20"; exit 1; fi
	@$(NEMU_BIN) --test --test-print=$(TEST_PRINT) $(EXPR_FILE) $(RES_FILE)

# =======================
# Expr test: 若不存在测试文件的情况
# =======================

# 生成器可执行文件的目录
TEST_DIR   ?= $(NEMU_HOME)/tools/gen-expr

# 可执行文件生成的txt测试文件
EXPR_FILE  ?= $(TEST_DIR)/expr.txt
RES_FILE   ?= $(TEST_DIR)/result.txt

# 设置默认生成的测试条目
TEST_N     ?= 100

# 可执行文件目录
GEN_EXPR_BIN := $(TEST_DIR)/gen-expr
GEN_EXPR_SRC := $(TEST_DIR)/gen-expr.c
NEMU_BIN     := $(NEMU_HOME)/build/$(NAME)

# 打印控制控制信息
TEST_VERBOSE ?= 0
TEST_PRINT   ?= 0

.PHONY: expr-gen expr-test expr-test-all

# 第一步：在不存在可运行文件的情况下，编译生成可执行文件
$(GEN_EXPR_BIN): $(GEN_EXPR_SRC)
	@echo "[BUILD] gen-expr -> $(GEN_EXPR_BIN)"
	@$(CC) -O2 -std=c99 -Wall -Werror -o $@ $<

# 第二步：生成 expr.txt / result.txt，用可执行文件来运行生成所谓的txt文件
expr-gen: $(GEN_EXPR_BIN)
	@echo "[GEN] $(TEST_N) cases -> $(EXPR_FILE) + $(RES_FILE)"
	@$(GEN_EXPR_BIN) $(TEST_N) $(EXPR_FILE) $(RES_FILE)

# 第三步：用 NEMU 进入 --test 模式进行纯exp表达式的测试
expr-test: $(NEMU_BIN)
	@echo "[RUN] $(NEMU_BIN) --test $(EXPR_FILE) $(RES_FILE)"
	@$(NEMU_BIN) --test \
	$(if $(filter 1,$(TEST_VERBOSE)),--test-verbose,) \
	$(if $(filter-out 0,$(TEST_PRINT)),--test-print=$(TEST_PRINT),) \
	$(EXPR_FILE) $(RES_FILE)

# 最后总的运行命令
expr-test-all: expr-gen expr-test


# =======================
# Image copy / load 镜像源更换方式
# =======================

# 运行时镜像目录（在nemu里面）
IMG_DIR  ?= build/IMG_resources
# 镜像名
IMG_NAME ?= test.bin
# 镜像源目录真正的python运行后的结果
IMG_SRC_DIR ?= ../IMG
# 真正的源镜像文件
IMG_SRC     ?= $(IMG_SRC_DIR)/$(IMG_NAME)
# 使用NEMU实际加载的镜像
IMG_DST     ?= $(IMG_DIR)/$(IMG_NAME)

.PHONY: img-copy img-load img-run

# 准备镜像（复制 + 校验）
img-copy:
	@mkdir -p $(IMG_DIR)
	@if [ ! -f "$(IMG_SRC)" ]; then \
		echo "Error: source image '$(IMG_SRC)' not found"; \
		echo "Hint: make img-copy IMG_NAME=test.bin (or set IMG_SRC_DIR=...)"; \
		exit 1; \
	fi
	@cp $(IMG_SRC) $(IMG_DST)
	@echo "[CP] $(IMG_SRC) -> $(IMG_DST)"

# 用 NEMU 加载并运行镜像
img-load: $(NEMU_BIN)
	@echo "[LOAD] $(NEMU_BIN) $(IMG_DST)"
	@if [ ! -f "$(IMG_DST)" ]; then \
		echo "Error: dest image '$(IMG_DST)' not found"; \
		echo "Hint: run 'make img-copy IMG_NAME=xxx.bin' first, or use 'make img-run'"; \
		exit 1; \
	fi
	@$(NEMU_BIN) $(IMG_DST)

img-run: img-copy img-load

.PHONY: list
list:
	@echo "==================== NEMU Makefile Command List ===================="
	@echo ""
	@echo "[Build / Compile]"
	@echo "  make"
	@echo "      Build NEMU (default target from native.mk / AM Makefile)."
	@echo "      NEMU binary: $(NEMU_BIN)"
	@echo ""
	@echo "[Expr Test - quick workflow (use prebuilt gen-expr)]"
	@echo "  make gen-expr [TEST_N=100]"
	@echo "      Generate expr test data:"
	@echo "        expr   : $(EXPR_FILE)"
	@echo "        result : $(RES_FILE)"
	@echo "      Example:"
	@echo "        make gen-expr TEST_N=1000"
	@echo ""
	@echo "  make test [TEST_VERBOSE=0] [TEST_PRINT=0]"
	@echo "      Run NEMU expr test using existing expr.txt/result.txt."
	@echo "      Options:"
	@echo "        TEST_VERBOSE=1          -> add '--test-verbose'"
	@echo "        TEST_PRINT=20           -> add '--test-print=20'"
	@echo "      Examples:"
	@echo "        make test"
	@echo "        make test TEST_VERBOSE=1"
	@echo "        make test TEST_PRINT=20"
	@echo "        make test TEST_VERBOSE=1 TEST_PRINT=20"
	@echo ""
	@echo "  make test-all [TEST_N=100]"
	@echo "      One-shot: gen-expr + test"
	@echo "      Example:"
	@echo "        make test-all TEST_N=10000"
	@echo ""
	@echo "  make testv"
	@echo "      Shortcut: verbose test"
	@echo "      Equivalent:"
	@echo "        make test TEST_VERBOSE=1"
	@echo ""
	@echo "  make testp TEST_PRINT=20"
	@echo "      Shortcut: print first N cases"
	@echo "      Equivalent:"
	@echo "        make test TEST_PRINT=20"
	@echo ""
	@echo "[Expr Test - full pipeline (auto build tools/gen-expr)]"
	@echo "  make expr-gen [TEST_N=100]"
	@echo "      Auto-build $(GEN_EXPR_BIN) if needed, then generate txt."
	@echo "      Example:"
	@echo "        make expr-gen TEST_N=5000"
	@echo ""
	@echo "  make expr-test [TEST_VERBOSE=0] [TEST_PRINT=0]"
	@echo "      Run expr test with the same options as 'make test'."
	@echo "      Examples:"
	@echo "        make expr-test"
	@echo "        make expr-test TEST_VERBOSE=1"
	@echo "        make expr-test TEST_PRINT=50"
	@echo ""
	@echo "  make expr-test-all [TEST_N=100]"
	@echo "      Recommended: expr-gen + expr-test"
	@echo "      Example:"
	@echo "        make expr-test-all TEST_N=10000 TEST_VERBOSE=1 TEST_PRINT=20"
	@echo ""
	@echo "[Image (custom, NO conflict with builtin 'run'/'help')]"
	@echo "  make img-copy [IMG_NAME=test.bin] [IMG_SRC_DIR=../IMG] [IMG_DIR=build/IMG_resources]"
	@echo "      Copy binary image into build dir (auto mkdir -p)."
	@echo "      Default:"
	@echo "        source: $(IMG_SRC)"
	@echo "        dest  : $(IMG_DST)"
	@echo "      Examples:"
	@echo "        make img-copy IMG_NAME=hello.bin"
	@echo "        make img-copy IMG_SRC_DIR=../IMG2 IMG_NAME=test.bin"
	@echo ""
	@echo "  make img-load [IMG_NAME=test.bin] [IMG_DIR=build/IMG_resources]"
	@echo "      Run NEMU with copied image (dest must exist)."
	@echo "      Example:"
	@echo "        make img-load IMG_NAME=test.bin"
	@echo ""
	@echo "  make img-run [IMG_NAME=test.bin] [IMG_SRC_DIR=../IMG] [IMG_DIR=build/IMG_resources]"
	@echo "      One-shot: img-copy + img-load"
	@echo "      Examples:"
	@echo "        make img-run IMG_NAME=test.bin"
	@echo "        make img-run IMG_NAME=hello.bin"
	@echo ""
	@echo "[Notes]"
	@echo "  - Variables can be placed before or after the target:"
	@echo "      make test TEST_VERBOSE=1"
	@echo "      make TEST_VERBOSE=1 test"
	@echo "    Both are equivalent."
	@echo "  - This 'list' is your custom help. NEMU builtin help still exists:"
	@echo "      make help"
	@echo "=========================================================================="
