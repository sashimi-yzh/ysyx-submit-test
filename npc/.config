CONFIG_MODE_SYSTEM=y
CONFIG_TARGET_NATIVE_ELF=y
# CONFIG_TARGET_SHARE is not set
# CONFIG_TARGET_AM is not set
# CONFIG_NPC is not set
CONFIG_SOC=y
# CONFIG_NPC_IVERILOG is not set
# CONFIG_NPC_IVERILOG_NET is not set
CONFIG_NPC_VERILATOR=y

#
# Build Options
#
CONFIG_CC_GCC=y
# CONFIG_CC_GPP is not set
