# Sanity check
ifeq ($(wildcard $(NPC_HOME)/vsrc/top.v),)
  $(error NPC_HOME=$(NPC_HOME) is not a NPC repo)
endif

# Include variables and rules generated by menuconfig
-include $(NPC_HOME)/include/config/auto.conf
-include $(NPC_HOME)/include/config/auto.conf.cmd

remove_quote = $(patsubst "%",%,$(1))

# Extract variabls from menuconfig
GUEST_ISA ?= $(call remove_quote,$(CONFIG_ISA))
ENGINE ?= $(call remove_quote,$(CONFIG_ENGINE))
NAME    = $(GUEST_ISA)-npc-$(ENGINE)

# Include all filelist.mk to merge file lists
FILELIST_MK = $(shell find -L ./csrc -name "filelist.mk")
# Include filelist.mk for RTL code
FILELIST_MK += $(shell find -L ./vsrc -name "filelist.mk")

ifneq ($(strip $(CONFIG_SOC)),)
# soc filelist
FILELIST_MK += soc_filelist.mk
endif

include $(FILELIST_MK)

# Filter out directories and files in blacklist to obtain the final set of source files
DIRS-BLACKLIST-y += $(DIRS-BLACKLIST)
SRCS-BLACKLIST-y += $(SRCS-BLACKLIST) $(shell find -L $(DIRS-BLACKLIST-y) -name "*.c")
SRCS-y += $(shell find -L $(DIRS-y) -name "*.c")
SRCS = $(filter-out $(SRCS-BLACKLIST-y),$(SRCS-y))

# Extract compiler and options from menuconfig
CC = $(call remove_quote,$(CONFIG_CC))
CFLAGS_BUILD += $(call remove_quote,$(CONFIG_CC_OPT))
CFLAGS_BUILD += $(if $(CONFIG_CC_LTO),-flto,)
CFLAGS_BUILD += $(if $(CONFIG_CC_DEBUG),-Og -ggdb3,)
CFLAGS_BUILD += $(if $(CONFIG_CC_ASAN),-fsanitize=address,)
CFLAGS_TRACE += -DITRACE_COND=$(if $(CONFIG_ITRACE_COND),$(call remove_quote,$(CONFIG_ITRACE_COND)),true)
CFLAGS  += $(CFLAGS_BUILD) $(CFLAGS_TRACE) -D__GUEST_ISA__=$(GUEST_ISA)
CXXFLAGS += $(CFLAGS_BUILD) $(CFLAGS_TRACE) -D__GUEST_ISA__=$(GUEST_ISA)
LDFLAGS += $(CFLAGS_BUILD)

# Include rules for menuconfig
include $(NPC_HOME)/scripts/config.mk

ifdef CONFIG_TARGET_AM
include $(AM_HOME)/Makefile
LINKAGE += $(ARCHIVES)
else
# Include rules to build NPC
include $(NPC_HOME)/scripts/native.mk
endif

count:
	@find . -name "*.c" -o -name "*.h" | xargs grep -v '^[[:space:]]*$$' | wc -l | xargs echo "Total non-empty lines in .c and .h files:"

perf:
	cd ../yosys-sta
	make sta
	cd ../am-kernels/benchmarks/microbench
	make ARCH=riscv32e-ysyxsoc mainargs=train run

# Also prepare host tools and generated config, so a fresh checkout with
# only .config can build: fixdep, auto.conf and generated/autoconf.h
verilog: $(FIXDEP) $(CONF)
	$(Q)$(CONF) $(silent) --syncconfig $(Kconfig)
	@ echo "Generating verilog build for CI"
	@ mkdir -p $(NPC_HOME)/build
	cp $(NPC_HOME)/vsrc/ysyx_24110012.v $(NPC_HOME)/build/

# make -C npc sim-iverilog IMG=xxx.bin
# Same .bin -> readmemh conversion as AM's npc.mk, then reuse the iverilog
# `run` flow with the configs forced on, so it also works without menuconfig.
IVER_HEX = $(BUILD_DIR)/mem_iverilog.txt

# Same .bin -> readmemh conversion as AM's npc.mk `image` target
img:
	@test -n "$(IMG)" || (echo "Usage: make sim-iverilog IMG=xxx.bin"; exit 1)
	@mkdir -p $(BUILD_DIR)
	objcopy -I binary -O verilog --verilog-data-width=4 $(IMG) $(IVER_HEX)

# Separate vvp per target, removed before each run: `$(BINARY)` is only
# rebuilt by timestamp, so a shared one could silently run the other design.
IVER_RTL_BIN = $(BUILD_DIR)/sim-iverilog.vvp
IVER_NET_BIN = $(BUILD_DIR)/sim-iverilog-netlist.vvp

sim-iverilog: verilog img
	@rm -f $(IVER_RTL_BIN)
	$(MAKE) run CONFIG_NPC=y CONFIG_SOC= CONFIG_NPC_IVERILOG=y CONFIG_NPC_IVERILOG_NET= \
		CONFIG_DIFFTEST= IVER_ARGS=$(IVER_HEX) BINARY=$(IVER_RTL_BIN)

# make -C npc sim-iverilog-netlist IMG=xxx.bin NETLIST=yyy CELLS=zzz
sim-iverilog-netlist: img
	@test -n "$(NETLIST)" -a -n "$(CELLS)" || \
		(echo "Usage: make sim-iverilog-netlist IMG=xxx.bin NETLIST=yyy CELLS=zzz"; exit 1)
	@rm -f $(IVER_NET_BIN)
	$(MAKE) run CONFIG_NPC=y CONFIG_SOC= CONFIG_NPC_IVERILOG= CONFIG_NPC_IVERILOG_NET=y \
		CONFIG_DIFFTEST= IVER_ARGS=$(IVER_HEX) BINARY=$(IVER_NET_BIN) \
		NETLIST=$(abspath $(NETLIST)) CELLS=$(abspath $(CELLS))

.PHONY: verilog img sim-iverilog sim-iverilog-netlist
