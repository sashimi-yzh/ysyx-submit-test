//| mill-version: 1.1.5

package build

import mill._
import mill.scalalib._
import mill.scalalib.scalafmt.ScalafmtModule
import mill.scalalib.TestModule.ScalaTest
import mill.api.Task.Simple

trait BaseModule extends ScalaModule with ScalafmtModule { m =>
  override def scalaVersion = "2.13.18"
  def chiselVersion = "7.11.0"

  def myScalaTestVersion = "3.2.20"

  override def scalacOptions = Seq(
    "-language:reflectiveCalls",
    "-deprecation",
    "-feature",
    "-Xcheckinit",
    "-Ymacro-annotations"
  )

  override def mvnDeps = Seq(
    mvn"org.chipsalliance::chisel:$chiselVersion",
    mvn"cn.ac.ios.tis::riscvspeccore:1.3-chisel7.11.0-7e43b32-SNAPSHOT",
    // mvn"cn.ac.ios.tis::riscvspeccore:1.3-SNAPSHOT",
  )

  override def scalacPluginMvnDeps = Seq(mvn"org.chipsalliance:::chisel-plugin:$chiselVersion")

  override def forkArgs = Task {
    super.forkArgs() ++ Seq(s"-Dproject.root=${mill.api.BuildCtx.workspaceRoot}")
  }

  trait BaseTests extends ScalaTests with TestModule.ScalaTest with ScalafmtModule {
    override def mvnDeps = Task {
      m.mvnDeps() ++ Seq(
        mvn"org.scalatest::scalatest:$myScalaTestVersion"
//        ivy"edu.berkeley.cs::chiseltest:6.0.0"
      )
    }
  }

  object test extends BaseTests {
    // def rvopcodes = Task.Source(mill.api.BuildCtx.workspaceRoot / "rvdecoderdb" / "riscv-opcodes")
    def workspaceRoot = Task.Source(mill.api.BuildCtx.workspaceRoot)

    def forkEnv = super.forkEnv() ++ Map(
      "WORKSPACE_ROOT_DIR" -> workspaceRoot().path.toString
    )
  }
}

// object ChiRVFormal extends BaseModule {
//   def chiRvFormal = Task.Source(mill.api.BuildCtx.workspaceRoot / "ChiRVFormal")
//   override def sources = Task {
//     super.sources() ++ Seq(chiRvFormal())
//   }
// }

object common extends BaseModule {
  def rvopcodedb = Task.Source(mill.api.BuildCtx.workspaceRoot / "rvdecoderdb" / "rvdecoderdb")
  override def sources = Task {
    super.sources() ++ Seq(rvopcodedb())
  }
}

object generator extends BaseModule {
  override def moduleDeps = Seq(common)
}

object playground extends BaseModule {
  override def moduleDeps = Seq(common)

  override def generatedSources: T[Seq[PathRef]] = Task {
    val dest = Task.dest
    val cp = generator.runClasspath().map(_.path).mkString(":")

    os.proc(
      "java",
      s"-Dproject.root=${mill.api.BuildCtx.workspaceRoot}",
      "-cp",
      cp,
      "sirius.GenCtrlSignals",
      dest.toString()
    ).call(stdout = os.Inherit, stderr = os.Inherit)

    Seq(PathRef(dest))
  }
}
