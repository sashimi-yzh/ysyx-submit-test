if NPC

menu "NPC skip difftest"

# CLINT
menuconfig NPC_SKIP_CLINT
    bool "Skip CLINT"
    default n
if NPC_SKIP_CLINT
config NPC_CLINT_START
    hex "CLINT start address"
    default 0x02000000
config NPC_CLINT_END
    hex "CLINT end address"
    default 0x0200ffff
endif

# SRAM
menuconfig NPC_SKIP_SRAM
    bool "Skip SRAM"
    default n
if NPC_SKIP_SRAM
config NPC_SRAM_START
    hex "SRAM start address"
    default 0x0f000000
config NPC_SRAM_END
    hex "SRAM end address"
    default 0x0fffffff
endif

# UART16550
menuconfig NPC_SKIP_UART
    bool "Skip serial"
    default y
if NPC_SKIP_UART
config NPC_UART_START
    hex "MMIO address of the UART16550 start"
    default 0x10000000
config NPC_UART_END
    hex "MMIO address of the UART16550 end"
    default 0x10000fff
endif

# SPI master
menuconfig NPC_SKIP_SPI
    bool "Skip SPI master"
    default n
if NPC_SKIP_SPI
config NPC_SPI_START
    hex "SPI master start address"
    default 0x10001000
config NPC_SPI_END
    hex "SPI master end address"
    default 0x10001fff
endif

