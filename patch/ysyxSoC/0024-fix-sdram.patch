---
 perip/sdram/core_sdram_axi4/sdram_axi_core.v | 23 +++++++++++++++-----
 1 file changed, 18 insertions(+), 5 deletions(-)

diff --git a/perip/sdram/core_sdram_axi4/sdram_axi_core.v b/perip/sdram/core_sdram_axi4/sdram_axi_core.v
index 8b45bf2e..c8c5042a 100644
--- a/perip/sdram/core_sdram_axi4/sdram_axi_core.v
+++ b/perip/sdram/core_sdram_axi4/sdram_axi_core.v
@@ -177,11 +177,24 @@ reg  [STATE_W-1:0]     target_state_r;
 reg  [STATE_W-1:0]     target_state_q;
 reg  [STATE_W-1:0]     delay_state_q;
 
-// Address bits
-wire [SDRAM_ROW_W-1:0]  addr_col_w  = {{(SDRAM_ROW_W-SDRAM_COL_W){1'b0}}, ram_addr_w[SDRAM_COL_W:2], 1'b0};
-wire [SDRAM_ROW_W-1:0]  addr_row_w  = ram_addr_w[SDRAM_ADDR_W:SDRAM_COL_W+2+1];
-wire [SDRAM_BANK_W-1:0] addr_bank_w = ram_addr_w[SDRAM_COL_W+2:SDRAM_COL_W+2-1];
-wire                    addr_word_sel = ram_addr_w[SDRAM_ADDR_W];
+// AXI address → SDRAM {rank, bank, row, col}:
+//   addr[26]     rank
+//   addr[25:24]  bank
+//   addr[23:11]  row
+//   addr[10:2]   column
+//   addr[1:0]    byte offset
+localparam AXI_COL_LO   = 2;
+localparam AXI_COL_HI   = AXI_COL_LO + SDRAM_COL_W - 1;      // 10
+localparam AXI_ROW_LO   = AXI_COL_HI + 1;                     // 11
+localparam AXI_ROW_HI   = AXI_ROW_LO + SDRAM_ROW_W - 1;       // 23
+localparam AXI_BANK_LO  = AXI_ROW_HI + 1;                     // 24
+localparam AXI_BANK_HI  = AXI_BANK_LO + SDRAM_BANK_W - 1;     // 25
+localparam AXI_RANK_BIT = AXI_BANK_HI + 1;                    // 26
+
+wire [SDRAM_ROW_W-1:0]  addr_col_w  = {{(SDRAM_ROW_W-SDRAM_COL_W){1'b0}}, ram_addr_w[AXI_COL_HI:AXI_COL_LO]};
+wire [SDRAM_ROW_W-1:0]  addr_row_w  = ram_addr_w[AXI_ROW_HI:AXI_ROW_LO];
+wire [SDRAM_BANK_W-1:0] addr_bank_w = ram_addr_w[AXI_BANK_HI:AXI_BANK_LO];
+wire                    addr_word_sel = ram_addr_w[AXI_RANK_BIT];
 
 //-----------------------------------------------------------------
 // SDRAM State Machine
-- 
