From ce0f85c35f7af59571bffda3e6a58ede4c5f7254 Mon Sep 17 00:00:00 2001
From: sunmingyang <2326103265@qq.com>
Date: Sun, 23 Aug 2026 13:26:23 +0800
Subject: [PATCH] add uart_to_console flag

---
 perip/uart16550/rtl/uart_tfifo.v | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/perip/uart16550/rtl/uart_tfifo.v b/perip/uart16550/rtl/uart_tfifo.v
index 71329116..370e1a95 100644
--- a/perip/uart16550/rtl/uart_tfifo.v
+++ b/perip/uart16550/rtl/uart_tfifo.v
@@ -211,7 +211,10 @@ begin
             begin
                 top   <= #1 top_plus_1;
                 count <= #1 count + 1'b1;
+`ifdef __UART_TO_CONSOLE__
                 $write("%c", data_in);
+                $fflush(1);
+`endif
             end
         2'b01 : if(count>0)
             begin
@@ -221,7 +224,10 @@ begin
         2'b11 : begin
                 bottom <= #1 bottom + 1'b1;
                 top    <= #1 top_plus_1;
+`ifdef __UART_TO_CONSOLE__
                 $write("%c", data_in);
+                $fflush(1);
+`endif
                 end
         default: ;
         endcase
-- 
2.53.0

