 Makefile                     |  6 ++++++
 patch/rocket-chip-sram.patch | 17 +++++++++++++++++
 patch/rocket-chip.patch      | 17 -----------------
 3 files changed, 23 insertions(+), 17 deletions(-)
 create mode 100644 patch/rocket-chip-sram.patch

diff --git a/Makefile b/Makefile
index a9042a24..1aedb4fa 100644
--- a/Makefile
+++ b/Makefile
@@ -6,7 +6,13 @@ SCALA_FILES = $(shell find src/ -name "*.scala")
 FIRTOOL_VERSION = 1.105.0
 FIRTOOL_PATCH_DIR = $(shell pwd)/patch/firtool
 
+ROCKET_CHIP_MY_PATCH = patch/rocket-chip-sram.patch
+
 $(V_FILE_FINAL): $(SCALA_FILES)
+	cd rocket-chip && \
+	if ! git apply --check --reverse ../$(ROCKET_CHIP_MY_PATCH) >/dev/null 2>&1; then \
+		git apply ../$(ROCKET_CHIP_MY_PATCH); \
+	fi
 # Replace firtool with a newer version
 # TODO: This can be removed after chisel publishes a new version
 	@./patch/update-firtool.sh $(FIRTOOL_VERSION) $(FIRTOOL_PATCH_DIR)
