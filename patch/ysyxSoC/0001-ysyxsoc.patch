+        xip_wb_stb <= 1'b1;
+        xip_wb_cyc <= 1'b1;
+        if (wb_ack) xip_state <= WR_TX0;
+      end
+
+      WR_TX0: begin
+        xip_wb_adr <= 5'd0;
+        xip_wb_dat <= 32'd0;
+        xip_wb_we  <= 1'b1;
+        xip_wb_stb <= 1'b1;
+        xip_wb_cyc <= 1'b1;
+        if (wb_ack) xip_state <= WR_CTRL;
+      end
+
+      WR_CTRL: begin
+        xip_wb_adr <= 5'd16;
+        xip_wb_dat <= (1 << 13) | (0 << 11) | (1 << 10) | (0 << 9) | (1 << 8) | 64;
+        xip_wb_we  <= 1'b1;
+        xip_wb_stb <= 1'b1;
+        xip_wb_cyc <= 1'b1;
+        if (wb_ack) xip_state <= POLL_GO;
+      end
+
+      POLL_GO: begin
+        xip_wb_adr <= 5'd16;
+        xip_wb_we  <= 1'b0;
+        xip_wb_stb <= 1'b1;
+        xip_wb_cyc <= 1'b1;
+        if (wb_ack && !wb_rdata[8]) xip_state <= RD_RX;
+      end
+
+      RD_RX: begin
+        xip_wb_adr <= 5'd0;
+        xip_wb_we  <= 1'b0;
+        xip_wb_stb <= 1'b1;
+        xip_wb_cyc <= 1'b1;
+        if (wb_ack) begin
+          xip_state <= DONE;
+        end
+      end
+
+      DONE: begin
+        xip_wb_stb <= 1'b0;
+        xip_wb_cyc <= 1'b0;
+        if (!in_psel) xip_state <= IDLE;
+      end
+
+      default: xip_state <= IDLE;
+    endcase
+  end
+end
+
 `endif // FAST_FLASH
 
 endmodule
