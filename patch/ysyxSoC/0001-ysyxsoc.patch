index d9bdd882..b45e0bda 100644
--- a/perip/psram/psram.v
+++ b/perip/psram/psram.v
@@ -1,9 +1,137 @@
 module psram(
   input sck,
-  input ce_n,
+  input ce_n,          // SS, active low
   inout [3:0] dio
 );
 
-  assign dio = 4'bz;
+  reg [7:0] mem [0:16777215];
+
+  // ----- state -----
+  reg [2:0] state;
+  localparam cmd_t   = 3'd0;
+  localparam addr_t  = 3'd1;
+  localparam dummy_t = 3'd2;
+  localparam rdata_t = 3'd3;
+  localparam wdata_t = 3'd4;
+
+  reg [ 7:0] cmd;
+  reg [23:0] addr;
+  reg [ 7:0] counter;
+  reg [31:0] rdata;
+  reg [31:0] wbuf;
+
+  reg qpi_mode;
+
+  // ----- QPI -----
+  localparam CMD_END      = 8'd1;
+  localparam ADDR_END     = 8'd7;
+  localparam DUMMY_END    = 8'd13;
+  localparam RDATA_END    = 8'd21;
+  localparam WDATA_END    = 8'd15;
+  localparam RDATA_LATCH  = 8'd8;
+  localparam R_BYTE_BASE  = 8'd7;
+  localparam W_BYTE_BASE  = 8'd4;
+
+  // ----- dio -----
+  reg  [3:0] dio_out;
+  wire       dio_oe;
+  assign dio = dio_oe ? dio_out : 4'bz;
+
+  always @(posedge sck or posedge ce_n) begin
+    if (ce_n) begin
+      state   <= cmd_t;
+      counter <= 8'd0;
+    end else begin
+      counter <= counter + 8'd1;
+
+      case (state)
+        cmd_t: begin
+          if (qpi_mode) begin
+            cmd <= {cmd[3:0], dio};
+            if (counter == CMD_END)
+              state <= addr_t;
+          end else begin
+            cmd <= {cmd[6:0], dio[0]};
+            if (counter == 8'd7) begin
+              if ({cmd[6:0], dio[0]} == 8'h35) begin
+                qpi_mode <= 1'b1;
+                counter  <= 8'd0;
+              end else
+                state <= addr_t;
+            end
+          end
+        end
+
+        addr_t: begin
+          addr <= {addr[19:0], dio};
+          if (counter == ADDR_END) begin
+            case (cmd)
+              8'hEB: state <= dummy_t;
+              8'h38: state <= wdata_t;
+              default: state <= cmd_t;
+            endcase
+          end
+        end
+
+        dummy_t: begin
+          if (counter == RDATA_LATCH) begin
+            rdata[ 7: 0] <= mem[{addr[23:2], 2'b00}];
+            rdata[15: 8] <= mem[{addr[23:2], 2'b01}];
+            rdata[23:16] <= mem[{addr[23:2], 2'b10}];
+            rdata[31:24] <= mem[{addr[23:2], 2'b11}];
+          end
+          if (counter == DUMMY_END)
+            state <= rdata_t;
+        end
+
+        rdata_t: begin
+          if (counter == RDATA_END)
+            state <= cmd_t;
+        end
+
+        wdata_t: begin
+          if (counter == WDATA_END)
+            state <= cmd_t;
+        end
+
+        default: state <= cmd_t;
+      endcase
+    end
+  end
+
+  // ----- Read -----
+  wire [1:0] r_byte_idx = {counter[7:1] - R_BYTE_BASE}[1:0];
+  wire       r_high     = !counter[0];
+
+  always @(posedge sck or posedge ce_n) begin
+    if (ce_n) begin
+      rdata <= 32'd0;
+    end else if (state == rdata_t) begin
+      if (r_high)
+        dio_out <= rdata[r_byte_idx*8 + 4 +: 4];
+      else
+        dio_out <= rdata[r_byte_idx*8 +: 4];
+    end
+  end
+
+  assign dio_oe = (state == rdata_t) || (counter == (RDATA_END + 8'd1));
+
+  // ----- Write -----
+  wire [1:0] w_byte_idx = {counter[7:1] - W_BYTE_BASE}[1:0];
+  wire       w_high     = !counter[0];
+  wire [23:0] waddr     = addr + {22'b0, w_byte_idx};
+
+  always @(posedge sck or posedge ce_n) begin
+    if (ce_n) begin
+      wbuf  <= 32'd0;
+    end else if (state == wdata_t) begin
+      if (w_high)
+        wbuf[w_byte_idx*8 + 4 +: 4] <= dio;
+      else begin
+        wbuf[w_byte_idx*8 +: 4] <= dio;
+        mem[waddr] <= {wbuf[w_byte_idx*8 + 4 +: 4], dio};
+      end
+    end
+  end
 
 endmodule
