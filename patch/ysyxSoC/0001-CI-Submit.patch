diff --git a/perip/vga/image_rom_640x480.v b/perip/vga/image_rom_640x480.v
new file mode 100644
index 00000000..1e97893a
--- /dev/null
+++ b/perip/vga/image_rom_640x480.v
@@ -0,0 +1,55 @@
+module image_rom_640x480 (
+    input wire clk,
+    input wire reset,
+    input wire [9:0] v_addr,
+    input wire [9:0] h_addr,
+    output reg [23:0] vga_data,
+
+    input wire [9:0] v_waddr,
+    input wire [9:0] h_waddr,
+    input wire [23:0] vga_wdata,
+    input wire vga_wen
+
+);
+
+localparam WIDTH = 640;
+localparam HEIGHT = 480;
+localparam TOTAL_PIXELS = WIDTH * HEIGHT;
+
+reg [23:0] ram [0:TOTAL_PIXELS-1];
+
+wire [18:0] linear_addr; 
+wire [18:0] linear_waddr; 
+
+assign linear_addr = v_addr * 10'd640 + {9'd0, h_addr};
+assign linear_waddr = v_waddr * 10'd640 + {9'd0, h_waddr};
+
+always @(*)begin
+    if (v_addr < HEIGHT && h_addr < WIDTH) begin
+        vga_data = ram[linear_addr];
+    end else begin
+        vga_data = 24'h000000;
+    end
+end
+
+always @(posedge clk or posedge reset) begin
+    if (reset) begin
+        // integer i;
+        // for (i = 0; i < TOTAL_PIXELS; i = i + 1) begin
+        //     ram[i] <= 24'h000000; // Initialize to black
+        // end
+    end else begin
+        if (v_waddr < HEIGHT && h_waddr < WIDTH && vga_wen) begin
+            ram[linear_waddr] <= vga_wdata;
+        end
+    end
+end
+
+initial begin
+    // $readmemh("/home/seaber/ysyx-workbench/ysyxSoC/perip/vga/image_data.mif", ram);
+    integer i;
+    for (i = 0; i < TOTAL_PIXELS; i = i + 1) begin
+        ram[i] = 24'h000000; // Initialize to black
+    end
+end
+endmodule
diff --git a/perip/vga/vga_top_apb.v b/perip/vga/vga_top_apb.v
index 5c74cfbe..6ee89c27 100644
--- a/perip/vga/vga_top_apb.v
+++ b/perip/vga/vga_top_apb.v
@@ -8,7 +8,7 @@ module vga_top_apb(
   input         in_pwrite,
   input  [31:0] in_pwdata,
   input  [3:0]  in_pstrb,
-  output        in_pready,
+  output reg    in_pready,
   output [31:0] in_prdata,
   output        in_pslverr,
 
@@ -20,4 +20,102 @@ module vga_top_apb(
   output        vga_valid
 );
 
+  wire [31:0] in_addr_h;
+  wire [31:0] in_addr_v;
+  assign in_addr_h = (((in_paddr-32'h21000000) >> 2) % (640*480)) % 640;
+  assign in_addr_v = (((in_paddr-32'h21000000) >> 2) % (640*480)) / 640;
+  wire in_wen = in_psel && ~in_penable && in_pwrite;
+  assign in_pslverr = 1'b0;
+  always @(posedge clock or posedge reset) begin
+    if(reset) begin
+      in_pready <= 1'b0;
+    end else begin
+      if(in_psel && ~in_penable) begin
+        in_pready <= 1'b1;
+      end else begin
+        in_pready <= 1'b0;
+      end
+    end
+  end
+
+
+
+
+
+
+
+
+
+
+
+  wire [23:0] vga_data;
+  wire [9:0] h_addr;
+  wire [9:0] v_addr;
+  wire vsync;
+  wire hsync;
+
+
+  parameter h_frontporch = 96;
+  parameter h_active = 144;
+  parameter h_backporch = 784;
+  parameter h_total = 800;
+
+  parameter v_frontporch = 2;
+  parameter v_active = 35;
+  parameter v_backporch = 515;
+  parameter v_total = 525;
+
+  reg [9:0] x_cnt;
+  reg [9:0] y_cnt;
+  wire h_valid;
+  wire v_valid;
+
+  always @(posedge reset or posedge clock) //行像素计数
+      if (reset == 1'b1)
+        x_cnt <= 1;
+      else
+      begin
+        if (x_cnt == h_total)
+            x_cnt <= 1;
+        else
+            x_cnt <= x_cnt + 10'd1;
+      end
+
+  always @(posedge clock)  //列像素计数
+      if (reset == 1'b1)
+        y_cnt <= 1;
+      else
+      begin
+        if (y_cnt == v_total & x_cnt == h_total)
+            y_cnt <= 1;
+        else if (x_cnt == h_total)
+            y_cnt <= y_cnt + 10'd1;
+      end
+
+  //生成同步信号    
+  assign vga_hsync = (x_cnt > h_frontporch);
+  assign vga_vsync = (y_cnt > v_frontporch);
+  //生成消隐信号
+  assign h_valid = (x_cnt > h_active) & (x_cnt <= h_backporch);
+  assign v_valid = (y_cnt > v_active) & (y_cnt <= v_backporch);
+  assign vga_valid = h_valid & v_valid;
+  //计算当前有效像素坐标
+  assign h_addr = h_valid ? (x_cnt - 10'd145) : 10'd0;
+  assign v_addr = v_valid ? (y_cnt - 10'd36) : 10'd0;
+  //设置输出的颜色值
+  assign {vga_r, vga_g, vga_b} = vga_data;
+  
+
+  image_rom_640x480 vmem_inst(
+    .clk(clock),
+    .reset(reset),
+    .v_addr(v_addr),
+    .h_addr(h_addr),
+    .vga_data(vga_data),
+
+    .v_waddr(in_addr_v[9:0]),
+    .h_waddr(in_addr_h[9:0]),
+    .vga_wdata(in_pwdata[23:0]),
+    .vga_wen(in_wen)
+  );
 endmodule
