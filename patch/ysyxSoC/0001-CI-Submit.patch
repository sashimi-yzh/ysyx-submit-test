diff --git a/perip/spi/rtl/spi_XIP.v b/perip/spi/rtl/spi_XIP.v
new file mode 100644
index 00000000..c6c51fb5
--- /dev/null
+++ b/perip/spi/rtl/spi_XIP.v
@@ -0,0 +1,311 @@
+module spi_XIP
+(
+  wb_clk_i, wb_rst_i, 
+  
+  wb_paddr_i, wb_pwdata_i, wb_prdata_o, wb_pstrb_i,
+  wb_pwrite_i, wb_psel_i, wb_penable_i, wb_pready_o, wb_pslverr_o, wb_irq_o,
+
+  slv_paddr_o, slv_wdata_o, slv_rdata_i, slv_pstrb_o,
+  slv_pwrite_o, slv_psel_o, slv_penable_o, slv_pready_i, slv_pslverr_i, slv_irq_i
+
+);
+
+  input                            wb_clk_i;         // master clock input
+  input                            wb_rst_i;         // synchronous active high reset
+  
+  input                     [31:0] wb_paddr_i;         // lower address bits
+  input                   [32-1:0] wb_pwdata_i;         // databus input
+  output reg              [32-1:0] wb_prdata_o;         // databus output
+  input                      [3:0] wb_pstrb_i;         // byte select inputs
+  input                            wb_pwrite_i;          // write enable input
+  input                            wb_psel_i;         // stobe/core select signal
+  input                            wb_penable_i;         // valid bus cycle input
+  output reg                       wb_pready_o;         // bus cycle acknowledge output
+  output reg                       wb_pslverr_o;         // termination w/ error
+  output reg                       wb_irq_o;         // interrupt request signal output
+
+  output reg                 [4:0] slv_paddr_o;        // slave address output
+  output reg              [32-1:0] slv_wdata_o;        // slave data output
+  input                   [32-1:0] slv_rdata_i;        // slave data input
+  output reg                 [3:0] slv_pstrb_o;        // slave byte select output
+  output reg                       slv_pwrite_o;         // slave write enable output
+  output reg                       slv_psel_o;        // slave stobe/core select signal output
+  output reg                       slv_penable_o;        // slave valid bus cycle signal output
+  input                            slv_pready_i;        // slave bus cycle acknowledge input
+  input                            slv_pslverr_i;        // slave termination w/ error input
+  input                            slv_irq_i;        // slave interrupt request signal input
+
+  
+  reg [3:0] sstate,next_sstate;
+  localparam SS_IDLE   = 4'b0000;
+  localparam SS_SETUP  = 4'b0001;
+  localparam SS_ACCESS = 4'b0010;
+
+  reg [3:0] state,next_state;
+  localparam  S_IDLE       = 4'b0000;
+  localparam  S_SET_DATA   = 4'b0001;
+  localparam  S_SET_DIV    = 4'b0010;
+  localparam  S_SET_SS     = 4'b0011;
+  localparam  S_SET_CTRL   = 4'b0100;
+  localparam  S_SET_START  = 4'b0101;
+  localparam  S_SET_WAIT   = 4'b0110;
+  localparam  S_SET_RECV    = 4'b0111;
+  localparam  S_SET_RET    = 4'b1000;
+
+  always @(posedge wb_clk_i or posedge wb_rst_i) begin
+    if(wb_rst_i) begin
+      state <= S_IDLE;
+      sstate <= SS_IDLE;
+    end else begin
+      state <= next_state;
+      sstate <= next_sstate;
+    end
+  end
+
+  always @(*) begin
+    case(state)
+      S_IDLE: begin
+        if(wb_psel_i && !wb_penable_i) begin
+          next_state = S_SET_DATA;
+          is_transfer = 1'b1;
+        end else begin
+          next_state = S_IDLE;
+          is_transfer = 1'b0;
+        end
+        buf_wdata = 32'hdeadbeef;
+        buf_paddr = 5'b00000;
+        buf_pstrb = 4'b0000;
+        buf_pwrite= 1'b0;
+      end
+      S_SET_DATA: begin
+        if(sstate == SS_ACCESS && next_sstate != SS_ACCESS) begin
+          next_state = S_SET_DIV;
+          is_transfer = 1'b1;
+        end else begin
+          next_state = S_SET_DATA;
+          is_transfer = 1'b1;
+        end
+        buf_wdata = {8'h03,wb_paddr_i[23:0]};
+        buf_paddr = 5'h4;
+        buf_pstrb = 4'b1111;
+        buf_pwrite= 1'b1;
+      end
+      S_SET_DIV: begin
+        if(sstate == SS_ACCESS && next_sstate != SS_ACCESS) begin
+          next_state = S_SET_SS;
+          is_transfer = 1'b1;
+        end else begin
+          next_state = S_SET_DIV;
+          is_transfer = 1'b1;
+        end
+        buf_wdata = {16'h0,16'h1};
+        buf_paddr = 5'h14;
+        buf_pstrb = 4'b0011;
+        buf_pwrite= 1'b1;
+      end
+      S_SET_SS: begin
+        if(sstate == SS_ACCESS && next_sstate != SS_ACCESS) begin
+          next_state = S_SET_CTRL;
+          is_transfer = 1'b1;
+        end else begin
+          next_state = S_SET_SS;
+          is_transfer = 1'b1;
+        end
+        buf_wdata = {24'h0,8'h1};
+        buf_paddr = 5'h18;
+        buf_pstrb = 4'b0001;
+        buf_pwrite= 1'b1;
+      end
+      S_SET_CTRL: begin
+        if(sstate == SS_ACCESS && next_sstate != SS_ACCESS) begin
+          next_state = S_SET_START;
+          is_transfer = 1'b1;
+        end else begin
+          next_state = S_SET_CTRL;
+          is_transfer = 1'b1;
+        end
+        buf_wdata = {32'b011000001000000};
+        buf_paddr = 5'h10;
+        buf_pstrb = 4'b1111;
+        buf_pwrite= 1'b1;
+      end
+      S_SET_START: begin
+        if(sstate == SS_ACCESS && slv_pready_i) begin
+          next_state = S_SET_WAIT;
+          is_transfer = 1'b0;
+        end else begin
+          next_state = S_SET_START;
+          is_transfer = 1'b1;
+        end
+        buf_wdata = {32'b011000101000000};
+        buf_paddr = 5'h10;
+        buf_pstrb = 4'b1111;
+        buf_pwrite= 1'b1;
+      end
+      S_SET_WAIT: begin
+        // if(sstate == SS_ACCESS && next_sstate != SS_ACCESS) begin
+        //   if(!buf_rdata[8]) begin
+        //     next_state = S_SET_RECV;
+        //     is_transfer = 1'b1;
+        //   end else begin
+        //     next_state = S_SET_WAIT;
+        //     is_transfer = 1'b1;
+        //   end
+        if(slv_irq_i) begin
+          next_state = S_SET_RECV;
+          is_transfer = 1'b1;
+        end else begin
+          next_state = S_SET_WAIT;
+          is_transfer = 1'b0;
+        end
+        buf_wdata = {32'hdeadbeef};
+        buf_paddr = 5'h10;
+        buf_pstrb = 4'b1111;
+        buf_pwrite= 1'b0;
+      end
+      S_SET_RECV: begin
+        if(sstate == SS_ACCESS && slv_pready_i) begin
+          next_state = S_SET_RET;
+          is_transfer = 1'b0;
+        end else begin
+          next_state = S_SET_RECV;
+          is_transfer = 1'b1;
+        end
+        buf_wdata = {32'hdeadbeef};
+        buf_paddr = 5'h00;
+        buf_pstrb = 4'b1111;
+        buf_pwrite= 1'b0;
+      end
+      S_SET_RET: begin
+        next_state = S_IDLE;
+        is_transfer = 1'b0;
+        buf_wdata = {32'b010000101000000};
+        buf_paddr = 5'h10;
+        buf_pstrb = 4'b1111;
+        buf_pwrite= 1'b0;
+      end
+      default: begin
+        next_state = S_IDLE;
+        is_transfer = 1'b0;
+
+        buf_wdata = 32'hdeadbeef;
+        buf_paddr = 5'b00000;
+        buf_pstrb = 4'b0000;
+        buf_pwrite= 1'b0;
+      end
+    endcase
+  end
+
+  always @(posedge wb_clk_i or posedge wb_rst_i) begin
+    if(wb_rst_i) begin
+      wb_prdata_o <= 32'hdeadbeef;
+    end else begin
+      if(state == S_SET_RECV && next_state==S_SET_RET) begin
+        wb_prdata_o <= {buf_rdata[7:0],buf_rdata[15:8],buf_rdata[23:16],buf_rdata[31:24]};
+        // wb_prdata_o <= buf_rdata;
+      end else begin
+        wb_prdata_o <= wb_prdata_o;
+      end
+    end
+  end
+  always @(posedge wb_clk_i or posedge wb_rst_i) begin
+    if(wb_rst_i) begin
+      wb_pready_o <= 1'b1;
+      wb_pslverr_o <= 1'b0;
+      wb_irq_o <= 1'b0;
+    end else begin
+      if(state == S_SET_RET) begin
+        wb_pready_o <= 1'b1;
+        wb_pslverr_o <= 1'b0;
+        wb_irq_o <= 1'b0;
+      end else begin
+        wb_pready_o <= 1'b0;
+        wb_pslverr_o <= 1'b0;
+        wb_irq_o <= 1'b0;
+      end
+    end
+  end
+  reg is_transfer;
+  always @(*) begin
+    case(sstate)
+      SS_IDLE: begin
+        if(is_transfer) begin
+          next_sstate = SS_SETUP;
+        end else begin
+          next_sstate = SS_IDLE;
+        end
+      end
+      SS_SETUP: begin
+        next_sstate = SS_ACCESS;
+      end
+      SS_ACCESS: begin
+        if(slv_pready_i) begin
+          if(is_transfer) begin
+            next_sstate = SS_SETUP;
+          end else begin
+            next_sstate = SS_IDLE;
+          end
+        end else begin
+          next_sstate = SS_ACCESS;
+        end
+      end
+      default: begin
+        next_sstate = SS_IDLE;
+      end
+    endcase
+  end
+
+  
+
+
+  reg [31:0] buf_wdata;
+  reg [31:0] buf_rdata;
+  reg [ 4:0] buf_paddr;
+  reg [3:0] buf_pstrb;
+  reg buf_pwrite;
+
+
+  always @(*) begin
+    case(sstate)
+      SS_IDLE: begin
+        slv_paddr_o = 5'b0;
+        slv_wdata_o = 32'b0;
+        slv_pstrb_o = 4'b0;
+        slv_pwrite_o = 1'b0;
+        slv_psel_o = 1'b0;
+        slv_penable_o = 1'b0;
+        buf_rdata = slv_rdata_i;
+      end
+      SS_SETUP: begin
+        slv_paddr_o = buf_paddr;
+        slv_wdata_o = buf_wdata;
+        slv_pstrb_o = buf_pstrb;
+        slv_pwrite_o = buf_pwrite;
+        slv_psel_o = 1'b1;
+        slv_penable_o = 1'b0;
+        buf_rdata = slv_rdata_i;
+      end
+      SS_ACCESS: begin
+        slv_paddr_o = buf_paddr;
+        slv_wdata_o = buf_wdata;
+        slv_pstrb_o = buf_pstrb;
+        slv_pwrite_o = buf_pwrite;
+        slv_psel_o = 1'b1;
+        slv_penable_o = 1'b1;
+        buf_rdata = slv_rdata_i;
+      end
+      default: begin
+        slv_paddr_o = 5'b0;
+        slv_wdata_o = 32'b0;
+        slv_pstrb_o = 4'b0;
+        slv_pwrite_o = 1'b0;
+        slv_psel_o = 1'b0;
+        slv_penable_o = 1'b0;
+        buf_rdata = 32'hdeadbeef;
+      end
+    endcase
+  end
+
+
+
+endmodule
\ No newline at end of file
