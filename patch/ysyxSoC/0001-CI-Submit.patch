diff --git a/perip/gpio/gpio_top_apb.v b/perip/gpio/gpio_top_apb.v
index ec51ffe5..2f0007df 100644
--- a/perip/gpio/gpio_top_apb.v
+++ b/perip/gpio/gpio_top_apb.v
@@ -24,4 +24,127 @@ module gpio_top_apb(
   output [7:0]  gpio_seg_7
 );
 
+  reg [31:0] gpio_seg_reg_input;
+  wire [7:0] gpio_reg_decode[0:7];
+
+  reg [15:0] gpio_out_reg;
+  assign gpio_out = gpio_out_reg;
+  reg [31:0] reg_prdata;
+  assign in_prdata = reg_prdata;
+  assign in_pslverr = 1'b0;
+
+  reg [1:0] state,next_state;
+  parameter S_IDLE  = 2'b00;
+  parameter S_WRITE = 2'b01;
+  parameter S_READ  = 2'b10;
+  
+  always @(posedge clock) begin
+    if(reset) state <= 2'b00;
+    else state <= next_state;
+  end
+
+  always @(*) begin
+    case (state)
+      S_IDLE: begin
+        if(in_pwrite && in_psel && ~in_penable)
+          next_state = S_WRITE;
+        else if (~in_pwrite && in_psel && ~in_penable) 
+          next_state = S_READ;
+        else
+          next_state = S_IDLE;
+      end
+      S_WRITE: begin
+          next_state = S_IDLE;
+      end
+      S_READ: begin
+          next_state = S_IDLE;
+      end
+      default: begin
+        next_state = S_IDLE;
+      end
+    endcase
+  end
+
+  always @(posedge clock) begin
+    if(reset) begin
+      reg_prdata <= 32'b0;
+      gpio_seg_reg_input <= 32'b0;
+      gpio_out_reg <= 16'b0;
+    end else begin
+      gpio_out_reg <= gpio_out_reg;
+      gpio_seg_reg_input <= gpio_seg_reg_input;
+      reg_prdata <= reg_prdata;
+
+      if (state == S_IDLE && next_state == S_WRITE) begin
+        if(in_paddr == 32'h1000_2000) begin
+          gpio_out_reg <= in_pwdata[15:0];
+        end else if(in_paddr == 32'h1000_2008) begin
+          gpio_seg_reg_input <= in_pwdata;
+        end
+      end else if (state == S_IDLE && next_state == S_READ) begin
+        if(in_paddr == 32'h1000_2000) begin
+          reg_prdata <= {16'b0,gpio_out_reg};
+        end else if(in_paddr == 32'h1000_2004) begin
+          reg_prdata <= {16'b0,gpio_in};
+        end else if(in_paddr == 32'h1000_2008) begin
+          reg_prdata <= {gpio_seg_reg_input};
+        end else begin
+          reg_prdata <= 32'hdeadbeef;
+        end
+      end
+    end
+  end
+
+  assign in_pready = (state == S_READ || state == S_WRITE) ? 1'b1 : 1'b0;
+
+  //-----------------------------------------------------------------
+  // BCD to 7-segment decoder
+  // Common anode: segment ON when bit = 0
+  // Segment mapping: {dp, g, f, e, d, c, b, a}
+  //-----------------------------------------------------------------
+  function [7:0] bcd_to_7seg(input [3:0] bcd);
+  begin
+      case (bcd)
+          4'h0: bcd_to_7seg = 8'b00000011; // "0"
+          4'h1: bcd_to_7seg = 8'b10011111; // "1"
+          4'h2: bcd_to_7seg = 8'b00100101; // "2"
+          4'h3: bcd_to_7seg = 8'b00001101; // "3"
+          4'h4: bcd_to_7seg = 8'b10011001; // "4"
+          4'h5: bcd_to_7seg = 8'b01001001; // "5"
+          4'h6: bcd_to_7seg = 8'b01000001; // "6"
+          4'h7: bcd_to_7seg = 8'b00011111; // "7"
+          4'h8: bcd_to_7seg = 8'b00000001; // "8"
+          4'h9: bcd_to_7seg = 8'b00001001; // "9"
+          4'hA: bcd_to_7seg = 8'b00010001; // "A"
+          4'hB: bcd_to_7seg = 8'b11000001; // "B"
+          4'hC: bcd_to_7seg = 8'b01100011; // "C"
+          4'hD: bcd_to_7seg = 8'b10000101; // "D"
+          4'hE: bcd_to_7seg = 8'b01100001; // "E"
+          4'hF: bcd_to_7seg = 8'b01110001; // "F"
+          default: bcd_to_7seg = 8'b11111111; // blank
+      endcase
+  end
+  endfunction
+
+  // gpio_seg_reg_input[31:0] = 8 BCD digits × 4 bits each
+  assign gpio_reg_decode[0] = bcd_to_7seg(gpio_seg_reg_input[ 3: 0]);
+  assign gpio_reg_decode[1] = bcd_to_7seg(gpio_seg_reg_input[ 7: 4]);
+  assign gpio_reg_decode[2] = bcd_to_7seg(gpio_seg_reg_input[11: 8]);
+  assign gpio_reg_decode[3] = bcd_to_7seg(gpio_seg_reg_input[15:12]);
+  assign gpio_reg_decode[4] = bcd_to_7seg(gpio_seg_reg_input[19:16]);
+  assign gpio_reg_decode[5] = bcd_to_7seg(gpio_seg_reg_input[23:20]);
+  assign gpio_reg_decode[6] = bcd_to_7seg(gpio_seg_reg_input[27:24]);
+  assign gpio_reg_decode[7] = bcd_to_7seg(gpio_seg_reg_input[31:28]);
+
+  assign gpio_seg_0 = gpio_reg_decode[0];
+  assign gpio_seg_1 = gpio_reg_decode[1];
+  assign gpio_seg_2 = gpio_reg_decode[2];
+  assign gpio_seg_3 = gpio_reg_decode[3];
+  assign gpio_seg_4 = gpio_reg_decode[4];
+  assign gpio_seg_5 = gpio_reg_decode[5];
+  assign gpio_seg_6 = gpio_reg_decode[6];
+  assign gpio_seg_7 = gpio_reg_decode[7];
+
+  
+
 endmodule
diff --git a/perip/ps2/ps2_top_apb.v b/perip/ps2/ps2_top_apb.v
index 080d38fa..c842438e 100644
--- a/perip/ps2/ps2_top_apb.v
+++ b/perip/ps2/ps2_top_apb.v
@@ -16,4 +16,147 @@ module ps2_top_apb(
   input         ps2_data
 );
 
+  reg [1:0] state,next_state;
+  parameter S_IDLE  = 2'b00;
+  parameter S_READ = 2'b01;
+  
+
+  assign in_prdata = {24'b0,(ps2_data_fifo_empty)?8'b0:ps2_data_fifo[ps2_data_fifo_read[2:0]][7:0]};
+  assign in_pslverr = 1'b0;
+
+  always @(posedge clock) begin
+    if(reset) state <= 2'b00;
+    else state <= next_state;
+  end
+
+  always @(*) begin
+    case (state)
+      S_IDLE: begin
+        if(in_psel && ~in_penable && ~in_pwrite)
+          next_state = S_READ;
+        else
+          next_state = S_IDLE;
+      end
+      S_READ: begin
+        if(pop_enable)
+          next_state = S_IDLE;
+        else
+          next_state = S_READ;
+      end
+      default: begin
+          next_state = S_IDLE;
+      end
+    endcase
+  end
+
+  assign in_pready = (state==S_READ && pop_enable)?1'b1:1'b0;
+
+  /////////////////////////////////////////////////
+  reg [8:0] ps2_data_fifo [0:7]; //8 * 9bit fifo
+  reg [3:0] ps2_data_fifo_read=4'd0,ps2_data_fifo_write=4'd0;
+  wire ps2_data_fifo_empty; assign ps2_data_fifo_empty = (ps2_data_fifo_write==ps2_data_fifo_read);
+  wire ps2_data_fifo_full;  assign ps2_data_fifo_full = (ps2_data_fifo_write==4'd8);
+  wire pop_enable;          assign pop_enable = (state==S_READ && ~ps2_clk_fall);
+  reg [2:0] ps2_clk_record = 3'b111;
+  wire ps2_clk_fall = (ps2_clk_record[2:1]==2'b10);
+
+  always @(posedge clock) begin
+    if(reset) begin
+      ps2_clk_record <= 3'b111;
+    end else begin
+      ps2_clk_record <= {ps2_clk_record[1:0],ps2_clk};
+    end
+  end
+  always @(posedge clock) begin
+    if(reset) begin
+      ps2_data_fifo_read <= 4'd0;
+      ps2_data_fifo_write <= 4'd0;
+      ps2_data_fifo[0] <= 9'b0;
+      ps2_data_fifo[1] <= 9'b0;
+      ps2_data_fifo[2] <= 9'b0;
+      ps2_data_fifo[3] <= 9'b0;
+      ps2_data_fifo[4] <= 9'b0;
+      ps2_data_fifo[5] <= 9'b0;
+      ps2_data_fifo[6] <= 9'b0;
+      ps2_data_fifo[7] <= 9'b0;
+    end else begin
+      if(ps2_clk_fall && (cnt == 4'd10)) begin
+          if(ps2_data_fifo_full) begin
+            ps2_data_fifo[0] <= ps2_data_fifo[1];
+            ps2_data_fifo[1] <= ps2_data_fifo[2];
+            ps2_data_fifo[2] <= ps2_data_fifo[3];
+            ps2_data_fifo[3] <= ps2_data_fifo[4];
+            ps2_data_fifo[4] <= ps2_data_fifo[5];
+            ps2_data_fifo[5] <= ps2_data_fifo[6];
+            ps2_data_fifo[6] <= ps2_data_fifo[7];
+            ps2_data_fifo[7] <= ps2_data_reg;
+          end else begin
+            ps2_data_fifo[ps2_data_fifo_write[2:0]] <= ps2_data_reg;
+            ps2_data_fifo_write <= ps2_data_fifo_write + 1'b1;
+          end
+      end else begin
+        if(pop_enable) begin
+          if(ps2_data_fifo_empty) begin
+
+          end else begin
+            ps2_data_fifo_read <= ps2_data_fifo_read + 1'b1;
+          end
+        end else begin
+          if(ps2_data_fifo_read != 0) begin
+            ps2_data_fifo_read <= ps2_data_fifo_read - 1'b1;
+            ps2_data_fifo_write <= ps2_data_fifo_write - 1'b1;
+            ps2_data_fifo[0] <= ps2_data_fifo[1];
+            ps2_data_fifo[1] <= ps2_data_fifo[2];
+            ps2_data_fifo[2] <= ps2_data_fifo[3];
+            ps2_data_fifo[3] <= ps2_data_fifo[4];
+            ps2_data_fifo[4] <= ps2_data_fifo[5];
+            ps2_data_fifo[5] <= ps2_data_fifo[6];
+            ps2_data_fifo[6] <= ps2_data_fifo[7];
+            ps2_data_fifo[7] <= 9'b0;
+          end
+        end
+      end
+    end
+  end
+
+
