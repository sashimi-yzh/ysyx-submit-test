+  reg [31:0] sdram_rdata;
+  assign wire_dq_out = sdram_rdata[15:0];
+  always@(*)begin
+    sdram_read(reg_active_addr,{28'b0,count},sdram_rdata,{30'b0,sel});
+  end
+
+  always @(*) begin
+    if((|mode_BT) || mode_BL[2]) begin
+      $fwrite(32'h80000002, "Assertion failed: Burst Type is not supported\n");
+      $fatal;
+    end
+  end
 
 endmodule
