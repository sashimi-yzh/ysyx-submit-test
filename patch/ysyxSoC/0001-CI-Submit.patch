diff --git a/perip/bitrev/bitrev.v b/perip/bitrev/bitrev.v
index f1c3b363..0bb05e92 100644
--- a/perip/bitrev/bitrev.v
+++ b/perip/bitrev/bitrev.v
@@ -2,7 +2,89 @@ module bitrev (
   input  sck,
   input  ss,
   input  mosi,
-  output miso
+  output reg miso
 );
-  assign miso = 1'b1;
+  reg [7:0]cnt,next_cnt;
+  reg [1:0]state,next_state;
+  parameter S_IDLE = 0;
+  parameter S_RECV = 1;
+  parameter S_SEND = 2;
+
+  always @(posedge sck) begin
+    if(ss) begin
+      state <= S_IDLE;
+      cnt <= 0;
+    end else begin
+      state <= next_state;
+      cnt <= next_cnt;
+    end
+  end
+
+  always @(*) begin
+    case(state)
+      S_IDLE: begin
+        if(ss) begin
+          next_state = S_IDLE;
+          next_cnt = 0;
+        end else begin
+          next_state = S_RECV;
+          next_cnt = 1;
+        end
+      end
+      S_RECV: begin
+        if(ss) begin
+          next_state = S_IDLE;
+          next_cnt = 0;
+        end else begin
+          if(cnt == 7) begin
+            next_cnt = 0;
+            next_state = S_SEND;
+          end else begin
+            next_state = S_RECV;
+            next_cnt = cnt + 1;
+          end
+        end
+      end
+      S_SEND: begin
+        if(ss) begin
+          next_state = S_IDLE;
+          next_cnt = 0;
+        end else begin
+          if(cnt == 7) begin
+            next_cnt = 0;
+            next_state = S_IDLE;
+          end else begin
+            next_state = S_SEND;
+            next_cnt = cnt + 1;
+          end
+        end
+      end
+    endcase
+  end
+
+  reg [15:0] rev;
+  always @(posedge sck) begin
+    if(ss) begin
+      rev <= 0;
+    end else begin
+      if(next_state == S_RECV || (state==S_RECV && next_state == S_SEND)) begin
+        rev <= {rev[14:0], mosi};
+      end else if(next_state == S_SEND || ((state==S_SEND) && (next_state == S_IDLE))) begin
+        rev <= {1'b0,rev[15:1]};
+      end
+    end
+  end
+
+  always @(posedge sck) begin
+    if(ss) begin
+      miso <= 1;
+    end else begin
+      if(state == S_SEND) begin
+        miso <= rev[0];
+      end else begin
+        miso <= 1;
+      end
+    end
+  end
+
 endmodule
