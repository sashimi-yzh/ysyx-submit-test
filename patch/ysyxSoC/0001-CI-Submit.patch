+      // end else if(wstate == S_WAIT && wnext_state == S_DELAY) begin
+      //   wcnt <= 32'd5 - 32'd1;
+      end else if(wstate == S_DELAY || wnext_state == S_DELAY) begin
+        wcnt <= wcnt - s;
+      end else begin
+        wcnt <= 32'd0;
+      end
+    end
+  end
+
+  always @(*) begin
+    case (wstate)
+      S_IDLE: begin
+       if(in_awvalid || in_wvalid) begin
+          wnext_state = S_WAIT;
+        end else begin
+          wnext_state = S_IDLE;
+        end
+      end
+      S_WAIT: begin
+        if(out_bvalid) begin
+          wnext_state = S_DELAY;
+        end else begin
+          wnext_state = S_WAIT;
+        end
+      end
+      S_DELAY: begin
+        if(wcnt < s) begin
+          if(in_bready) begin
+            wnext_state = S_IDLE;
+          end else begin
+            wnext_state = S_DONE;
+          end
+        end else begin
+          wnext_state = S_DELAY;
+        end
+      end
+      S_DONE: begin
+        if(in_bready) begin
+          wnext_state = S_IDLE;
+        end else begin
+          wnext_state = S_DONE;
+        end
+      end
+      default: begin
+        wnext_state = S_IDLE;
+      end
+    endcase
+  end
+
+  always @(*) begin
+    in_bvalid = bvalid_reg;
+    in_bid = bid_reg;
+    in_bresp = bresp_reg;
+  end
+
+  reg       bvalid_reg;
+  reg [3:0] bid_reg;
+  reg [1:0] bresp_reg;
+
+  always @(posedge clock or posedge reset) begin
+    if (reset) begin
+      bvalid_reg <= 1'b0;
+      bid_reg <= 4'b0;
+      bresp_reg <= 2'b0;
+    end else begin
+      if(wstate == S_WAIT && wnext_state == S_DELAY) begin
+        // bvalid_reg <= out_bvalid;
+        bid_reg <= out_bid;
+        bresp_reg <= out_bresp;
+      end else if((wstate == S_DELAY && wnext_state == S_IDLE)||(wstate==S_DONE && wnext_state == S_IDLE)) begin
+        // bvalid_reg <= 1'b0;
+        bid_reg <= 4'b0;
+        bresp_reg <= 2'b0;
+      end else begin
+        // bvalid_reg <= bvalid_reg;
+        bid_reg <= bid_reg;
+        bresp_reg <= bresp_reg;
+      end
+      if((wstate == S_DELAY && wnext_state == S_IDLE)||(wstate==S_DONE && wnext_state == S_IDLE)) begin
+        bvalid_reg <= 1'b0;
+      end else if(wstate==S_DELAY && wcnt < 2*s) begin
+        bvalid_reg <= 1'b1;
+      end else begin
+        bvalid_reg <= bvalid_reg;
+      end
+      
+    end
+  end
 endmodule
+
+
+module axi_read_delayer_single(
+  input         clock,
+  input         reset,
+
+  input         in_arvalid,
+  input         in_rready,
+
+  output reg        in_rvalid,
+  output reg [3:0]  in_rid,
+  output reg [31:0] in_rdata,
+  output reg [1:0]  in_rresp,
+  output reg        in_rlast,
+
+  input         out_rvalid,
+  input  [3:0]  out_rid,
+  input  [31:0] out_rdata,
+  input  [1:0]  out_rresp,
+  input         out_rlast
+);
+  parameter S_IDLE  = 2'b00;
+  parameter S_WAIT  = 2'b01;
+  parameter S_DELAY = 2'b10;
+  parameter S_DONE  = 2'b11;
+  parameter [31:0]s = 32'd1;
+  parameter [31:0]sk = 32'd1;
+  // assign in_rvalid = out_rvalid;
+  // assign in_rid = out_rid;
+  // assign in_rdata = out_rdata;
+  // assign in_rresp = out_rresp;
+  // assign in_rlast = out_rlast;
+  reg [1:0] rstate,rnext_state;
+  reg [31:0] rcnt;
+  always @(posedge clock or posedge reset) begin
+    if (reset) begin
+      rstate <= S_IDLE;
+    end else begin
+      rstate <= rnext_state;
+    end
+  end
+
+  always @(posedge clock or posedge reset) begin
+    if (reset) begin
+      rcnt <= 32'b0;
+    end else begin
+      if(rstate == S_IDLE && rnext_state == S_WAIT) begin
+        rcnt <= sk;
+      end else if(rstate == S_WAIT && rnext_state == S_WAIT) begin
+        rcnt <= rcnt + sk;
+      // end else if(rstate == S_WAIT && rnext_state == S_DELAY) begin
+      //   rcnt <= 32'd5 - 32'd1;
+      end else if(rstate == S_DELAY || rnext_state == S_DELAY) begin
+        rcnt <= rcnt - s;
+      end else begin
+        rcnt <= 32'd0;
+      end
+    end
+  end
+
+  always @(*) begin
+    case (rstate)
+      S_IDLE: begin
+        if(in_arvalid) begin
+          rnext_state = S_WAIT;
+        end else begin
+          rnext_state = S_IDLE;
+        end
+      end
+      S_WAIT: begin
+        if(out_rvalid) begin
+          rnext_state = S_DELAY;
+        end else begin
+          rnext_state = S_WAIT;
+        end
+      end
+      S_DELAY: begin
+        if(rcnt < s) begin
+          if(in_rready) begin
+            rnext_state = S_IDLE;
+          end else begin
+            rnext_state = S_DONE;
+          end
+        end else begin
+          rnext_state = S_DELAY;
+        end
+      end
+      S_DONE: begin
+        if(in_rready) begin
+          rnext_state = S_IDLE;
+        end else begin
+          rnext_state = S_DONE;
+        end
+      end
+      default: begin
+        rnext_state = S_IDLE;
+      end
+    endcase
+  end
+
+  always @(*) begin
+    in_rvalid = rvalid_reg;
+    in_rid = rid_reg;
+    in_rdata = rdata_reg;
+    in_rresp = rresp_reg;
+    in_rlast = rlast_reg;
+  end
+
+  reg       rvalid_reg;
+  reg [3:0] rid_reg;
+  reg [31:0]rdata_reg;
+  reg [1:0] rresp_reg;
+  reg       rlast_reg;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      rvalid_reg <= 1'b0;
+      rid_reg <= 4'b0;
+      rdata_reg <= 32'b0;
+      rresp_reg <= 2'b0;
+      rlast_reg <= 1'b0;
+    end else begin
+      if(rstate == S_WAIT && rnext_state == S_DELAY) begin
+        // rvalid_reg <= 1'b1;
+        rid_reg <= out_rid;
+        rdata_reg <= out_rdata;
+        rresp_reg <= out_rresp;
+        rlast_reg <= out_rlast;
+      end else if((rstate == S_DELAY && rnext_state == S_IDLE)||(rstate==S_DONE && rnext_state == S_IDLE)) begin
+        // rvalid_reg <= 1'b0;
+        rid_reg <= 4'b0;
+        rdata_reg <= 32'b0;
+        rresp_reg <= 2'b0;
+        rlast_reg <= 1'b0;
+      end else begin
+        // rvalid_reg <= rvalid_reg;
+        rid_reg <= rid_reg;
+        rdata_reg <= rdata_reg;
+        rresp_reg <= rresp_reg;
+        rlast_reg <= rlast_reg;
+      end
+      if((rstate == S_DELAY && rnext_state == S_IDLE)||(rstate==S_DONE && rnext_state == S_IDLE)) begin
+        rvalid_reg <= 1'b0;
+      end else if(rstate==S_DELAY && rcnt < 2*s) begin
+        rvalid_reg <= 1'b1;
+      end else begin
+        rvalid_reg <= rvalid_reg;
+      end
+    end
+
+  end
+
+endmodule
