From a7eca2e5b244f76ba00f51bab0dc4e7f79bb6faf Mon Sep 17 00:00:00 2001
From: "Wang, Yuan1" <hallo_sun@hotmail.com>
Date: Tue, 23 Jun 2026 03:04:48 +0000
Subject: [PATCH 40/40] [axi_delay] update delay counter decrease method

The previous method is uncorrect by divided 8.
It should be minus 8 each time.

Signed-off-by: Wang, Yuan1 <hallo_sun@hotmail.com>
---
 perip/amba/axi4_delayer.v | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/perip/amba/axi4_delayer.v b/perip/amba/axi4_delayer.v
index c8d30676..c6b9804f 100644
--- a/perip/amba/axi4_delayer.v
+++ b/perip/amba/axi4_delayer.v
@@ -158,7 +158,7 @@ module axi4_delayer(
         ST_DELAY_RD: begin
           if (delay_cnt_rd > 32'd1) begin
             // actually / by 8
-            delay_cnt_rd <= delay_cnt_rd >> 32'd3;
+            delay_cnt_rd <= delay_cnt_rd - 32'd8;
           end else begin
             delay_cnt_rd <= 32'b0;
             state_rd     <= ST_RESP_RD;
@@ -206,7 +206,7 @@ module axi4_delayer(
         ST_DELAY_WR: begin
           if (delay_cnt_wr > 32'd1) begin
             // actually / by 8
-            delay_cnt_wr <= delay_cnt_wr >> 32'd3;
+            delay_cnt_wr <= delay_cnt_wr - 32'd8;
           end else begin
             delay_cnt_wr <= 32'b0;
             state_wr     <= ST_RESP_WR;
-- 
2.34.1

