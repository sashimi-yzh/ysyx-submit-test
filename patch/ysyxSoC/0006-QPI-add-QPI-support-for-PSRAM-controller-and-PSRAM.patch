From c8046fcd1aaf7c8c60b6a7a1f88d6f02a110811f Mon Sep 17 00:00:00 2001
From: "Wang, Yuan1" <hallo_sun@hotmail.com>
Date: Wed, 14 Jan 2026 06:43:05 +0000
Subject: [PATCH 06/40] [QPI] add QPI support for PSRAM controller and PSRAM

Signed-off-by: Wang, Yuan1 <hallo_sun@hotmail.com>
---
 perip/psram/efabless/EF_PSRAM_CTRL.v    | 72 +++++++++++++++----------
 perip/psram/efabless/EF_PSRAM_CTRL_wb.v | 55 +++++++++++++++----
 perip/psram/psram.v                     | 38 ++++++++++---
 3 files changed, 120 insertions(+), 45 deletions(-)

diff --git a/perip/psram/efabless/EF_PSRAM_CTRL.v b/perip/psram/efabless/EF_PSRAM_CTRL.v
index b6e737e9..6b27561f 100644
--- a/perip/psram/efabless/EF_PSRAM_CTRL.v
+++ b/perip/psram/efabless/EF_PSRAM_CTRL.v
@@ -60,7 +60,11 @@ module PSRAM_READER (
     localparam  IDLE = 1'b0,
                 READ = 1'b1;
 
-    wire [7:0]  FINAL_COUNT = 19 + size*2; // was 27: Always read 1 word
+    // QPI Timing Calculation:
+    // CMD (2 cycles) + ADDR (6 cycles) + DUMMY (6 cycles) = 14 cycles before data
+    // Data Phase = size * 2 cycles
+    // FINAL_COUNT = 14 + (size * 2) - 1
+    wire [7:0]  FINAL_COUNT = 13 + size*2; // was 15: Always read 1 word
 
     reg         state, nstate;
     reg [7:0]   counter;
@@ -112,23 +116,28 @@ module PSRAM_READER (
             //saddr <= {addr[23:2], 2'b0};
             saddr <= {addr[23:0]};
 
-    // Sample with the negedge of sck
-    wire[1:0] byte_index = {counter[7:1] - 8'd10}[1:0];
+    // Data Sampling
+    // Data starts at cycle 14. Every 2 cycles = 1 byte.
+    wire [7:0] data_offset = counter - 8'd14;
+    wire [1:0] byte_index  = data_offset[2:1]; // cycle 14-15 -> 0, 16-17 -> 1...
+
     always @ (posedge clk)
-        if(counter >= 20 && counter <= FINAL_COUNT)
+        if(counter >= 14 && counter <= FINAL_COUNT)
             if(sck)
                 data[byte_index] <= {data[byte_index][3:0], din}; // Optimize!
 
-    assign dout     =   (counter < 8)   ?   {3'b0, CMD_EBH[7 - counter]}:
-                        (counter == 8)  ?   saddr[23:20]        :
-                        (counter == 9)  ?   saddr[19:16]        :
-                        (counter == 10) ?   saddr[15:12]        :
-                        (counter == 11) ?   saddr[11:8]         :
-                        (counter == 12) ?   saddr[7:4]          :
-                        (counter == 13) ?   saddr[3:0]          :
-                        4'h0;
+    // Output Data & Command (QPI Mode)
+    // Instruction and Address are both sent via 4-lines
+    assign dout = (counter == 0) ? CMD_EBH[7:4] :   // Instruction High Nibble
+                    (counter == 1) ? CMD_EBH[3:0] : // Instruction Low Nibble
+                    (counter == 2) ? saddr[23:20] :
+                    (counter == 3) ? saddr[19:16] :
+                    (counter == 4) ? saddr[15:12] :
+                    (counter == 5) ? saddr[11:8]  :
+                    (counter == 6) ? saddr[7:4]   :
+                    (counter == 7) ? saddr[3:0]   : 4'h0;
 
-    assign douten   = (counter < 14);
+    assign douten   = (counter < 8);
 
     assign done     = (counter == FINAL_COUNT+1);
 
@@ -161,7 +170,10 @@ module PSRAM_WRITER (
     localparam  IDLE = 1'b0,
                 WRITE = 1'b1;
 
-    wire[7:0]        FINAL_COUNT = 13 + size*2;
+    // QPI Write Timing:
+    // CMD (2 cycles) + ADDR (6 cycles) + DATA (size * 2 cycles)
+    // FINAL_COUNT = 2 + 6 + (size * 2) - 1 = 7 + (size * 2)
+    wire [7:0] FINAL_COUNT = 7 + (size * 2);
 
     reg         state, nstate;
     reg [7:0]   counter;
@@ -212,21 +224,23 @@ module PSRAM_WRITER (
         else if((state == IDLE) && wr)
             saddr <= addr;
 
-    assign dout     =   (counter < 8)   ?   {3'b0, CMD_38H[7 - counter]}:
-                        (counter == 8)  ?   saddr[23:20]        :
-                        (counter == 9)  ?   saddr[19:16]        :
-                        (counter == 10) ?   saddr[15:12]        :
-                        (counter == 11) ?   saddr[11:8]         :
-                        (counter == 12) ?   saddr[7:4]          :
-                        (counter == 13) ?   saddr[3:0]          :
-                        (counter == 14) ?   line[7:4]           :
-                        (counter == 15) ?   line[3:0]           :
-                        (counter == 16) ?   line[15:12]         :
-                        (counter == 17) ?   line[11:8]          :
-                        (counter == 18) ?   line[23:20]         :
-                        (counter == 19) ?   line[19:16]         :
-                        (counter == 20) ?   line[31:28]         :
-                        line[27:24];
+    // Output Data logic (QPI Only)
+    assign dout = (counter == 0) ? CMD_38H[7:4] : // Instruction High
+                    (counter == 1) ? CMD_38H[3:0] : // Instruction Low
+                    (counter == 2) ? saddr[23:20] : // Address bytes...
+                    (counter == 3) ? saddr[19:16] :
+                    (counter == 4) ? saddr[15:12] :
+                    (counter == 5) ? saddr[11:8]  :
+                    (counter == 6) ? saddr[7:4]   :
+                    (counter == 7) ? saddr[3:0]   :
+                    (counter == 8) ? line[7:4]   : // Byte 0 High
+                    (counter == 9) ? line[3:0]   : // Byte 0 Low
+                    (counter == 10)? line[15:12] : // Byte 1 High
+                    (counter == 11)? line[11:8]  : // Byte 1 Low
+                    (counter == 12)? line[23:20] : // Byte 2 High
+                    (counter == 13)? line[19:16] : // Byte 2 Low
+                    (counter == 14)? line[31:28] : // Byte 3 High
+                    line[27:24];                  // Byte 3 Low
 
     assign douten   = (~ce_n);
 
diff --git a/perip/psram/efabless/EF_PSRAM_CTRL_wb.v b/perip/psram/efabless/EF_PSRAM_CTRL_wb.v
index 7b5296db..3da90b77 100644
--- a/perip/psram/efabless/EF_PSRAM_CTRL_wb.v
+++ b/perip/psram/efabless/EF_PSRAM_CTRL_wb.v
@@ -39,8 +39,9 @@ module EF_PSRAM_CTRL_wb (
     output  wire [3:0]      douten
 );
 
-    localparam  ST_IDLE = 1'b0,
-                ST_WAIT = 1'b1;
+    localparam  ST_INIT = 2'd0,
+                ST_IDLE = 2'd1,
+                ST_WAIT = 2'd2;
 
     wire        mr_sck;
     wire        mr_ce_n;
@@ -69,15 +70,29 @@ module EF_PSRAM_CTRL_wb (
     //wire[3:0]   wb_byte_sel     =   sel_i & {4{wb_we}};
 
     // The FSM
-    reg         state, nstate;
+    reg [1:0] state, nstate;
+
+    // cmd for QPI set (0x35 = 8'h35)
+    // init_cnt to 8 since the psram read with 1 clock delay
+    reg [3:0] init_cnt;
+    wire      init_done = (state == ST_INIT && init_cnt == 4'd8);
+    reg [7:0] init_cmd = 8'h35;
+
     always @ (posedge clk_i or posedge rst_i)
         if(rst_i)
-            state <= ST_IDLE;
+            state <= ST_INIT;
         else
             state <= nstate;
 
     always @* begin
-        case(state)
+        case (state)
+
+            ST_INIT :
+                if(init_done)
+                  nstate = ST_IDLE;
+                else
+                  nstate = ST_INIT;
+
             ST_IDLE :
                 if(wb_valid)
                     nstate = ST_WAIT;
@@ -89,9 +104,28 @@ module EF_PSRAM_CTRL_wb (
                     nstate = ST_IDLE;
                 else
                     nstate = ST_WAIT;
+            default :
+                nstate = ST_INIT;
         endcase
     end
 
+    // init stage signals update
+    reg mi_sck;
+    wire mi_ce_n  = (state == ST_INIT) ? 1'b0 : 1'b1;
+    wire [3:0] mi_dout = {3'b0, init_cmd[3'd7 - init_cnt[2:0]]};
+    wire mi_doe   = (state == ST_INIT);
+
+    always @(posedge clk_i or posedge rst_i) begin
+      if (rst_i) mi_sck <= 1'b0;
+      else if (state == ST_INIT) mi_sck <= ~mi_sck;
+      else mi_sck <= 1'b0;
+    end
+
+    always @(posedge mi_sck or posedge rst_i) begin
+      if (rst_i) init_cnt <= 4'd0;
+      else if (state == ST_INIT) init_cnt <= init_cnt + 4'd1;
+    end
+
     wire [2:0]  size =  (sel_i == 4'b0001) ? 1 :
                         (sel_i == 4'b0010) ? 1 :
                         (sel_i == 4'b0100) ? 1 :
@@ -161,12 +195,13 @@ module EF_PSRAM_CTRL_wb (
         .douten(mw_doe)
     );
 
-    assign sck  = wb_we ? mw_sck  : mr_sck;
-    assign ce_n = wb_we ? mw_ce_n : mr_ce_n;
-    assign dout = wb_we ? mw_dout : mr_dout;
-    assign douten  = wb_we ? {4{mw_doe}}  : {4{mr_doe}};
+    assign sck   = (state == ST_INIT) ? mi_sck  : (wb_we ? mw_sck  : mr_sck);
+    assign ce_n  = (state == ST_INIT) ? mi_ce_n : (wb_we ? mw_ce_n : mr_ce_n);
+    assign dout  = (state == ST_INIT) ? mi_dout : (wb_we ? mw_dout : mr_dout);
+    assign douten = (state == ST_INIT) ? 4'b0001 :
+                    (wb_we ? {4{mw_doe}} : {4{mr_doe}});
 
     assign mw_din = din;
     assign mr_din = din;
-    assign ack_o = wb_we ? mw_done :mr_done ;
+    assign ack_o = (state == ST_INIT) ? 1'b0 : (wb_we ? mw_done : mr_done);
 endmodule
diff --git a/perip/psram/psram.v b/perip/psram/psram.v
index 4e2f260e..f1ea4711 100644
--- a/perip/psram/psram.v
+++ b/perip/psram/psram.v
@@ -22,6 +22,8 @@ module psram(
   // QSPI Command Set
   localparam CMD_QIOR = 8'hEB;  // Quad I/O Read (Requires Dummy)
   localparam CMD_QIOW = 8'h38;  // Quad I/O Write (No Dummy)
+  localparam CMD_ENTER_QPI = 8'h35; // Command to enter QPI mode
+  localparam CMD_EXIT_QPI  = 8'hF5; // Command to exit QPI mode
 
   reg  [ 2:0] state;
   reg  [ 7:0] cmd_reg;
@@ -29,6 +31,7 @@ module psram(
   reg  [ 7:0] byte_buf;
   reg  [ 3:0] cnt;
   reg         io_dir;
+  reg         qpi_mode; // Mode flag: 0 for SPI, 1 for QPI
 
   // Tri-state buffer control
   wire [ 3:0] dio_in = dio;
@@ -48,13 +51,36 @@ module psram(
 
         // Phase 1: Instruction (Standard SPI mode)
         S_IDLE, S_CMD: begin
-          cmd_reg <= {cmd_reg[6:0], dio_in[0]};
-          if (cnt == 7) begin
-            cnt   <= 0;
-            state <= S_ADDR;
+          if (qpi_mode) begin
+            // QPI Mode: Instruction is sent via 4 lines (2 cycles for 8 bits)
+            cmd_reg <= {cmd_reg[3:0], dio_in};
+            if (cnt == 1) begin
+              cnt   <= 0;
+              state <= S_ADDR;  // Default next state
+              // Decode commands that don't have address phases
+              if ({cmd_reg[3:0], dio_in} == CMD_EXIT_QPI) begin
+                qpi_mode <= 1'b0;
+                state    <= S_IDLE;  // Reset to SPI after exit
+              end
+            end else begin
+              cnt   <= cnt + 1;
+              state <= S_CMD;
+            end
           end else begin
-            cnt   <= cnt + 1;
-            state <= S_CMD;
+            // SPI Mode: Instruction is sent via DIO0 only (8 cycles for 8 bits)
+            cmd_reg <= {cmd_reg[6:0], dio_in[0]};
+            if (cnt == 7) begin
+              cnt   <= 0;
+              state <= S_ADDR;
+              // Decode Enter QPI command
+              if ({cmd_reg[6:0], dio_in[0]} == CMD_ENTER_QPI) begin
+                qpi_mode <= 1'b1;
+                state    <= S_IDLE;  // Ready for QPI in next CE# cycle
+              end
+            end else begin
+              cnt   <= cnt + 1;
+              state <= S_CMD;
+            end
           end
         end
 
