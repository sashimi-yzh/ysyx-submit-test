-  io.miso := true.B
+  val cntReg = withClockAndReset ((!io.sck).asClock, io.ss.asBool.asAsyncReset) {
+    RegInit(0.U(4.W))
+  }
+  cntReg := cntReg + 1.U
+  val outValid = cntReg > 7.U
+  val shiftReg = withClock (io.sck.asClock) { Reg(UInt(8.W)) }
+  when (cntReg =/= 8.U) {
+    shiftReg := Mux(outValid, 0.U(1.W) ## shiftReg(7, 1), shiftReg(6, 0) ## io.mosi.asUInt)
+  }
+  io.miso := shiftReg(0).asBool && outValid
 }
