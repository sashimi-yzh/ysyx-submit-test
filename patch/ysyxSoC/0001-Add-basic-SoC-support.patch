index 5bd7f5b4..7df85b4c 100644
--- a/src/device/Keyboard.scala
+++ b/src/device/Keyboard.scala
@@ -26,6 +26,39 @@ class ps2_top_apb extends BlackBox {
 
 class ps2Chisel extends Module {
   val io = IO(new PS2CtrlIO)
+
+  io.in.pslverr := false.B
+  val valid = io.in.psel && !io.in.penable
+  io.in.pready := RegNext(valid)
+  val isPs2NegEdge = RegNext(RegNext(io.ps2.clk)) && !RegNext(io.ps2.clk)
+
+  val dataReg = Reg(UInt(11.W))
+  val cntReg = RegInit(0.U(4.W))
+  val sIdle :: sData :: sDone :: sErr :: Nil = Enum(4)
+  val stateReg = RegInit(sIdle)
+  val nextState = MuxLookup(stateReg, sIdle)(Seq(
+    sIdle -> Mux(isPs2NegEdge && !io.ps2.data, sData, sIdle),
+    sData -> Mux(cntReg === 10.U, Mux(dataReg(0) && dataReg(9, 1).xorR, sDone, sErr), sData),
+    sDone -> sIdle,
+    sErr -> sIdle
+    ))
+  stateReg := nextState
+  when (isPs2NegEdge) {
+    dataReg := dataReg(9, 0) ## io.ps2.data
+    cntReg := Mux(stateReg === sData, cntReg + 1.U, 0.U)
+  }
+
+  val enq = Wire(Decoupled(UInt(8.W)))
+  enq.valid := stateReg === sDone
+  enq.bits := Reverse(dataReg(9, 2))
+  val dataQ = Queue(enq, 16)
+  
+  when (valid) {
+    assert(!io.in.pwrite, "PS2 is read only")
+  }
+
+  dataQ.ready := RegNext(valid)
+  io.in.prdata := Mux(dataQ.valid, dataQ.bits.padTo(io.in.prdata.getWidth), 0.U)
