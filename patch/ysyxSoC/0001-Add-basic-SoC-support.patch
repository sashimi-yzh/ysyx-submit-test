 class gpioChisel extends Module {
   val io = IO(new GPIOCtrlIO)
+
+  val ledsReg = RegInit(0.U.asTypeOf(Vec(2, UInt(8.W))))
+  val leds = ledsReg.asUInt
+  val segsReg = RegInit(0.U.asTypeOf(Vec(4, UInt(8.W))))
+  val segs = segsReg.asTypeOf(Vec(8, UInt(4.W)))
+
+  io.in.pready := true.B
+  io.in.pslverr := false.B
+  io.in.prdata := io.gpio.in.padTo(32)
+
+  io.gpio.out := leds
+  io.gpio.seg.zipWithIndex.foreach { case (seg, idx) =>
+    val segDecoder = Module(new SegDecoder)
+    segDecoder.io.in := segs(idx)
+    val result = segDecoder.io.out ## 0.U(1.W)
+    seg := ~result
+  }
+
+  val addr = io.in.paddr(3, 0)
+  val wdata = io.in.pwdata.asTypeOf(Vec(4, UInt(8.W)))
+
+  def maskWrite[T <: Data](numByte: Int, a: Vec[T], b: Vec[T]) = {
+    for (i <- 0 until numByte) {
+      when (io.in.pstrb(i)) {
+        a(i) := b(i)
+      }
+    }
+  }
+
+  when (io.in.psel && !io.in.penable && io.in.pwrite) {
+    when (addr === 0.U) {
+      maskWrite(2, ledsReg, wdata)
+    } 
+    when (addr === 8.U) {
+      maskWrite(4, segsReg, wdata)
+    }
+  }
 }
 
