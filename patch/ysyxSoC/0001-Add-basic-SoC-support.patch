+class vgaChisel(
+  width: Int = 640, 
+  height: Int = 480,
+
+  hFrontporch: Int = 96,
+  hActive: Int = 144,
+  hBackporch: Int = 784,
+  hTotal: Int = 800,
+
+  vFrontporch: Int = 2,
+  vActive: Int = 35,
+  vBackporch: Int = 515,
+  vTotal: Int = 525
+) extends Module {
   val io = IO(new VGACtrlIO)
+  
+  val wvalid = io.in.psel && !io.in.penable
+  io.in.pready := RegNext(wvalid)
+  io.in.pslverr := false.B
+  io.in.prdata := DontCare
+
+  val buf = SyncReadMem(width * height, Vec(4, UInt(8.W)))
+  val waddr = io.in.paddr(log2Ceil(buf.length) + 1, 2)
+  when (wvalid) {
+    assert(io.in.pwrite, "VGA buffer is write only")
+    buf.write(waddr, io.in.pwdata.asTypeOf(Vec(4, UInt(8.W))), io.in.pstrb.asBools)
+  }
+
+  val (hCntVal, hCntWarp) = Counter(1 to hTotal)
+  val (vCntVal, vCntWarp) = Counter(1 to vTotal, hCntWarp)
+
+  io.vga.hsync := hCntVal > hFrontporch.U
+  io.vga.vsync := vCntVal > vFrontporch.U
+
+  val hReadValid = (hCntVal >= hActive.U) && (hCntVal < hBackporch.U)
+  val vReadValid = (vCntVal >= vActive.U) && (vCntVal < vBackporch.U)
+  val readValid = hReadValid && vReadValid
+
+  io.vga.valid := ShiftRegister(readValid, 1, true.B)
+
+  val hAddr = hCntVal - hActive.U
+  val vAddr = vCntVal - vActive.U
+  val rAddr = hAddr + width.U * vAddr
+  val bufRgb = buf.read(rAddr, readValid)
+  val rgb = Mux(io.vga.valid, bufRgb, 0.U.asTypeOf(chiselTypeOf(bufRgb)))
+  io.vga.r := rgb(2)
+  io.vga.g := rgb(1)
+  io.vga.b := rgb(0)
 }
 
