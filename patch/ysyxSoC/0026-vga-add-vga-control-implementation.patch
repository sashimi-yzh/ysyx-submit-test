From 5e5e015e362ab18ce3f11d3ab1c67711b30bf992 Mon Sep 17 00:00:00 2001
From: "Wang, Yuan" <hallo_sun@hotmail.com>
Date: Sat, 14 Mar 2026 10:42:19 +0800
Subject: [PATCH 26/40] [vga] add vga control implementation

Signed-off-by: Wang, Yuan <hallo_sun@hotmail.com>
---
 perip/vga/vga_top_apb.v | 118 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 118 insertions(+)

diff --git a/perip/vga/vga_top_apb.v b/perip/vga/vga_top_apb.v
index 5c74cfbe..29cec4fb 100644
--- a/perip/vga/vga_top_apb.v
+++ b/perip/vga/vga_top_apb.v
@@ -20,4 +20,122 @@ module vga_top_apb(
   output        vga_valid
 );
 
+  localparam VGA_BASE_ADDR = 32'h21000000;
+  localparam VGA_SIZE = 32'h1fffff;
+  localparam VGA_HEIGHT = VGA_BASE_ADDR;
+  localparam VGA_WIDTH = VGA_BASE_ADDR + 32'h4;
+  localparam SYNC = VGA_BASE_ADDR + 32'h8;
+  localparam FB = VGA_BASE_ADDR + 32'h10;
+
+  wire addr_match = (in_paddr >= VGA_BASE_ADDR) && (in_paddr < (VGA_BASE_ADDR + VGA_SIZE));
+  wire transfer = in_psel && in_penable;
+  wire [31:0] masked_wdata;
+
+  assign masked_wdata[7:0]   = in_pstrb[0] ? in_pwdata[7:0] : 8'h00;
+  assign masked_wdata[15:8]  = in_pstrb[1] ? in_pwdata[15:8] : 8'h00;
+  assign masked_wdata[23:16] = in_pstrb[2] ? in_pwdata[23:16] : 8'h00;
+  assign masked_wdata[31:24] = in_pstrb[3] ? in_pwdata[31:24] : 8'h00;
+
+  reg [31:0] prdata_reg;
+  reg        pready_reg;
+  reg        pslverr_reg;
+
+  localparam WIDTH = 640;
+  localparam HEIGHT = 480;
+  wire [31:0] canvas_wr_addr = in_paddr - FB;
+  reg [31:0] canvas[WIDTH * HEIGHT - 1:0];
+  reg rendering;
+
+  // output
+  assign in_prdata  = prdata_reg;
+  assign in_pready  = pready_reg;
+  assign in_pslverr = pslverr_reg;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      prdata_reg  <= 32'h0;
+      pready_reg  <= 1'b1;
+      pslverr_reg <= 1'b0;
+    end else begin
+      pready_reg  <= 1'b1;
+      pslverr_reg <= 1'b0;
+
+      if (transfer) begin
+        if (in_pwrite) begin
+          case (in_paddr)
+            FB: begin
+              if ((canvas_wr_addr < WIDTH * HEIGHT) && (canvas_wr_addr > 32'h0)) begin
+                canvas[canvas_wr_addr] <= masked_wdata;
+              end
+            end
+            SYNC: begin
+              if (in_pwdata[7:0] == 8'b00000001) begin
+                rendering <= 1'b1;
+              end
+            end
+            default: begin
+              pslverr_reg <= 1'b1;
+            end
+          endcase
+        end else begin
+          case (in_paddr)
+            VGA_HEIGHT: prdata_reg <= HEIGHT;
+            VGA_WIDTH:  prdata_reg <= WIDTH;
+            default: begin
+              prdata_reg  <= 32'h0;
+              pslverr_reg <= 1'b1;
+            end
+          endcase
+        end
+      end
+    end
+  end
+
+  // vga output logic
+  parameter h_frontporch = 96;
+  parameter h_active = 144;
+  parameter h_backporch = 784;
+  parameter h_total = 800;
+
+  parameter v_frontporch = 2;
+  parameter v_active = 35;
+  parameter v_backporch = 515;
+  parameter v_total = 525;
+
+  reg  [9:0] x_cnt;
+  reg  [9:0] y_cnt;
+  wire       h_valid;
+  wire       v_valid;
+
+
+  always @(posedge reset or posedge clock)
+    if (reset == 1'b1) x_cnt <= 1;
+    else if (rendering) begin
+      if (x_cnt == h_total) x_cnt <= 1;
+      else x_cnt <= x_cnt + 10'd1;
+    end
+
+  always @(posedge clock)
+    if (reset == 1'b1) y_cnt <= 1;
+    else if (rendering) begin
+      if (y_cnt == v_total & x_cnt == h_total) begin
+        y_cnt     <= 1;
+        rendering <= 0;
+      end else if (x_cnt == h_total) y_cnt <= y_cnt + 10'd1;
+    end
+
+  assign vga_hsync = (x_cnt > h_frontporch);
+  assign vga_vsync = (y_cnt > v_frontporch);
+
+  assign h_valid   = (x_cnt > h_active) & (x_cnt <= h_backporch);
+  assign v_valid   = (y_cnt > v_active) & (y_cnt <= v_backporch);
+  assign vga_valid = h_valid & v_valid;
+
+  // assign h_addr    = h_valid ? (x_cnt - 10'd145) : {10{1'b0}};
+  // assign v_addr    = v_valid ? (y_cnt - 10'd36) : {10{1'b0}};
+
+  assign vga_r     = masked_wdata[23:16];
+  assign vga_g     = masked_wdata[15:8];
+  assign vga_b     = masked_wdata[7:0];
+
 endmodule
