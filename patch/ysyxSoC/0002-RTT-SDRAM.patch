diff --git a/perip/gpio/gpio_top_apb.v b/perip/gpio/gpio_top_apb.v
index ec51ffe5..07272d20 100644
--- a/perip/gpio/gpio_top_apb.v
+++ b/perip/gpio/gpio_top_apb.v
@@ -23,5 +23,107 @@ module gpio_top_apb(
   output [7:0]  gpio_seg_6,
   output [7:0]  gpio_seg_7
 );
+  localparam GPIO_LED_BASE = 32'h10002000;
+  localparam GPIO_SWITCH_BASE = 32'h10002004;
+  localparam GPIO_SEG_BASE = 32'h10002008;
 
+  wire [31:0] align_addr = in_paddr & 32'hfffffffc;
+
+  reg [31:0] led;
+  reg [31:0] seg_raw;
+  always @(posedge clock) begin
+    if(reset) begin
+      led = 0;
+      seg_raw = 0;
+    end
+    else if(in_pwrite) begin
+      if(align_addr == GPIO_LED_BASE) begin
+        case (in_pstrb)
+          4'b0001 : led[ 7: 0] <= in_pwdata[ 7: 0];
+          4'b0010 : led[15: 8] <= in_pwdata[15: 8];
+          4'b0100 : led[23:16] <= in_pwdata[23:16];
+          4'b1000 : led[31:24] <= in_pwdata[31:24];
+          4'b0011 : led[15: 0] <= in_pwdata[15: 0];
+          4'b1100 : led[31:16] <= in_pwdata[31:16];
+          4'b1111 : led        <= in_pwdata;
+          default: assert(0);
+        endcase
+      end
+
+      if(align_addr == GPIO_SEG_BASE) begin
+        case (in_pstrb)
+          4'b0001 : seg_raw[ 7: 0] <= in_pwdata[ 7: 0];
+          4'b0010 : seg_raw[15: 8] <= in_pwdata[15: 8];
+          4'b0100 : seg_raw[23:16] <= in_pwdata[23:16];
+          4'b1000 : seg_raw[31:24] <= in_pwdata[31:24];
+          4'b0011 : seg_raw[15: 0] <= in_pwdata[15: 0];
+          4'b1100 : seg_raw[31:16] <= in_pwdata[31:16];
+          4'b1111 : seg_raw        <= in_pwdata;
+          default: assert(0);
+        endcase
+      end
+    end
+  end
+  assign in_pslverr = 0;
+  
+  reg [31:0] prdata;
+  assign in_prdata = prdata;
+  always @(*) begin
+    prdata = 0;
+    if(align_addr == GPIO_LED_BASE) prdata = {16'd0, led[15:0]};
+    if(align_addr == GPIO_SWITCH_BASE) prdata = {16'd0, gpio_in};
+    if(align_addr == GPIO_LED_BASE) prdata = seg_raw;
+  end
+
+  assign gpio_out = led[15:0];
+  assign gpio_seg_0[0] = 1;
+  assign gpio_seg_1[0] = 1;
+  assign gpio_seg_2[0] = 1;
+  assign gpio_seg_3[0] = 1;
+  assign gpio_seg_4[0] = 1;
+  assign gpio_seg_5[0] = 1;
+  assign gpio_seg_6[0] = 1;
+  assign gpio_seg_7[0] = 1;
+  x7seg SEG0(seg_raw[ 3: 0], gpio_seg_0[7:1]);
+  x7seg SEG1(seg_raw[ 7: 4], gpio_seg_1[7:1]);
+  x7seg SEG2(seg_raw[11: 8], gpio_seg_2[7:1]);
+  x7seg SEG3(seg_raw[15:12], gpio_seg_3[7:1]);
+  x7seg SEG4(seg_raw[19:16], gpio_seg_4[7:1]);
+  x7seg SEG5(seg_raw[23:20], gpio_seg_5[7:1]);
+  x7seg SEG6(seg_raw[27:24], gpio_seg_6[7:1]);
+  x7seg SEG7(seg_raw[31:28], gpio_seg_7[7:1]);
+
+  reg ready;
+  always @(posedge clock) begin
+    if(reset) ready <= 0;
+    else if(in_penable) ready <= 1;
+  end
+  assign in_pready = ready;
+endmodule
+
+module x7seg (
+  input [3:0] b,
+  output reg [6:0] h
+);
+  always @(*) begin
+    case (b)
+      4'd0: h = 7'b0000001;
+      4'd1: h = 7'b1001111;
+      4'd2: h = 7'b0010010;
+      4'd3: h = 7'b0000110;
+      4'd4: h = 7'b1001100;
+      4'd5: h = 7'b0100100;
+      4'd6: h = 7'b0100000;
+      4'd7: h = 7'b0001111;
+      4'd8: h = 7'b0000000;
+      4'd9: h = 7'b0000100;
+      4'd10: h = 7'b0001000; // A
+      4'd11: h = 7'b1100000; // B
+      4'd12: h = 7'b0110001; // C
+      4'd13: h = 7'b1000010; // D
+      4'd14: h = 7'b0110000; // E
+      4'd15: h = 7'b0111000; // F
+      default: h = 7'h7f;
+    endcase
+  end
 endmodule
diff --git a/perip/ps2/ps2_top_apb.v b/perip/ps2/ps2_top_apb.v
index 080d38fa..3a05d0c0 100644
--- a/perip/ps2/ps2_top_apb.v
+++ b/perip/ps2/ps2_top_apb.v
@@ -15,5 +15,85 @@ module ps2_top_apb(
   input         ps2_clk,
   input         ps2_data
 );
+// 读通码和断码，其中读断码时，略过F0H，即读两个码，跳过F0H
+wire [7:0] scan_data;
+wire ready, overflow;
+reg ack;
+ps2_keyboard ps2_keyboard0(
+  clock,~reset,ps2_clk,ps2_data,scan_data,ready,~ack,overflow
+);
+reg [7:0] scan_data_buf;
+always @(posedge clock) begin
+  if (reset) scan_data_buf <= 8'h00;
+  else if(ready) scan_data_buf <= scan_data;
+  else scan_data_buf <= 8'h00;
+end
+
+always @(posedge clock) begin
+  if(reset) ack <= 0;
+  else if(in_penable & ~ack) ack <= 1;
+  else ack <= 0;
+end
+
+// 读通码时，输出扫描码；读断码时，输出0x00
+// in_prdata低8位存储扫描码或0xff，高23位为0，第24位为1表示当前为按下状态，0表示当前为松开状态
+assign in_prdata[31:8] = 0;
+assign in_prdata[7:0] = scan_data_buf;
+assign in_pready = ack;
+endmodule
+
+module ps2_keyboard(clk,clrn,ps2_clk,ps2_data,data,
+                    ready,nextdata_n,overflow);
+    input clk,clrn,ps2_clk,ps2_data;
+    input nextdata_n;
+    output [7:0] data;
+    output reg ready;
+    output reg overflow;     // fifo overflow
+    // internal signal, for test
+    reg [9:0] buffer;        // ps2_data bits
+    reg [7:0] fifo[15:0];     // data fifo
+    reg [3:0] w_ptr,r_ptr;   // fifo write and read pointers
+    reg [3:0] count;  // count ps2_data bits
+    // detect falling edge of ps2_clk
+    reg [2:0] ps2_clk_sync;
+
+    always @(posedge clk) begin
+        ps2_clk_sync <=  {ps2_clk_sync[1:0],ps2_clk};
+    end
+
+    wire sampling = ps2_clk_sync[2] & ~ps2_clk_sync[1];
+
+    always @(posedge clk) begin
+        if (clrn == 0) begin // reset
+            count <= 0; w_ptr <= 0; r_ptr <= 0; overflow <= 0; ready<= 0;
+        end
+        else begin
+            if ( ready ) begin // read to output next data
+                if(nextdata_n == 1'b0) //read next data
+                begin
+                    r_ptr <= r_ptr + 4'b1;
+                    if(w_ptr==(r_ptr+1'b1)) //empty
+                        ready <= 1'b0;
+                end
+            end
+            if (sampling) begin
+              if (count == 4'd10) begin
+                if ((buffer[0] == 0) &&  // start bit
+                    (ps2_data)       &&  // stop bit
+                    (^buffer[9:1])) begin      // odd  parity
+                    fifo[w_ptr] <= buffer[8:1];  // kbd scan code
+                    w_ptr <= w_ptr+4'b1;
+                    ready <= 1'b1;
+                    overflow <= overflow | (r_ptr == (w_ptr + 4'b1));
+                end
+                count <= 0;     // for next
+              end else begin
+                buffer[count] <= ps2_data;  // store ps2_data
+                count <= count + 4'b1;
+              end
+            end
+        end
+    end
+    assign data = fifo[r_ptr]; //always set output data
 
 endmodule
