+    else if(state == IDLE)
+        sck <= 1'b0;
+  
+  always @ (posedge clk or negedge rst_n)
+    if(!rst_n)
+        ce_n <= 1'b1;
+    else if(state == QPI_MODE)
+        ce_n <= 1'b0;
+    else
+        ce_n <= 1'b1;
+  
