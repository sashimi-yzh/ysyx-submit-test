+  assign douten   =   (~ce_n);
+  assign done     =   (counter == 8);
+endmodule
diff --git a/perip/psram/psram.v b/perip/psram/psram.v
index d9bdd882..b5ac3e98 100644
--- a/perip/psram/psram.v
+++ b/perip/psram/psram.v
@@ -3,7 +3,122 @@ module psram(
   input ce_n,
   inout [3:0] dio
 );
+  localparam cmd_t = 3'd0, addr_t = 3'd1, r_delay = 3'd2, data_out_t = 3'd3, data_in_t = 3'd4, err_t = 3'd5;
+  wire reset = ce_n;
+  // assign dio = 4'bz;
+  reg [2:0] state;
+  reg [7:0] counter;
+  reg [7:0] cmd;
+  reg [23:0] addr;
+  reg [31:0] raddr;
+  reg [31:0] waddr;
+  reg [31:0] data;
+  reg [31:0] rdata; // 通过 dpi-c 函数读
+  reg [2:0] wlen;
+  wire rvalid;
+  reg qpi_flag = 1'b0;
 
-  assign dio = 4'bz;
+  assign raddr = {8'b0, addr[19:0], dio};
+  assign waddr = {8'b0, addr};
+  always @(posedge sck) begin
+    if(reset) state <= cmd_t;
+    else begin
+      case (state)
+        cmd_t : state <= qpi_flag ? ((counter == 8'd1) ? addr_t : state) : ((counter == 8'd7 ) ? addr_t : state);
+        addr_t: state <= ((cmd != 8'heb) && (cmd != 8'h38)) ? err_t : ((counter == 8'd5) ? ((cmd == 8'heb) ? r_delay : data_in_t) : state);
+        r_delay: state <= (counter == 8'd5) ? data_out_t : state;
+        data_out_t: state <= state;
+        data_in_t: state <= state;
+        default: begin
+          $fwrite(32'h80000002, "Assertion failed: Unsupported command `%xh`\n", cmd);
+          $fatal;
+        end
+      endcase
+    end
+  end
 
+  always @(posedge sck) begin
+    // 进入QPI模式
+    if(state == cmd_t && (counter == 8'd7) && {cmd[6:0], dio[0]} == 8'h35) qpi_flag <= 1'b1;
+  end
+
+  always@(posedge sck) begin
+    if (reset) counter <= 8'd0;
+    else begin
+      case (state)
+        cmd_t:   counter <= qpi_flag ? ((counter < 8'd1) ? counter + 8'd1 : 8'd0) : ((counter < 8'd7 ) ? counter + 8'd1 : 8'd0);
+        addr_t:  counter <= (counter < 8'd5) ? counter + 8'd1 : 8'd0;
+        r_delay: counter <= (counter < 8'd5) ? counter + 8'd1 : 8'd0;
+        data_in_t: counter <= (counter < 8'd1) ? counter + 8'd1 : 8'd0;
+        default: counter <= counter + 8'd1;
+      endcase
+    end
+  end
+
+  always@(posedge sck) begin
+    if (reset)               cmd <= 8'd0;
+    else if (state == cmd_t) begin 
+      if(qpi_flag) cmd <= { cmd[3:0], dio};
+      else cmd <= { cmd[6:0], dio[0] };
+    end
+  end
+
+  always@(posedge sck) begin
+    if (reset) addr <= 24'd0;
+    else if (state == addr_t) addr <= { addr[19:0], dio };
+  end
+
+  always@(posedge sck) begin
+    if (reset) data <= 32'd0;
+    else if (state == data_out_t) begin
+      if(counter == 8'd0) data <= rdata;
+      else data <= {data[27:0], 4'd0};
+    end
+    else if (state == data_in_t) begin
+      data <= { data[27:0], dio };
+    end
+  end
+  // [3Bh]: SPI Fast Quad IO Read
+  always @(posedge sck) begin
+    if(reset)
+      wlen <= 0;
+    else if(state == data_in_t && counter == 8'd1)
+      wlen <= wlen + 1;
+  end
+
+  // [EBh]: SPI Fast Quad IO Read
+  assign rvalid = (cmd == 8'heb) && (state == addr_t) && (counter == 8'd5);
+  assign dio = ce_n ? 4'bzzzz : ((state == r_delay) ? 4'bzzzz: data[31:28]);
+  dram_cmd dram_cmd_i(
+    .clock(sck),
+    .ce_n(ce_n),
+    .rvalid(rvalid),
+    .raddr(raddr),
+    .waddr(waddr),
+    .rdata(rdata),
+    .wdata(data),
+    .wlen(wlen)
+  );
+endmodule
+
+import "DPI-C" function void dram_read(input int addr, output int data);
+import "DPI-C" function void dram_write(input int addr, input int data, input int len);
+
+module dram_cmd (
+  input             clock,
+  input             ce_n,
+  input             rvalid,
+  input [2:0]       wlen,
+  input [31:0]      raddr,
+  input [31:0]      waddr,
+  output reg [31:0] rdata,
+  input [31:0]      wdata
+);
+  always@(posedge clock) begin
+    if (rvalid) dram_read(raddr, rdata);
+  end
+
+  always @(posedge ce_n) begin
+    if (wlen != 0) dram_write(waddr, wdata, {29'd0, wlen}); 
+  end
 endmodule
