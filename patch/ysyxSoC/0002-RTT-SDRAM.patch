diff --git a/perip/amba/apb_delayer.v b/perip/amba/apb_delayer.v
index c0d20764..a04bb95c 100644
--- a/perip/amba/apb_delayer.v
+++ b/perip/amba/apb_delayer.v
@@ -1,3 +1,4 @@
+`define delay
 module apb_delayer(
   input         clock,
   input         reset,
@@ -24,15 +25,131 @@ module apb_delayer(
   input         out_pslverr
 );
 
-  assign out_paddr   = in_paddr;
-  assign out_psel    = in_psel;
-  assign out_penable = in_penable;
-  assign out_pprot   = in_pprot;
-  assign out_pwrite  = in_pwrite;
-  assign out_pwdata  = in_pwdata;
-  assign out_pstrb   = in_pstrb;
-  assign in_pready   = out_pready;
-  assign in_prdata   = out_prdata;
-  assign in_pslverr  = out_pslverr;
-
-endmodule
+`ifdef delay
+  localparam s = 8;
+  localparam log2s = 3;
+  localparam r_mul_s = 75;
+
+  reg         in_pready_wait;
+  reg [31:0]  in_prdata_wait;
+  reg         in_pslverr_wait;
+  reg [31:0]  out_paddr_o;
+  reg         out_psel_o;
+  reg         out_penable_o;
+  reg [2:0]   out_pprot_o;
+  reg         out_pwrite_o;
+  reg [31:0]  out_pwdata_o;
+  reg [3:0]   out_pstrb_o;
+
+  reg        in_pready_o;
+  reg [31:0] in_prdata_o;
+  reg        in_pslverr_o;
+
+  reg [31:0] counter;
+  reg [31:0] k_counter;
+  reg [1:0] state;
+
+  assign out_paddr   = out_paddr_o;
+  assign out_psel    = out_psel_o;
+  assign out_penable = out_penable_o;
+  assign out_pprot   = out_pprot_o;
+  assign out_pwrite  = out_pwrite_o;
+  assign out_pwdata  = out_pwdata_o;
+  assign out_pstrb   = out_pstrb_o;
+
+  assign in_pready   = in_pready_o;
+  assign in_prdata   = in_prdata_o;
+  assign in_pslverr  = in_pslverr_o;
+
+  always @(*) begin
+    if(state == 2'd0 || state == 2'd1) begin
+      out_paddr_o   = in_paddr;
+      out_psel_o    = in_psel;
+      out_penable_o = in_penable;
+      out_pprot_o   = in_pprot;
+      out_pwrite_o  = in_pwrite;
+      out_pwdata_o  = in_pwdata;
+      out_pstrb_o   = in_pstrb;
+    end
+    else begin
+      out_paddr_o   = 0;
+      out_psel_o    = 0;
+      out_penable_o = 0;
+      out_pprot_o   = 0;
+      out_pwrite_o  = 0;
+      out_pwdata_o  = 0;
+      out_pstrb_o   = 0;
+    end
+  end
+
+  always @(posedge clock) begin
+    if(reset) state <= 0;
+    else begin
+      case (state)
+        2'd0: state <= in_penable ? 2'd1 : 2'd0;
+        2'd1: state <= out_pready ? 2'd2 : 2'd1;
+        2'd2: state <= (counter == 0) ? 2'd0 : 2'd2;
+        default: state <= 2'd0;
+      endcase
+    end
+  end
+
+  always @(posedge clock) begin
+    if(reset) begin
+      k_counter <= 0;
+      counter <= 0;
+    end
+    else begin
+      if(state == 2'd0) counter <= 0;
+      else if(state == 2'd1) begin
+        if(out_pready) begin
+          counter <= ((counter + r_mul_s - k_counter) >> log2s);
+          k_counter <= 0;
+        end
+        else begin
+          k_counter <= k_counter + s;
+          counter <= counter + r_mul_s;
+        end
+      end
+      else if(state == 2'd2) counter <= counter - 1;
+    end
+  end
+
+  always @(posedge clock) begin
+    if(reset) begin
+      in_pready_wait <= 0;
+      in_prdata_wait <= 0;
+      in_pslverr_wait <= 0;
+    end
+    else if(state == 2'd1 && out_pready) begin
+      in_pready_wait <= out_pready;
+      in_prdata_wait <= out_prdata;
+      in_pslverr_wait <= out_pslverr;
+    end
+  end
+
+  always @(*) begin
+    if(state == 2'd2 && counter == 0) begin
+      in_pready_o = in_pready_wait;
+      in_prdata_o = in_prdata_wait;
+      in_pslverr_o = in_pslverr_wait;
+    end
+    else begin
+      in_pready_o = 0;
+      in_prdata_o = 0;
+      in_pslverr_o = 0;
+    end
+  end
+`else
+    assign out_paddr   = in_paddr;
+    assign out_psel    = in_psel;
+    assign out_penable = in_penable;
+    assign out_pprot   = in_pprot;
+    assign out_pwrite  = in_pwrite;
+    assign out_pwdata  = in_pwdata;
+    assign out_pstrb   = in_pstrb;
+    assign in_pready   = out_pready;
+    assign in_prdata   = out_prdata;
+    assign in_pslverr  = out_pslverr;
+`endif
+endmodule
\ No newline at end of file
diff --git a/perip/amba/axi4_delayer.v b/perip/amba/axi4_delayer.v
index f692803b..f5e62cb9 100644
--- a/perip/amba/axi4_delayer.v
+++ b/perip/amba/axi4_delayer.v
@@ -1,3 +1,4 @@
+`define delay
 module axi4_delayer(
   input         clock,
   input         reset,
@@ -62,7 +63,221 @@ module axi4_delayer(
   input  [3:0]  out_bid,
   input  [1:0]  out_bresp
 );
+`ifdef delay
+  localparam s = 8;
+  localparam log2s = 3;
+  localparam r_mul_s = 75;
+  localparam MAX_BURST_LEN = 8;
 
+  localparam IDLE = 4'd0;
+  localparam READ = 4'd1;
+  localparam READ_WAIT = 4'd2;
+  localparam WRITE = 4'd3;
+  localparam WRITE_WAIT = 4'd4;
+
+  reg [3:0]  state;
+  // read transaction
+  reg [31:0] r_counter;
+  reg [31:0] rk_counter;
+  reg [2:0] r_counter_ptr;
+  reg [31:0] w_counter;
+  reg [31:0] wk_counter;
+
+  reg        in_rvalid_o;
+  reg [3:0]  in_rid_o;
+  reg [31:0] in_rdata_o;
+  reg [1:0]  in_rresp_o;
+  reg        in_rlast_o;
+
+  reg        in_bvalid_o;
+  reg [3:0]  in_bid_o;
+  reg [1:0]  in_bresp_o;
+
+  reg        in_bvalid_wait;
+  reg [3:0]  in_bid_wait;
+  reg [1:0]  in_bresp_wait;
+  
+  // FIFO
+  reg [2:0] fifo_rptr;
+  reg [2:0] fifo_wptr;
+  reg [31:0] ram [7:0];
+
+  always @(posedge clock) begin
+    if(reset) state <= IDLE;
+    else begin
+      case (state)
+        IDLE : state <= in_arvalid ? READ : (in_awvalid || in_wvalid) ? WRITE : IDLE;
+        READ : state <= out_rlast && out_rvalid && in_rready ? READ_WAIT : READ;
+        READ_WAIT : state <= (fifo_rptr == fifo_wptr) ? IDLE : READ_WAIT;
+        WRITE : state <= out_bvalid ? WRITE_WAIT : WRITE;
+        WRITE_WAIT : state <= (w_counter == 0) ? IDLE : WRITE_WAIT;
+        default: ; 
+      endcase
+    end
+  end
+
+  always @(posedge clock) begin
+    if(reset) begin
+      r_counter <= 0;
+      rk_counter <= 0;
+    end
+    else begin
+      if(state == IDLE) begin
+        rk_counter <= 0;
+        r_counter <= 0;
+      end
+      else if (state == READ) begin
+        r_counter <= r_counter + r_mul_s;
+        rk_counter <= rk_counter + s;
+      end
+    end
+  end
+
+  reg [31:0] burst_counter[MAX_BURST_LEN - 1 : 0];
+  reg        burst_valid[MAX_BURST_LEN - 1 : 0];
+  reg [2 :0] burst_ptr;
+  integer i1;
+  always @(posedge clock) begin
+    if(reset || (state == IDLE)) begin
+      for(i1 = 0; i1 < MAX_BURST_LEN; i1 = i1 + 1) begin
+        burst_counter[i1] <= 0;
+        burst_valid[i1] <= 0;
+      end
+      burst_ptr <= 0;
+    end
+    else begin
+      if(out_rvalid && in_rready) begin
+        burst_counter[burst_ptr] <= ((r_counter + r_mul_s - rk_counter) >> log2s);
+        burst_valid[burst_ptr] <= 1'b1;
+        burst_ptr <= burst_ptr + 3'd1;
+      end
+      else if(burst_valid[fifo_rptr] && (burst_counter[fifo_rptr] == 0)) begin
+        burst_valid[fifo_rptr] <= 1'd0;
+      end
+      for(i1 = 0; i1 < MAX_BURST_LEN; i1 = i1 + 1) begin
+        if(burst_valid[i1] && (burst_counter[i1] != 0)) burst_counter[i1] <= burst_counter[i1] - 32'd1;
+      end
+    end
+  end
+
+  always @(posedge clock) begin
+    if(reset || state == IDLE) begin
+      fifo_rptr <= 0;
+      fifo_wptr <= 0;
+    end
+    else begin
+      if(state == READ || state == READ_WAIT) begin
+        if(out_rvalid && in_rready) begin
+          fifo_wptr <= fifo_wptr + 3'd1;
+          ram[fifo_wptr] <= out_rdata;
+        end
+        else if(burst_valid[fifo_rptr] && (burst_counter[fifo_rptr] == 0)) begin
+          fifo_rptr <= fifo_rptr + 3'd1;
+        end
+      end
+    end
+  end
+
+  always @(posedge clock) begin
+    if(reset || (state == IDLE)) begin
+      w_counter <= 0;
+      wk_counter <= 0;
+    end
+    else if(state == WRITE) begin
+      if(out_bvalid) begin
+        w_counter <= ((w_counter + r_mul_s - wk_counter) >> log2s);
+      end
+      else begin
+        w_counter <= w_counter + r_mul_s;
+        wk_counter <= wk_counter + s;
+      end
+    end
+    else if(state == WRITE_WAIT) begin
+      w_counter <= w_counter - 32'd1;
+    end
+  end
+
+  always @(*) begin
+    if(burst_valid[fifo_rptr] && (burst_counter[fifo_rptr] == 0)) begin
+      in_rvalid_o = 1'd1;
+      in_rid_o = 0;
+      in_rdata_o = ram[fifo_rptr];
+      in_rresp_o = 0;
+      in_rlast_o = ((fifo_rptr + 3'd1) == fifo_wptr);
+    end
+    else begin
+      in_rvalid_o = 0;
+      in_rid_o = 0;
+      in_rdata_o = 0;
+      in_rresp_o = 0;
+      in_rlast_o = 0;
+    end
+  end
+
+  always @(posedge clock) begin
+    if(reset) begin
+      in_bvalid_wait <= 0;
+      in_bid_wait <= 0;
+      in_bresp_wait <= 0;
+    end
+    else if(out_bvalid)begin
+      in_bvalid_wait <= 1'd1;
+      in_bid_wait <= 0;
+      in_bresp_wait <= 0;
+    end
+    else if(w_counter == 0)begin
+      in_bvalid_wait <= 0;
+      in_bid_wait <= 0;
+      in_bresp_wait <= 0;
+    end
+  end
+
+  always @(*) begin
+    if(w_counter == 0) begin
+      in_bvalid_o = in_bvalid_wait;
+      in_bid_o = in_bid_wait;
+      in_bresp_o = in_bresp_wait;
+    end
+    else begin
+      in_bvalid_o = 0;
+      in_bid_o    = 0;
+      in_bresp_o  = 0;
+    end
+  end
+  
+  assign in_arready   = out_arready;
+  assign out_arvalid  = in_arvalid;
+  assign out_arid     = in_arid;
+  assign out_araddr   = in_araddr;
+  assign out_arlen    = in_arlen;
+  assign out_arsize   = in_arsize;
+  assign out_arburst  = in_arburst;
+  assign out_rready   = in_rready;
+
+  assign in_rvalid    = in_rvalid_o;
+  assign in_rid       = in_rid_o;
+  assign in_rdata     = in_rdata_o;
+  assign in_rresp     = in_rresp_o;
+  assign in_rlast     = in_rlast_o;
+
+  assign in_awready = out_awready;
+  assign out_awvalid = in_awvalid;
+  assign out_awid = in_awid;
+  assign out_awaddr = in_awaddr;
+  assign out_awlen = in_awlen;
+  assign out_awsize = in_awsize;
+  assign out_awburst = in_awburst;
+  assign in_wready = out_wready;
+  assign out_wvalid = in_wvalid;
+  assign out_wdata = in_wdata;
+  assign out_wstrb = in_wstrb;
+  assign out_wlast = in_wlast;
+  assign out_bready = in_bready;
+
+  assign in_bvalid = in_bvalid_o;
+  assign in_bid    = in_bid_o;
+  assign in_bresp  = in_bresp_o;
+`else
   assign in_arready = out_arready;
   assign out_arvalid = in_arvalid;
   assign out_arid = in_arid;
@@ -92,5 +307,5 @@ module axi4_delayer(
   assign in_bvalid = out_bvalid;
   assign in_bid = out_bid;
   assign in_bresp = out_bresp;
-
-endmodule
+`endif
+endmodule
\ No newline at end of file
diff --git a/perip/bitrev/bitrev.v b/perip/bitrev/bitrev.v
index f1c3b363..4292dafe 100644
--- a/perip/bitrev/bitrev.v
+++ b/perip/bitrev/bitrev.v
@@ -4,5 +4,41 @@ module bitrev (
   input  mosi,
   output miso
 );
-  assign miso = 1'b1;
+  wire reset = ss;
+  reg state;
+  reg [7:0] counter;
+  localparam DATA_IN = 1'b0, DATA_OUT = 1'b1;
+  always @(posedge sck or posedge reset) begin
+    if(reset) state <= DATA_IN;
+    else begin
+      case (state)
+        DATA_IN : state <= (counter == 8'd7) ? DATA_OUT : DATA_IN;
+        DATA_OUT : state <= DATA_OUT;
+      default: state <= DATA_IN;
+      endcase
+    end
+  end
+
+  always@(posedge sck or posedge reset) begin
+    if (reset) counter <= 8'd0;
+    else begin
+      case (state)
+        DATA_IN :   counter <= (counter < 8'd7 ) ? counter + 8'd1 : 8'd0;
+        default: counter <= counter + 8'd1;
+      endcase
+    end
+  end
+  
+  // 串并转换
+  reg [7:0] bswap_reg;
+  always @(posedge sck or posedge reset) begin
+    if(reset) bswap_reg <= 8'b11111111;
+    else if (state == DATA_IN) begin
+      bswap_reg <= {bswap_reg[6:0], mosi};
+    end
+    else begin
+      bswap_reg <= {bswap_reg[6:0], 1'b1};
+    end
+  end
+  assign miso = ss ? 1'b1 : bswap_reg[7];
 endmodule
