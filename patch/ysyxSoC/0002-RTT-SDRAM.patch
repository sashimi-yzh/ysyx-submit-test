+module PSRAM_QPI (
+  input   wire            clk,
+  input   wire            rst_n,
+  input   wire            valid,
+  output  wire            done,
+
+  output  reg             sck,
+  output  reg             ce_n,
+  output  wire [3:0]      dout,
+  output  wire            douten
+);
+  localparam  IDLE = 1'b0,
+              QPI_MODE = 1'b1;
+  reg state;
+  reg [7:0]   counter;
+  wire[7:0]   CMD_35H = 8'h35;
+  always @(posedge clk or negedge rst_n) begin
+    if(!rst_n) state <= IDLE;
+    else begin
+      case (state)
+        IDLE : state <= valid ? QPI_MODE : IDLE;
