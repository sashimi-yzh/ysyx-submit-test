+      end
+      //-----------------------------------------
+      // STATE_REFRESH
+      //-----------------------------------------
+      STATE_REFRESH: begin
+        // tRFC
+        delay_r = SDRAM_TRFC_CYCLES;
+      end
+      //-----------------------------------------
+      // STATE_DELAY
+      //-----------------------------------------
