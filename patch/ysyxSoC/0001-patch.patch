+  wire [SDRAM_ROW_W-1:0] addr_row_w = ram_addr_w[SDRAM_ADDR_W+1:SDRAM_COL_W+2+1+1];
+  wire [SDRAM_BANK_W-1:0] addr_bank_w = ram_addr_w[SDRAM_COL_W+2+1:SDRAM_COL_W+2-1+1];
