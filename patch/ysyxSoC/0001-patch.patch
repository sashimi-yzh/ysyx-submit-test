+  assign douten = is_initing ? {4{ms_doe}} : (wb_we ? {4{mw_doe}} : {4{mr_doe}});
+
+  assign mw_din = din;
+  assign mr_din = din;
+  assign ack_o = wb_we ? mw_done : mr_done;
