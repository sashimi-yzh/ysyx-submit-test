diff --git a/perip/bitrev/bitrev.v b/perip/bitrev/bitrev.v
index f1c3b363..25afe6ce 100644
--- a/perip/bitrev/bitrev.v
+++ b/perip/bitrev/bitrev.v
@@ -2,7 +2,32 @@ module bitrev (
   input  sck,
   input  ss,
   input  mosi,
-  output miso
+  output reg miso
 );
-  assign miso = 1'b1;
+    reg[7:0] data;
+    reg[2:0] count;
+    reg flag;
+    always @(posedge sck or posedge ss) begin
+        if(ss)begin
+            flag<=1'b0;
+            count<=3'd0;
+            data<=8'd0;
+        end else if(!flag)begin
+            data<={data[6:0],mosi};
+            count<=count+3'd1;
+            if(count==3'd7)
+                flag<=1'b1;
+        end
+    end
+    reg[2:0] count2;
+    always @(negedge sck or posedge ss) begin
+        if(ss)begin
+            miso<=1'b1;
+            count2<=3'd0;
+        end
+        else if(flag)begin
+            miso<=data[count2];
+            count2<=count2+3'd1;
+        end
+    end
 endmodule
diff --git a/perip/gpio/gpio_top_apb.v b/perip/gpio/gpio_top_apb.v
index ec51ffe5..bf3fc699 100644
--- a/perip/gpio/gpio_top_apb.v
+++ b/perip/gpio/gpio_top_apb.v
@@ -9,7 +9,7 @@ module gpio_top_apb(
   input  [31:0] in_pwdata,
   input  [3:0]  in_pstrb,
   output        in_pready,
-  output [31:0] in_prdata,
+  output reg [31:0] in_prdata,
   output        in_pslverr,
 
   output [15:0] gpio_out,
@@ -23,5 +23,85 @@ module gpio_top_apb(
   output [7:0]  gpio_seg_6,
   output [7:0]  gpio_seg_7
 );
+    reg [15:0] led;
+    reg [31:0] seg;
+    wire access,wen,ren;
+
+    assign access=in_psel&&in_penable;
+    assign wen=access&&in_pwrite;
+    assign ren=access&&(~in_pwrite);
+    assign in_pready=access;
+    assign in_pslverr=1'b0;
+    always @(*) begin
+        in_prdata=32'd0;
+        if(ren)begin
+            case(in_paddr[3:2])
+                2'b00:in_prdata={16'd0,led};
+                2'b01:in_prdata={16'd0,gpio_in};
+                2'b10:in_prdata=seg;
+                2'b11:in_prdata=32'd0;
+                default:in_prdata=32'd0;
+            endcase
+        end
+    end
+    integer i;
+    always @(posedge clock) begin
+        if(reset)begin
+            led<=16'd0;
+            seg<=32'd0;
+        end else if(wen)begin
+            case(in_paddr[3:2])
+                2'd0: begin 
+                        if(in_pstrb[0]) led[7:0] <=in_pwdata[7:0];
+                        if(in_pstrb[1]) led[15:8]<=in_pwdata[15:8];
+                end
+                2'd2: begin
+                        for(i=0;i<4;i++)begin
+                            if(in_pstrb[i]) seg[i*8 +: 8]<=in_pwdata[i*8 +: 8];
+                        end
+                end
+                default: ;
+            endcase
+        end
+    end
+
+    //interface
+    assign gpio_out=led;
+    bcd2seg bcd0(seg[3:0]  ,gpio_seg_0);
+    bcd2seg bcd1(seg[7:4]  ,gpio_seg_1);
+    bcd2seg bcd2(seg[11:8] ,gpio_seg_2);
+    bcd2seg bcd3(seg[15:12],gpio_seg_3);
+    bcd2seg bcd4(seg[19:16],gpio_seg_4);
+    bcd2seg bcd5(seg[23:20],gpio_seg_5);
+    bcd2seg bcd6(seg[27:24],gpio_seg_6);
+    bcd2seg bcd7(seg[31:28],gpio_seg_7);
+endmodule
+
+module bcd2seg(
+    input[3:0] b,
+    output reg [7:0] h
+);
+    always @(*) begin
+        case (b)
+            4'h0: h = 8'h03;
+            4'h1: h = 8'h9f;
+            4'h2: h = 8'h25;
+            4'h3: h = 8'h0d;
+            4'h4: h = 8'h99;
+            4'h5: h = 8'h49;
+            4'h6: h = 8'h41;
+            4'h7: h = 8'h1f;
+            4'h8: h = 8'h01;
+            4'h9: h = 8'h09;
+            4'ha: h = 8'h11;
+            4'hb: h = 8'hc1;
+            4'hc: h = 8'h63;
+            4'hd: h = 8'h85;
+            4'he: h = 8'h61;
+            4'hf: h = 8'h71;
+            default: h = 8'hff;
+        endcase
+    end
 
 endmodule
+
diff --git a/perip/ps2/ps2_top_apb.v b/perip/ps2/ps2_top_apb.v
index 080d38fa..48484a5b 100644
--- a/perip/ps2/ps2_top_apb.v
+++ b/perip/ps2/ps2_top_apb.v
@@ -15,5 +15,73 @@ module ps2_top_apb(
   input         ps2_clk,
   input         ps2_data
 );
+    wire ren,access;
+    assign access=in_psel&&in_penable;
+    assign ren=access&&(~in_pwrite)&&(in_paddr[2:0]==3'd0);
+
+    wire[7:0] data;
+    wire nextdata_n,ready,overflow;
+    assign nextdata_n=~(ren&&ready);
+    ysyx_26040117_ps2_keyboard ps2_keyboard1(clock,reset,ps2_clk,ps2_data,data,ready,nextdata_n,overflow);
+
+    assign in_pslverr=1'b0;
+    assign in_prdata={24'd0,ready?data:8'd0};
+    assign in_pready=access;
+endmodule
+
+module ysyx_26040117_ps2_keyboard(clk,rst,ps2_clk,ps2_data,data,
+                    ready,nextdata_n,overflow);
+    input clk,rst,ps2_clk,ps2_data;
+    input nextdata_n;
+    output [7:0] data;
+    output reg ready;
+    output reg overflow;     // fifo overflow
+    // internal signal, for test
+    reg [9:0] buffer;        // ps2_data bits
+    reg [7:0] fifo[7:0];     // data fifo
+    reg [2:0] w_ptr,r_ptr;   // fifo write and read pointers
+    reg [3:0] count;  // count ps2_data bits
+    // detect falling edge of ps2_clk
+    reg [2:0] ps2_clk_sync;
+
+    always @(posedge clk) begin
+        ps2_clk_sync <=  {ps2_clk_sync[1:0],ps2_clk};
+    end
+
+    wire sampling = ps2_clk_sync[2] & ~ps2_clk_sync[1];
+
+    always @(posedge clk) begin
+        if (rst == 1) begin // reset
+            count <= 0; w_ptr <= 0; r_ptr <= 0; overflow <= 0; ready<= 0;
+        end
+        else begin
+            if ( ready ) begin // read to output next data
+                if(nextdata_n == 1'b0) //read next data
+                begin
+                    r_ptr <= r_ptr + 3'b1;
+                    if(w_ptr==(r_ptr+1'b1)) //empty
+                        ready <= 1'b0;
+                end
+            end
+            if (sampling) begin
+              if (count == 4'd10) begin
+                if ((buffer[0] == 0) &&  // start bit
+                    (ps2_data)       &&  // stop bit
+                    (^buffer[9:1])) begin      // odd  parity
+                    fifo[w_ptr] <= buffer[8:1];  // kbd scan code
+                    w_ptr <= w_ptr+3'b1;
+                    ready <= 1'b1;
+                    overflow <= overflow | (r_ptr == (w_ptr + 3'b1));
+                end
+                count <= 0;     // for next
+              end else begin
+                buffer[count] <= ps2_data;  // store ps2_data
+                count <= count + 3'b1;
+              end
+            end
+        end
+    end
+    assign data = fifo[r_ptr]; //always set output data
 
 endmodule
+
