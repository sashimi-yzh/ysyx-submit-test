diff --git a/perip/psram/psram.v b/perip/psram/psram.v
index d9bdd882..38bb8bc0 100644
--- a/perip/psram/psram.v
+++ b/perip/psram/psram.v
@@ -3,7 +3,119 @@ module psram(
   input ce_n,
   inout [3:0] dio
 );
+    wire [3:0] din,dout,douten;
+    assign din=dio;
+    assign dio[0]=douten[0]?dout[0]:1'bz;
+    assign dio[1]=douten[1]?dout[1]:1'bz;
+    assign dio[2]=douten[2]?dout[2]:1'bz;
+    assign dio[3]=douten[3]?dout[3]:1'bz;
+    //state machine
+    reg qpi_mode=1'b0;
+    wire cmd_done;
+    wire[7:0] cmd_next;
+    reg [4:0] count;
+    reg [2:0] state,next_state;
+    localparam IDLE=3'd0,ADDR=3'd1,WAIT=3'd2,READ_DATA=3'd3,WRITE=3'd4,ERROR=3'd7;
+    always @(posedge sck or posedge ce_n) begin
+        if(ce_n)
+            state<=IDLE;
+        else 
+            state<=next_state;
+    end
+    always @(*) begin
+        case(state)
+            IDLE:     next_state=cmd_done?ADDR:state;
+            ADDR:     begin 
+                      if(count==5'd5)
+                            next_state=in_quad_read? WAIT :WRITE;
+                      else
+                            next_state=state;
+            end
+            WAIT:     next_state=(count==5'd5)?READ_DATA:state;
+            READ_DATA:next_state=state;
+            WRITE:    next_state=state;
+            default:  next_state=state;
+        endcase
+    end
+        
+    always @(posedge sck or posedge ce_n) begin
+        if(ce_n)
+            count<=5'd0;
