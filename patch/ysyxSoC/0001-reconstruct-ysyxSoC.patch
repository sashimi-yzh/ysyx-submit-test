+  always @(posedge sck or posedge ce_n) begin
+    if (ce_n) begin
+      state <= CMD;
+    end
+    else begin
+      state <= next_state;
+    end
+  end
+
+  always @(posedge sck or posedge ce_n) begin
+    if (ce_n) begin
+      count <= 8'b0;
+    end
+    else begin
+      if (count == cycle) begin
+        count <= 8'b0;
+      end
+      else begin
+        count <= count + 1;
+      end
+    end
+  end
+
+  assign dio = (state == DATA && cmd == 8'hEB) ? dout : 4'bz;
 
 endmodule
