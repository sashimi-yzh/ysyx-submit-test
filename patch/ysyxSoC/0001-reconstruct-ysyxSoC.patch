diff --git a/perip/bitrev/bitrev.v b/perip/bitrev/bitrev.v
index f1c3b363..3529a796 100644
--- a/perip/bitrev/bitrev.v
+++ b/perip/bitrev/bitrev.v
@@ -4,5 +4,45 @@ module bitrev (
   input  mosi,
   output miso
 );
-  assign miso = 1'b1;
+
+
+reg [7:0] data_recv;
+reg [2:0] bit_cnt;
+reg recv;
+
+always @(posedge sck or posedge ss) begin
+  if(ss) begin
+    data_recv <= 8'd0;
+  end
+  
+  else begin
+    if(recv) begin
+      data_recv <= {data_recv[6:0], mosi};
+    end
+
+    else begin
+      data_recv <= {1'b0, data_recv[7:1]};
+    end
+  end
+end
+
+always @(posedge sck or posedge ss) begin
+  if(ss) begin
+    bit_cnt <= 3'd0;
+    recv <= 1'b1;
+  end
+
+  else begin
+    if(bit_cnt == 3'd7) begin
+      bit_cnt <= 3'd0;
+      recv <= ~recv;
+    end
+
+    else begin
+      bit_cnt <= bit_cnt + 1'b1;
+    end
+  end
+end
+
+assign miso = (recv) ? 1'b1 : data_recv[0];
 endmodule
diff --git a/perip/gpio/gpio_top_apb.v b/perip/gpio/gpio_top_apb.v
index ec51ffe5..f965fe4a 100644
--- a/perip/gpio/gpio_top_apb.v
+++ b/perip/gpio/gpio_top_apb.v
@@ -1,27 +1,178 @@
 module gpio_top_apb(
-  input         clock,
-  input         reset,
