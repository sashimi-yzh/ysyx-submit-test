diff --git a/perip/psram/psram.v b/perip/psram/psram.v
index d9bdd882..a31073d5 100644
--- a/perip/psram/psram.v
+++ b/perip/psram/psram.v
@@ -3,7 +3,149 @@ module psram(
   input ce_n,
   inout [3:0] dio
 );
+  // assign dio = 4'bz;
+  wire reset = ce_n;
 
-  assign dio = 4'bz;
+    typedef enum [2:0] { cmd_t, R_addr_t, W_addr_t, R_data_t, W_data_t, err_t, QPI_config_t, Q_cmd_t } state_t;
+    reg [2:0]  state;
+    reg [7:0]  counter;
+    reg [7:0]  cmd;
+    reg [23:0] addr;
+    reg [31:0] data;
+    reg        QPI_MODE;
 
+  wire ren = (state == R_addr_t) && (counter == 8'd9);
+  wire wen = (state == W_data_t) && (counter == 8'd1 || counter == 8'd3 || counter == 8'd5 || counter == 8'd7 || counter == 8'd9 || counter == 8'd11 || counter == 8'd13 || counter == 8'd15);
+  wire valid = ren || wen;
+  wire [31:0] rdata;
+  wire [31:0] raddr = {8'b0, addr};
+  // wire [31:0] wdata = data;
+  wire [31:0] wdata = {data[27:0], dio};
+  wire [7:0] next_cmd = {cmd[6:0], dio[0]};
+  wire [7:0] Q_next_cmd = {cmd[3:0], dio};
+  psram_cmd psram_cmd_i(
+    .clock(sck),
+    .valid(valid),
+    .cmd(cmd),
+    .addr(raddr),
+    .wdata(wdata),
+    .rdata(rdata)
+  );
+
+  always@(posedge sck or posedge reset) begin
+    if (reset) state <= QPI_MODE ? Q_cmd_t : cmd_t;
+    else begin
+      case (state)
+        QPI_config_t: state <= Q_cmd_t;
+        cmd_t:  state <= (counter == 8'd7  && next_cmd == 8'hEB) ? R_addr_t : (counter == 8'd7  && next_cmd == 8'h38) ? W_addr_t : (counter == 8'd7  && next_cmd == 8'h35) ? QPI_config_t : state;
+        Q_cmd_t: state <= (counter == 8'd1  && Q_next_cmd == 8'hEB) ? R_addr_t : (counter == 8'd1  && Q_next_cmd == 8'h38) ? W_addr_t : state;
+        R_addr_t: state <= (cmd     != 8'hEB ) ? err_t  :
+                         (counter == 8'd9) ? R_data_t : state;
+        R_data_t: state <= state;
+        W_addr_t: state <= (cmd     != 8'h38 ) ? err_t  :
+                         (counter == 8'd6) ? W_data_t : state;
+        W_data_t: state <= state;
+
+        default: begin
+          state <= state;
+          $fwrite(32'h80000002, "Assertion failed: Unsupported command `%xh`, only support `03h` read command\n", cmd);
+          $fatal;
+        end
+      endcase
+    end
+  end
+
+  always@(posedge sck or posedge reset) begin
+    if (reset) counter <= 8'd0;
+    else begin
+      case (state)
+        cmd_t:   counter <= (counter < 8'd7 ) ? counter + 8'd1 : 8'd0;
+        Q_cmd_t:  counter <= (counter < 8'd1) ? counter + 8'd1 : 8'd0;
+        R_addr_t:  counter <= (counter < 8'd9) ? counter + 8'd1 : 8'd0;
+        W_addr_t:  counter <= (counter < 8'd6) ? counter + 8'd1 : 8'd0;
+        default: counter <= counter + 8'd1;
+      endcase
+    end
+  end
+
+  always@(posedge sck or posedge reset) begin
+    if (reset)               cmd <= 8'd0;
+    else if (state == cmd_t && counter < 8'd8) cmd <= { cmd[6:0], dio[0] };
+    else if (state == Q_cmd_t && counter < 8'd2) cmd <= { cmd[3:0], dio };
+  end
+
+  always@(negedge sck) begin
+    if (state == QPI_config_t) begin 
+      QPI_MODE <= 1'b1;
+      // $display("PSRAM: QPI mode enabled");
+    end
+  end
+
+  always@(posedge sck or posedge reset) begin
+    if (reset) addr <= 24'd0;
+    else if (state == R_addr_t && counter < 8'd7)
+      addr <= { addr[19:0], dio };
+    else if (state == W_addr_t && counter < 8'd7)
+      addr <= { addr[19:0], dio };
+      else if (state == W_data_t && wen)
+      addr <= addr + 1;
+  end
+
+  wire [31:0] data_bswap = {rdata[7:0], rdata[15:8], rdata[23:16], rdata[31:24]};
+
+  always@(posedge sck or posedge reset) begin
+    if (reset) data <= 32'd0;
+    else if (state == R_data_t) begin
+      if (counter == 8'd0) begin
+        data <= data_bswap;
+      end
+      else begin
+        data <= { data[27:0], 4'b0 };
+      end
+      // data <= { {counter == 8'd0 ? data_bswap : data}[27:0], 4'b0 };
+    end
+    else if (state == W_data_t && counter < 8'd8) begin
+      data <= { data[27:0], dio };
+    end
+  end
+
+  assign dio = ce_n ? 4'bz : state == R_data_t ? ({(state == R_data_t && counter == 8'd0) ? data_bswap : data}[31 : 28]) : 4'bz;
+
+endmodule
+
+// `define MTRACE
+
+module psram_cmd #(
+  parameter PSRAM_SIZE_4MB = 4 * 1024 * 1024
+  )(
+  input             clock,
+  input             valid,
+  input       [7:0] cmd,
+  input      [31:0] addr,
+  input      [31:0] wdata,
+  output reg [31:0] rdata
+);
+
+  reg [7:0] psram_mem [0:PSRAM_SIZE_4MB - 1];
+
+  always@(posedge clock) begin
+    if (valid)
+      if (cmd == 8'hEB)  begin 
+        rdata <= {psram_mem[addr + 3], psram_mem[addr + 2], psram_mem[addr + 1], psram_mem[addr]};
+        `ifdef MTRACE
+          $display("PSRAM: Read 0x%08x = 0x%08x", addr + 32'h80000000, {psram_mem[addr + 3], psram_mem[addr + 2], psram_mem[addr + 1], psram_mem[addr]});
+        `endif
+      end
+      else if (cmd == 8'h38)  begin 
+                            psram_mem[addr]     <= wdata[7:0];
+                            `ifdef MTRACE
+                              $display("PSRAM: Write 0x%08x = 0x%02x", addr + 32'h80000000, wdata[7:0]);
+                            `endif
+      end
+      else begin
+        $fwrite(32'h80000002, "Assertion failed: Unsupport command `%xh`, only support `03h` read command\n", cmd);
+        $fatal;
+      end
+  end
 endmodule
