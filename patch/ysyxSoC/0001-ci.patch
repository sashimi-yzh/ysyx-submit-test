+         2'b01: DRAM[write_bank][waddress][15:8] <= wdata[15:8];
+         2'b00: DRAM[write_bank][waddress]       <= wdata;
+        endcase
+        
+      end
+  end
+
+//BURST_TERMINATE 在最上面实现
+
+//PRECHARGE => NOP
+
+//AUTO REFRESH => NOP
+
+//LOAD_MODE_REGISTER
+
+always @(posedge clk) begin
+    if (opcode == LOAD_MODE_REGISTER && cke == 1'b1) begin
+      CAS_Latency <= a[6:4];
