+    if (dq_en) begin
+      $display("SDRAM READ: bank=%d, address=%d, data=%04x", read_bank, raddress, DRAM[read_bank][raddress]);
+    end
+  end
+  `endif
+
+  wire dq_en = (cke == 1'b1 && read_en && burst_busy);
+  wire [15:0] dq_out = DRAM[read_bank][raddress]; // need to check if this is correct
+  assign dq = dq_en? dq_out : 16'bz;
+
+  //WRITE
+
+  reg [15:0] wdata;
+
+  always @(posedge clk) begin
