diff --git a/perip/amba/apb_delayer.v b/perip/amba/apb_delayer.v
index c0d20764..313c80d5 100644
--- a/perip/amba/apb_delayer.v
+++ b/perip/amba/apb_delayer.v
@@ -23,7 +23,80 @@ module apb_delayer(
   input  [31:0] out_prdata,
   input         out_pslverr
 );
+`ifdef DELAY_ON
 
+parameter CPU_FREQ = 464; // MHz
+parameter SDRAM_FREQ = 100; // MHz
+parameter FLASH_FREQ = 50; 
+parameter SDRAM_CYCLE = 6;
+parameter FLASH_CYCLE = 150;
+
+wire [15:0] sdram_delay_target = (SDRAM_CYCLE * (CPU_FREQ - SDRAM_FREQ));
+wire [15:0] flash_delay_target = (FLASH_CYCLE * (CPU_FREQ - FLASH_FREQ));
+wire        sdram_active = in_paddr >= 32'ha0000000 && in_paddr < 32'hc0000000 && in_psel;
+wire        flash_active = in_paddr >= 32'h30000000 && in_paddr < 32'h40000000 && in_psel;
+wire        valid = (sdram_valid | flash_valid);
+wire        other_device_valid = !flash_active & !sdram_active;
+
+reg [15:0] sdram_delay_counter;
+reg [15:0] flash_delay_counter;
+reg        sdram_valid;
+reg        flash_valid;
+
+
+always @(posedge clock) begin
+  if (reset) begin
+    sdram_delay_counter <= 0;
+    flash_delay_counter <= 0;
+    sdram_valid <= 0;
+    flash_valid <= 0;
+  end
+  else begin
+    sdram_delay_counter <= 0;
+    flash_delay_counter <= 0;
+    if (in_pready) begin
+      sdram_valid <= 0;
+      flash_valid <= 0;
+    end
+    case (1'b1)
+      sdram_active: begin
+        sdram_delay_counter <= sdram_delay_counter + SDRAM_FREQ;
+        if (sdram_delay_counter >= sdram_delay_target) begin
+          sdram_valid <= 1;
+          sdram_delay_counter <= 0;
+        end
+      end
+      flash_active: begin
+        flash_delay_counter <= flash_delay_counter + FLASH_FREQ;
+        if (flash_delay_counter >= flash_delay_target) begin
+          flash_valid <= 1;
+          flash_delay_counter <= 0;
+        end
+      end
+    endcase
+  end
+end
+reg penable_reg;
+
+always @(posedge clock) begin
+  if (valid)
+    penable_reg <= 1'b1;
+  else
+    penable_reg <= 1'b0;
+end
+
+  assign out_paddr   = valid ? in_paddr     : other_device_valid ? in_paddr: 0;
+  assign out_psel    = valid ? in_psel      : other_device_valid ? in_psel: 0;
+  assign out_penable = valid ? penable_reg  : other_device_valid ? in_penable: 0;
+  assign out_pprot   = valid ? in_pprot     : other_device_valid ? in_pprot: 0;
+  assign out_pwrite  = valid ? in_pwrite    : other_device_valid ? in_pwrite: 0;
+  assign out_pwdata  = valid ? in_pwdata    : other_device_valid ? in_pwdata: 0;
+  assign out_pstrb   = valid ? in_pstrb     : other_device_valid ? in_pstrb: 0;
+  assign in_pready   = valid ? out_pready   : other_device_valid ? out_pready: 0;
+  assign in_prdata   = valid ? out_prdata   : other_device_valid ? out_prdata: 0;
+  assign in_pslverr  = valid ? out_pslverr  : other_device_valid ? out_pslverr: 0;
+
+`else 
   assign out_paddr   = in_paddr;
   assign out_psel    = in_psel;
   assign out_penable = in_penable;
@@ -34,5 +107,6 @@ module apb_delayer(
   assign in_pready   = out_pready;
   assign in_prdata   = out_prdata;
   assign in_pslverr  = out_pslverr;
+`endif
 
 endmodule
diff --git a/perip/amba/axi4_delayer.v b/perip/amba/axi4_delayer.v
index f692803b..f5d29fa4 100644
--- a/perip/amba/axi4_delayer.v
+++ b/perip/amba/axi4_delayer.v
@@ -62,7 +62,131 @@ module axi4_delayer(
   input  [3:0]  out_bid,
   input  [1:0]  out_bresp
 );
+`ifdef DELAY_ON
 
+// 核心参数：CPU时钟频率(MHz)、外设时钟频率、需要的延时周期数
+parameter CPU_FREQ     = 734;  // MHz
+parameter SDRAM_FREQ   = 100;  // MHz
+parameter SDRAM_CYCLE  = 16;   // SDRAM需要的延时周期数
+parameter FLASH_FREQ   = 50;   // MHz
+parameter FLASH_CYCLE  = 150;  // FLASH需要的延时周期数
+
+// 修复：正确计算延时目标值（CPU时钟周期数）
+wire [31:0] sdram_delay_target = SDRAM_CYCLE * (CPU_FREQ / SDRAM_FREQ);
+wire [31:0] flash_delay_target = FLASH_CYCLE * (CPU_FREQ / FLASH_FREQ);
+
+// 修复：地址判断逻辑加括号，确保优先级正确；busy后置（先判断地址，再结合忙状态）
+wire sdram_addr_hit  = (in_araddr >= 32'ha0000000 && in_araddr < 32'hc0000000) || 
+                       (in_awaddr >= 32'ha0000000 && in_awaddr < 32'hc0000000);
+wire flash_addr_hit  = (in_araddr >= 32'h30000000 && in_araddr < 32'h40000000) || 
+                       (in_awaddr >= 32'h30000000 && in_awaddr < 32'h40000000);
+wire sdram_active    = sdram_addr_hit & busy & !sdram_valid;  // 未完成延时才激活
+wire flash_active    = flash_addr_hit & busy & !flash_valid;  // 未完成延时才激活
+wire delay_active    = sdram_active | flash_active;           // 正在延时
+wire other_device    = !sdram_addr_hit & !flash_addr_hit;     // 非SDRAM/FLASH设备
+
+// 延时状态寄存器
+reg [31:0] sdram_delay_counter;
+reg [31:0] flash_delay_counter;
+reg        sdram_valid;       // SDRAM延时完成
+reg        flash_valid;       // FLASH延时完成
+reg        busy;              // 总线忙状态
+
+// 1. 忙状态控制：检测AXI发起请求，且握手完成后置忙；响应完成后置闲
+always @(posedge clock) begin
+  if (reset) begin
+    busy <= 1'b0;
+  end else begin
+    // 置忙：AXI读/写请求握手完成
+    if ((in_arvalid & in_arready) || (in_awvalid & in_awready & in_wvalid & in_wready)) begin
+      busy <= 1'b1;
+    end
+    // 置闲：读/写响应完成
+    else if ((out_rvalid & out_rready & out_rlast) || (out_bvalid & out_bready)) begin
+      busy <= 1'b0;
+    end
+  end
+end
+
+// 2. 延时计数器控制：修复重置逻辑，仅在复位/延时完成时清零
+always @(posedge clock) begin
+  if (reset) begin
+    sdram_delay_counter <= 32'd0;
+    flash_delay_counter <= 32'd0;
+    sdram_valid         <= 1'b0;
+    flash_valid         <= 1'b0;
+  end else begin
+    // 默认值：保持当前状态（关键修复：不再强制清零）
+    sdram_delay_counter <= sdram_delay_counter;
+    flash_delay_counter <= flash_delay_counter;
+    sdram_valid         <= sdram_valid;
+    flash_valid         <= flash_valid;
+
+    // 延时完成后清零计数器和有效信号
+    if ((sdram_valid & out_arready) || (flash_valid & out_awready)) begin
+      sdram_delay_counter <= 32'd0;
+      flash_delay_counter <= 32'd0;
+      sdram_valid         <= 1'b0;
+      flash_valid         <= 1'b0;
+    end
+
+    // SDRAM延时计数
+    if (sdram_active) begin
+      sdram_delay_counter <= sdram_delay_counter + 32'd1;  // 每CPU时钟加1
+      if (sdram_delay_counter >= sdram_delay_target) begin
+        sdram_valid         <= 1'b1;
+        sdram_delay_counter <= 32'd0;
+      end
+    end
+
+    // FLASH延时计数
+    if (flash_active) begin
+      flash_delay_counter <= flash_delay_counter + 32'd1;
+      if (flash_delay_counter >= flash_delay_target) begin
+        flash_valid         <= 1'b1;
+        flash_delay_counter <= 32'd0;
+      end
+    end
+  end
+end
+
+// 3. AXI握手信号控制：延时完成/非延时设备正常转发，延时中阻断
+wire valid = sdram_valid | flash_valid;  // 延时完成
+assign in_arready  = delay_active ? 1'b0 : (other_device ? out_arready : out_arready);
+assign out_arvalid = delay_active ? 1'b0 : (other_device ? in_arvalid  : in_arvalid);
+assign out_arid    = out_arvalid ? in_arid     : 4'b0;
+assign out_araddr  = out_arvalid ? in_araddr   : 32'b0;
+assign out_arlen   = out_arvalid ? in_arlen    : 8'b0;
+assign out_arsize  = out_arvalid ? in_arsize   : 3'b0;
+assign out_arburst = out_arvalid ? in_arburst  : 2'b0;
+
+assign out_rready  = in_rready;
+assign in_rvalid   = out_rvalid;
+assign in_rid      = out_rvalid ? out_rid     : 4'b0;
+assign in_rdata    = out_rvalid ? out_rdata   : 32'b0;
+assign in_rresp    = out_rvalid ? out_rresp   : 2'b0;
+assign in_rlast    = out_rvalid ? out_rlast   : 1'b0;
+
+assign in_awready  = delay_active ? 1'b0 : (other_device ? out_awready : out_awready);
+assign out_awvalid = delay_active ? 1'b0 : (other_device ? in_awvalid  : in_awvalid);
+assign out_awid    = out_awvalid ? in_awid     : 4'b0;
+assign out_awaddr  = out_awvalid ? in_awaddr   : 32'b0;
+assign out_awlen   = out_awvalid ? in_awlen    : 8'b0;
+assign out_awsize  = out_awvalid ? in_awsize   : 3'b0;
+assign out_awburst = out_awvalid ? in_awburst  : 2'b0;
+
+assign in_wready   = delay_active ? 1'b0 : (other_device ? out_wready  : out_wready);
+assign out_wvalid  = delay_active ? 1'b0 : (other_device ? in_wvalid   : in_wvalid);
+assign out_wdata   = out_wvalid ? in_wdata    : 32'b0;
+assign out_wstrb   = out_wvalid ? in_wstrb    : 4'b0;
+assign out_wlast   = out_wvalid ? in_wlast    : 1'b0;
+
+assign out_bready  = in_bready;
+assign in_bvalid   = out_bvalid;
+assign in_bid      = out_bvalid ? out_bid     : 4'b0;
+assign in_bresp    = out_bvalid ? out_bresp   : 2'b0;
+
+`else
   assign in_arready = out_arready;
   assign out_arvalid = in_arvalid;
   assign out_arid = in_arid;
@@ -92,5 +216,6 @@ module axi4_delayer(
   assign in_bvalid = out_bvalid;
   assign in_bid = out_bid;
   assign in_bresp = out_bresp;
+  `endif
 
 endmodule
diff --git a/perip/bitrev/bitrev.v b/perip/bitrev/bitrev.v
index f1c3b363..17f54f85 100644
--- a/perip/bitrev/bitrev.v
+++ b/perip/bitrev/bitrev.v
@@ -4,5 +4,60 @@ module bitrev (
   input  mosi,
   output miso
 );
-  assign miso = 1'b1;
+  // assign miso = 1'b1;
+
+  reg [31:0] buffer;
+  reg [4:0] pointer;
+  reg [1:0] state;
+  reg miso_reg;
+  reg valid;
+
+  localparam IDLE  = 2'd0;
+  localparam WRITE = 2'd1;
+  localparam READ  = 2'd2;
+
+  assign miso = ss ? 1'b1 : miso_reg;
+
+  always @(posedge sck or posedge ss or negedge sck) begin
+    if (ss) begin
+      pointer <= 5'd0;
+      state <= IDLE;
+      buffer <= 32'b0;
+      miso_reg <= 1'b0;
+      valid <= 1'b0;
+    end else begin
+      case (state) 
+        IDLE: begin
+          if (sck == 1'b1) begin
+            buffer <= 32'b0;
+            pointer <= 5'd0;
+            state <= WRITE;
+          end
+        end
+        WRITE: begin
+          if (sck == 1'b0) begin
+            buffer[pointer] <= mosi;
+            pointer <= pointer + 1;
+            if (pointer == 5'd31) begin
+              pointer <= 5'd31;
+              state <= READ;
+            end
+          end
+        end
+        READ: begin
+          if (sck == 1'b1) begin
+            miso_reg <= buffer[pointer];
+          pointer <= pointer - 1;
+          if (pointer == 5'd0) begin
+            pointer <= 5'd0;
+            state <= IDLE;
+          end
+          end
+        end
+        default: begin
+            state <= IDLE;
+        end
+      endcase
+    end
+  end
 endmodule
diff --git a/perip/gpio/gpio_top_apb.v b/perip/gpio/gpio_top_apb.v
index ec51ffe5..63d1a47a 100644
--- a/perip/gpio/gpio_top_apb.v
+++ b/perip/gpio/gpio_top_apb.v
@@ -1,4 +1,9 @@
-module gpio_top_apb(
+module gpio_top_apb # (
+  parameter GPIO_LED = 32'h1000_2000,
+  parameter GPIO_SW = 32'h1000_2004,
+  parameter GPIO_DATA = 32'h1000_2008,
+  parameter GPIO_END = 32'h1000_200c
+)(
   input         clock,
   input         reset,
   input  [31:0] in_paddr,
@@ -24,4 +29,115 @@ module gpio_top_apb(
   output [7:0]  gpio_seg_7
 );
 
+reg [15:0] led_reg;
+reg [31:0] gpio_reg;
+reg [31:0] rdata;
+reg        ack_reg;
+
+wire led_active = in_psel && in_penable && in_paddr >= GPIO_LED && in_paddr < GPIO_SW;
+wire sw_active = in_psel && in_penable && in_paddr >= GPIO_SW && in_paddr < GPIO_DATA;
+wire data_active = in_psel && in_penable && in_paddr >= GPIO_DATA && in_paddr < GPIO_END;
+
+genvar i;  
+generate
+    for(i = 0; i < 16; i = i + 1) begin : gpio_bit_gen
+        // assign gpio_out[i] = led_reg[i];
+        assign gpio_out[i] = gpio_in[i] ? led_reg[i] : 1'b0;
+    end
+endgenerate
+
+always @(posedge clock) begin
+  if (reset)
+    led_reg <= 16'b1010101010101010;
+  else if (led_active && in_pwrite && in_penable)
+    if (in_pstrb[0]) led_reg[7:0] <= in_pwdata[7:0];
+    if (in_pstrb[1]) led_reg[15:8] <= in_pwdata[15:8];
+end
+
+always @(posedge clock) begin
+  if (reset)
+    gpio_reg <= 32'h0000;
+  else if (data_active && in_pwrite && in_penable) begin
+    if (in_pstrb[0]) gpio_reg[7:0] <= in_pwdata[7:0];
+    if (in_pstrb[1]) gpio_reg[15:8] <= in_pwdata[15:8];
+    if (in_pstrb[2]) gpio_reg[23:16] <= in_pwdata[23:16];
+    if (in_pstrb[3]) gpio_reg[31:24] <= in_pwdata[31:24];
+  end
+end
+
+always @(posedge clock) begin
+  if (reset) begin
+    ack_reg <= 1'b0;
+    rdata <= 32'h0000;
+  end
+  else if (led_active && !in_pwrite && in_penable) begin
+    ack_reg <= 1'b1;
+    rdata <= {16'h0000, led_reg};
+  end
+  else if (sw_active && !in_pwrite && in_penable) begin
+    ack_reg <= 1'b1;
+    rdata <= {16'h0000, gpio_in};
+  end
+  else if (data_active && !in_pwrite && in_penable) begin
+    ack_reg <= 1'b1;
+    rdata <= gpio_reg;
+  end
+    else if (led_active && in_pwrite && in_penable) begin
+    ack_reg <= 1'b1;
+  end
+  else if (sw_active && in_pwrite && in_penable) begin
+    ack_reg <= 1'b1;
+  end
+  else if (data_active && in_pwrite && in_penable) begin
+    ack_reg <= 1'b1;
+  end
+  else begin
+    ack_reg <= 1'b0;
+    rdata <= 32'h0000;
+  end
+end
+
+assign in_pready = ack_reg;
+assign in_prdata = rdata;
+assign in_pslverr = 1'b0;
+
+seg_decoder u0_seg_decoder (
+ .data(gpio_reg[3:0]),
+ .seg(gpio_seg_0)
+);
+
+seg_decoder u1_seg_decoder (
+ .data(gpio_reg[7:4]),
+ .seg(gpio_seg_1)
+);
+
+seg_decoder u2_seg_decoder (
+ .data(gpio_reg[11:8]),
+ .seg(gpio_seg_2)
+);
+
+seg_decoder u3_seg_decoder (
+ .data(gpio_reg[15:12]),
+ .seg(gpio_seg_3)
+);
+
+seg_decoder u4_seg_decoder (
+ .data(gpio_reg[19:16]),
+ .seg(gpio_seg_4)
+);
+
+seg_decoder u5_seg_decoder (
+ .data(gpio_reg[23:20]),
+ .seg(gpio_seg_5)
+);
+
+seg_decoder u6_seg_decoder (
+ .data(gpio_reg[27:24]),
+ .seg(gpio_seg_6)
+);
+
+seg_decoder u7_seg_decoder (
+ .data(gpio_reg[31:28]),
+ .seg(gpio_seg_7)
+);
 endmodule
diff --git a/perip/gpio/seg_decoder.v b/perip/gpio/seg_decoder.v
new file mode 100644
index 00000000..f69ae9e6
--- /dev/null
+++ b/perip/gpio/seg_decoder.v
@@ -0,0 +1,27 @@
+module seg_decoder (
+    input wire [3:0]  data,
+    output reg [7:0] seg
+);
+
+always @(*) begin
+    case (data)
+        4'd0 : seg = 8'b00000011;
+        4'd1 : seg = 8'b10011111;
+        4'd2 : seg = 8'b00100101;
+        4'd3 : seg = 8'b00001101;
+        4'd4 : seg = 8'b10011001;
+        4'd5 : seg = 8'b01001001;
+        4'd6 : seg = 8'b01000001;
+        4'd7 : seg = 8'b00011111;
+        4'd8 : seg = 8'b00000001;
+        4'd9 : seg = 8'b00000101;
+        4'd10: seg = 8'b00010001;
+        4'd11: seg = 8'b11000001;
+        4'd12: seg = 8'b01100011;
+        4'd13: seg = 8'b10000101;
+        4'd14: seg = 8'b01100001;
+        4'd15: seg = 8'b01110001;
+    endcase
+end
+
