+          end
+          else begin
+            read_data[7:0] <= ps2_read_data;
+            ack_reg <= 1;
+            state <= IDLE;
+            // $display("ps2_data lo = %02x", ps2_read_data);
+          end
+        end
+      end
+    endcase
+  end
