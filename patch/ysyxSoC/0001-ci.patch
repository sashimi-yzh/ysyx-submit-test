+                         (Burst_Length == 3'b001)? 2 :
+                         (Burst_Length == 3'b010)? 4 :
+                         (Burst_Length == 3'b011)? 8 :
+                         (Burst_Length == 3'b111)? 8'hff : 1; // 连续页
+  assign delay_val     = (CAS_Latency  == 3'b001) ? 1 :
+                         (CAS_Latency  == 3'b010) ? 2 :
+                         (CAS_Latency  == 3'b011) ? 3 : 1;
+
+  assign Col_address = Col_address_reg + burst_count;
+  assign done = (burst_busy && burst_count == burst_len_val - 1);
+
+  always @(posedge clk) begin
+    if (cke == 1'b0) begin
+      Col_address_reg <= 13'b0;
+      Col_address_reg0 <= 13'b0;
+    end
+    else begin
+      if (opcode == WRITE) 
+        Col_address_reg <= a;
+      else if (delay_count[delay_val-1] == 1'b1)
+        Col_address_reg <= Col_address_reg0;
+      if (opcode == READ)
+        Col_address_reg0 <= a;
+    end
+  end
+
+   always @(posedge clk) begin
+    if (cke == 1'b0)
+      burst_busy <= 1'b0;
+    else begin
+      if (delay_count[delay_val-1] == 1'b1)
+        burst_busy <= 1'b1;
+      else if (opcode == WRITE)
+        burst_busy <= 1'b1;
+      else if (opcode == BURST_TERMINATE)
+        burst_busy <= 1'b0;
+      else if (done) 
+        burst_busy <= 1'b0;
+    end
+  end
+
+  always @(posedge clk) begin
+    if (cke == 1'b0) 
+      delay_count <= 4'b0;
+    else begin
+        delay_count <= {delay_count[2:0], opcode == READ};
+      if (opcode == BURST_TERMINATE) 
+        delay_count <= 4'b0;
+    end
+  end
+
+    always @(posedge clk) begin
+    if (cke == 1'b0) 
+      burst_count <= 8'b0;
+    else begin
+      if (opcode == BURST_TERMINATE) 
+        burst_count <= 8'b0;
+      else if (burst_busy || (opcode == WRITE)) 
+        burst_count <= burst_count < burst_len_val - 1 ? burst_count + 1 : burst_count;
+    end
+  end
+
+  always @(posedge clk) begin
