diff --git a/perip/vga/vga_ctrl.v b/perip/vga/vga_ctrl.v
new file mode 100644
index 00000000..1a9c8f77
--- /dev/null
+++ b/perip/vga/vga_ctrl.v
@@ -0,0 +1,75 @@
+module vga_ctrl(
+    input           pclk,     //25MHz时钟
+    input           reset,    //置位
+    input  [23:0]   vga_data, //上层模块提供的VGA颜色数据
+    output [9:0]    h_addr,   //提供给上层模块的当前扫描像素点坐标
+    output [9:0]    v_addr,
+    output          hsync,    //行同步和列同步信号
+    output          vsync,
+    output          valid,    //消隐信号
+    output [7:0]    vga_r,    //红绿蓝颜色信号
+    output [7:0]    vga_g,
+    output [7:0]    vga_b
+    );
+
+  parameter    h_frontporch = 96;
+  parameter    h_active = 144;
+  parameter    h_backporch = 784;
+  parameter    h_total = 800;
+
+  parameter    v_frontporch = 2;
+  parameter    v_active = 35;
+  parameter    v_backporch = 515;
+  parameter    v_total = 525;
+
+  //像素计数值
+  reg [9:0]    x_cnt;
+  reg [9:0]    y_cnt;
+  reg          pad;
+  wire         h_valid;
+  wire         v_valid;
+
+always @(posedge pclk) begin//行同步信号
+    if (reset == 1'b1)
+        pad <= 1'b0;
+    else
+      pad <= ~pad;    
+end
+        
+
+  always @(posedge pclk) //行像素计数
+      if (reset == 1'b1)
+        x_cnt <= 1;
+      else
+      begin
+        if (x_cnt == h_total)
+            x_cnt <= 1;
+        else
+            x_cnt <= x_cnt + 10'd1;
+      end
+
+  always @(posedge pclk)  //列像素计数
+      if (reset == 1'b1)
+        y_cnt <= 1;
+      else
+      begin
+        if (y_cnt == v_total & x_cnt == h_total)
+            y_cnt <= 1;
+        else if (x_cnt == h_total)
+            y_cnt <= y_cnt + 10'd1;
+      end
+  //生成同步信号
+  assign hsync = (x_cnt > h_frontporch);
+  assign vsync = (y_cnt > v_frontporch);
+  //生成信号
+  assign h_valid = (x_cnt > h_active) & (x_cnt <= h_backporch);
+  assign v_valid = (y_cnt > v_active) & (y_cnt <= v_backporch);
+  assign valid = h_valid & v_valid;
+  //计算当前有效像素坐标
+  assign h_addr = valid ? (x_cnt - 10'd145) : {10{1'b0}};
+  assign v_addr = valid ? (y_cnt - 10'd36) : {10{1'b0}};
+  //设置输出的颜色值
+  assign vga_r = valid ? vga_data[23:16] : 8'd0;
+  assign vga_g = valid ? vga_data[15:8]  : 8'd0;
+  assign vga_b = valid ? vga_data[7:0]  : 8'd0;
+endmodule
\ No newline at end of file
diff --git a/perip/vga/vga_top_apb.v b/perip/vga/vga_top_apb.v
index 5c74cfbe..5b46e847 100644
--- a/perip/vga/vga_top_apb.v
+++ b/perip/vga/vga_top_apb.v
@@ -20,4 +20,124 @@ module vga_top_apb(
   output        vga_valid
 );
 
+  parameter    h_active = 144;
+  parameter    h_backporch = 784;
+  parameter    v_active = 35;
+  parameter    v_backporch = 515;
+
+wire        vga_active;
+wire [9:0]  h_addr;
+wire [9:0]  v_addr;
+wire [23:0] vga_data;
+wire        vga_ready;
+wire [21:0] apb_to_vmem_addr;
+reg [21:0]  waddr;
+reg [31:0]  wdata;
+reg [3:0]   wstrb;
+reg         state;
+reg         wen;
+reg         ack_reg;
+localparam IDLE = 0, WRITE = 1;
+
+assign in_prdata = 32'h0;
+assign in_pslverr = 0;
+assign in_pready = ack_reg;
+assign vga_active = in_psel && in_penable && in_paddr >= 32'h2100_0000 && in_paddr < 32'h2120_0000;
+/* verilator lint_off WIDTHTRUNC */
+assign apb_to_vmem_addr = (in_paddr - 32'h2100_0000) >> 2;
+/* verilator lint_on WIDTHTRUNC */
+
+
+always @(posedge clock) begin
+  if (reset) begin
+    state <= IDLE;
+    ack_reg <= 0;
+    wen <= 0;
+    waddr <= 0;
+    wdata <= 0;
+    wstrb <= 0;
+  end
+  else begin
+    case (state)
+      IDLE: begin
+        ack_reg <= 0;
+        if (vga_active && in_pwrite) begin
+          // $display("vga_top_apb: write data");
+          state <= WRITE;
+          wen <= 1;
+          waddr <= apb_to_vmem_addr;
+          wdata <= in_pwdata;
+          wstrb <= in_pstrb;
+        end
+        if (vga_active && !in_pwrite) begin
+          $display("vga_top_apb: read not supported");
+        end
+      end
+      WRITE: begin
+          wen <= 0;
+        // if (vga_ready) begin
+          state <= IDLE;
+          ack_reg <= 1;
+        // end
+      end
+  endcase
+  end
+end
+
+vga_ctrl vga_ctrl_inst(
+   .pclk(clock),
+   .reset(reset),
+   .h_addr(h_addr),
+   .v_addr(v_addr),
+   .vga_data(vga_data),
+   .hsync(vga_hsync),
+   .vsync(vga_vsync),
+   .valid(vga_valid),
+   .vga_r(vga_r),
+   .vga_g(vga_g),
+   .vga_b(vga_b)
+);
+
+vmem vmem_inst(
+  .clock(clock),
+  .addr(waddr),
+  .wdata(wdata[23:0]),
+  .wen(wen),
+  // .ack(vga_ready),
+  .h_addr(h_addr),
+  .v_addr(v_addr),
+  // .v_addr(v_addr[8:0]),
+  .vga_data(vga_data)
+);
+
+endmodule
+
+module vmem(
+  input          clock,
+  input [21:0]   addr,
+  input [23:0]   wdata,
+  input          wen,
+  input [9:0]    h_addr,
+  input [9:0]    v_addr,
+  output [23:0]  vga_data
+);
+
