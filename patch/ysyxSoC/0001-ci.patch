+  .clk(clock),
+  .clrn(!reset),
+  .ps2_clk(ps2_clk),
+  .ps2_data(ps2_data),
+  .data(ps2_read_data),
+  .ready(read_ready),
+  .nextdata_n(!read_valid),
+  .overflow(overflow)
+);
+
+assign in_pslverr = 0;
+
 endmodule
