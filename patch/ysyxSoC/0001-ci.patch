diff --git a/perip/spi/rtl/xip.v b/perip/spi/rtl/xip.v
new file mode 100644
index 00000000..e9fffbf9
--- /dev/null
+++ b/perip/spi/rtl/xip.v
@@ -0,0 +1,238 @@
+`include "spi_defines.v"
+
+module xip #(
+  parameter flash_addr_start = 32'h30000000,
+  parameter flash_addr_end   = 32'h3fffffff,
+  parameter spi_addr_start   = 32'h10001000,
+  parameter spi_addr_end     = 32'h10001fff
+) (
+      // Wishbone signals
+  input                            xip_wb_clk_i,         // master clock input
+  input                            xip_wb_rst_i,         // synchronous active high reset
+  input                   [32-1:0] xip_wb_adr_i,         // lower address bits
+  input                   [32-1:0] xip_wb_dat_i,         // databus input
+  output                  [32-1:0] xip_wb_dat_o,         // databus output
+  input                      [3:0] xip_wb_sel_i,         // byte select inputs
+  input                            xip_wb_we_i,          // write enable input
+  input                            xip_wb_stb_i,         // stobe/core select signal
+  input                            xip_wb_cyc_i,         // valid bus cycle input
+  output                           xip_wb_ack_o,         // bus cycle acknowledge output
+  output                           xip_wb_err_o,         // termination w/ error
+  output                           xip_wb_int_o,         // interrupt request signal output
+
+  // SPI signals
+  output          [`SPI_SS_NB-1:0] xip_ss_pad_i,         
+  output                           xip_sclk_pad_i,       
+  output                           xip_mosi_pad_i,       
+  input                            xip_miso_pad_o,       
+/*--------------------------------------------------------------*/
+  output                            spi_wb_clk_o,       
+  output                            spi_wb_rst_o,         
+  output                      [4:0] spi_wb_adr_o,         
+  output                   [32-1:0] spi_wb_wdat_o,         
+  input                  [32-1:0]   spi_wb_rdat_i,         
+  output                      [3:0] spi_wb_sel_o,         
+  output                            spi_wb_we_o,          
+  output                            spi_wb_stb_o,         
+  output                            spi_wb_cyc_o,         
+  input                             spi_wb_ack_i,         
+  input                             spi_wb_err_i,         
+  input                             spi_wb_int_i,         
+
+  // SPI signals
+  input          [`SPI_SS_NB-1:0]   spi_ss_pad_i,         
+  input                             spi_sclk_pad_i,       
+  input                             spi_mosi_pad_i,       
+  output                            spi_miso_pad_o       
+);
+
+reg [4:0] xip_addr;
+reg [31:0] xip_wdata;
+reg xip_ack;
+reg xip_err;
+reg xip_int;
+reg [3:0] xip_strb;
+reg xip_enable;
+reg xip_write;
+reg xip_sel;
+reg [2:0] state;
+wire [31:0] xip_rdata;
+
+localparam IDLE               = 3'd0;
+localparam WRITE_TX_DATA      = 3'd1;
+localparam WRITE_SS_DATA      = 3'd2;
+localparam WRITE_DIVIDER_DATA = 3'd3;
+localparam WRITE_CTRL_DATA    = 3'd4;
+localparam READ_CTRL_DATA     = 3'd5;
+localparam READ_RX_DATA       = 3'd6;
+localparam WRITE_SS_RESET     = 3'd7;
+
+wire spi_active;
+wire xip_active;
+assign xip_active = (xip_wb_adr_i >= flash_addr_start && xip_wb_adr_i <= flash_addr_end);
+assign spi_active = (xip_wb_adr_i >= spi_addr_start && xip_wb_adr_i <= spi_addr_end);
+assign xip_rdata = {spi_wb_rdat_i[7:0], spi_wb_rdat_i[15:8], spi_wb_rdat_i[23:16], spi_wb_rdat_i[31:24]};
+
+/*-------XIP to SPI bridge----------*/
+assign spi_wb_clk_o  = xip_wb_clk_i;
+assign spi_wb_rst_o  = xip_wb_rst_i;
+assign spi_wb_adr_o  = spi_active ? xip_wb_adr_i[4:0] : xip_addr;
+assign spi_wb_wdat_o = spi_active ? xip_wb_dat_i : xip_wdata;
+
+assign spi_wb_sel_o  = spi_active ? xip_wb_sel_i : xip_strb;
+assign spi_wb_we_o   = spi_active ? xip_wb_we_i : xip_write;
+assign spi_wb_stb_o  = spi_active ? xip_wb_stb_i : xip_sel;
+assign spi_wb_cyc_o  = spi_active ? xip_wb_cyc_i : xip_enable;
+
+
+
+/*-------SPI to XIP bridge----------*/
+assign xip_wb_dat_o  = spi_active ? spi_wb_rdat_i : xip_rdata;
+assign xip_wb_ack_o  = spi_active ? spi_wb_ack_i : xip_ack;
+assign xip_wb_err_o  = spi_active ? spi_wb_err_i : xip_err;
+assign xip_wb_int_o  = spi_active ? spi_wb_int_i : xip_int;
+
+
+/*-------SPI signals----------*/
+assign xip_ss_pad_i   = spi_ss_pad_i;
+assign xip_sclk_pad_i = spi_sclk_pad_i;
+assign xip_mosi_pad_i = spi_mosi_pad_i;
+assign spi_miso_pad_o = xip_miso_pad_o;
+
+always @(posedge xip_wb_clk_i or posedge xip_wb_rst_i) begin
+    if(xip_wb_rst_i) begin
+        xip_addr <= 5'h0;
+        xip_wdata <= 32'h0;
+        xip_strb <= 4'h0;
+        xip_enable <= 1'b0;
+        xip_write <= 1'b0;
+        xip_sel <= 1'b0;
+        xip_ack <= 1'b0;
+        xip_err <= 1'b0;
+        xip_int <= 1'b0;
+        state <= IDLE;
+    end
+    else begin 
+        case(state)
+            IDLE: begin
+                xip_addr <= 5'h0;
+                xip_wdata <= 32'h0;
+                xip_strb <= 4'h0;
+                xip_enable <= 1'b0;
+                xip_write <= 1'b0;
+                xip_sel <= 1'b0;
+                xip_ack <= 1'b0;
+                xip_err <= 1'b0;
+                xip_int <= 1'b0;
+                if(xip_active && xip_wb_stb_i) begin
+                    xip_addr <= 5'h04; // TX1
+                    xip_wdata[31:24] <= 8'h03;
+                    xip_wdata[23:0] <= xip_wb_adr_i[23:0];
+                    state <= WRITE_TX_DATA;
+                    xip_strb <= 4'hf;
+                    xip_sel <= 1'b1;
+                    xip_write <= 1'b1;
+                end
+            end
+            WRITE_TX_DATA: begin
+                xip_enable <= 1'b1;
+                if(spi_wb_ack_i)begin
+                    xip_wdata <= 32'h01;
+                    xip_strb <= 4'hf;
+                    xip_addr <= 5'h18; // SS
+                    xip_enable <= 1'b0;
+                    xip_write <= 1'b1;
+                    xip_sel <= 1'b1;
+                    state <= WRITE_SS_DATA;
+                end
+            end
+            WRITE_SS_DATA: begin
+                xip_enable <= 1'b1;
+                if(spi_wb_ack_i)begin
+                    xip_wdata <= 32'h01;
+                    xip_strb <= 4'hf;
+                    xip_addr <= 5'h14; // DIVIDER
+                    xip_enable <= 1'b0;
+                    xip_write <= 1'b1;
+                    xip_sel <= 1'b1;
+                    state <= WRITE_DIVIDER_DATA;
+                end
+            end
+            WRITE_DIVIDER_DATA: begin
+                xip_enable <= 1'b1;
+                if(spi_wb_ack_i)begin
+                    xip_strb <= 4'hf;
+                    xip_wdata <= 32'h540; // tx_neg go charlen 
+                    xip_addr <= 5'h10; // CTRL
+                    xip_sel <= 1'b1;
+                    xip_enable <= 1'b0;
+                    xip_write <= 1'b1;
+                    state <= WRITE_CTRL_DATA;
+                end
+            end
+            WRITE_CTRL_DATA: begin
+                xip_enable <= 1'b1;
+                if(spi_wb_ack_i)begin
+                    xip_strb <= 4'h0;
+                    xip_addr <= 5'h10; // CTRL
+                    xip_sel <= 1'b1;
+                    xip_enable <= 1'b0;
+                    xip_write <= 1'b0;
+                    state <= READ_CTRL_DATA;
+                end
+            end
+            READ_CTRL_DATA: begin
+                xip_enable <= 1'b1;
+                if(spi_wb_ack_i)begin
+                    xip_enable <= 1'b0;
+                    if (spi_wb_rdat_i[8] == 1'b0) begin
+                        xip_strb <= 4'h0;
+                        xip_addr <= 5'h00; // RX0
+                        xip_sel <= 1'b1;
+                        xip_enable <= 1'b0;
+                        xip_write <= 1'b0;
+                        state <= READ_RX_DATA;
+                    end
+                end
+            end
+            READ_RX_DATA: begin
+                xip_enable <= 1'b1;
+                if(spi_wb_ack_i)begin
+                    xip_ack <= 1'b1;
+                    xip_addr <= 5'h18; // SS
+                    xip_wdata <= 32'h0;
+                    xip_strb <= 4'hf;
+                    xip_sel <= 1'b1;
+                    xip_write <= 1'b1;
+                    state <= WRITE_SS_RESET;
+                end
+            end
+            WRITE_SS_RESET: begin
+                xip_enable <= 1'b1;
+                xip_ack <= 1'b0;
+                if(spi_wb_ack_i)begin
+                    xip_strb <= 4'h0;
+                    xip_addr <= 5'h0;
+                    xip_sel <= 1'b0;
+                    xip_enable <= 1'b0;
+                    xip_write <= 1'b0;
+                    state <= IDLE;
+                end
+            end
+            default: begin
+                state <= IDLE;
+                xip_addr <= 5'h0;
+                xip_wdata <= 32'h0;
+                xip_strb <= 4'h0;
+                xip_enable <= 1'b0;
+                xip_write <= 1'b0;
+                xip_sel <= 1'b0;
+                xip_ack <= 1'b0;
+                xip_err <= 1'b0;
+                xip_int <= 1'b0;
+            end
+        endcase
+    end
+end
+
+endmodule 
