+    end
+  end
+
+  assign waddress = {Row_address[write_bank], Col_address[8:0]}; 
+
+  always @(posedge clk) begin
+      if (cke == 1'b1 && write_en) begin
+        `ifdef SDRAM_MTRACE
+        if (dqm_buffer != 2'b11)
