---
 src/device/GPIO.scala | 79 +++++++++++++++++++++++++++++++++++--------
 1 file changed, 65 insertions(+), 14 deletions(-)

diff --git a/src/device/GPIO.scala b/src/device/GPIO.scala
index f770e96a..de3ae38b 100644
--- a/src/device/GPIO.scala
+++ b/src/device/GPIO.scala
@@ -10,15 +10,15 @@ import freechips.rocketchip.util._
 
 class GPIOIO extends Bundle {
   val out = Output(UInt(16.W))
-  val in = Input(UInt(16.W))
+  val in  = Input(UInt(16.W))
   val seg = Output(Vec(8, UInt(8.W)))
 }
 
 class GPIOCtrlIO extends Bundle {
   val clock = Input(Clock())
   val reset = Input(Reset())
-  val in = Flipped(new APBBundle(APBBundleParameters(addrBits = 32, dataBits = 32)))
-  val gpio = new GPIOIO
+  val in    = Flipped(new APBBundle(APBBundleParameters(addrBits = 32, dataBits = 32)))
+  val gpio  = new GPIOIO
 }
 
 class gpio_top_apb extends BlackBox {
@@ -26,24 +26,75 @@ class gpio_top_apb extends BlackBox {
 }
 
 class gpioChisel extends Module {
-  val io = IO(new GPIOCtrlIO)
+  val io        = IO(new GPIOCtrlIO)
+  //  000
+  // 5   1
+  //  666
+  // 4   2
+  //  333 7
+  val segTable  = VecInit(
+    Seq(
+      "b00000011".U(8.W), // 0
+      "b10011111".U(8.W), // 1
+      "b00100101".U(8.W), // 2
+      "b00001101".U(8.W), // 3
+      "b10011001".U(8.W), // 4
+      "b01001001".U(8.W), // 5
+      "b01000001".U(8.W), // 6
+      "b00011111".U(8.W), // 7
+      "b00000001".U(8.W), // 8
+      "b00011001".U(8.W), // 9
+      "b00010000".U(8.W), // A
+      "b00000000".U(8.W), // b
+      "b01100010".U(8.W), // C
+      "b00000010".U(8.W), // d
+      "b01100000".U(8.W), // E
+      "b01110000".U(8.W)  // F
+    )
+  )
+  val ledReg    = RegInit(0.U(16.W))
+  val segRawReg = RegInit(0.U(32.W))
+  val offset    = io.in.paddr(3, 0)
+
+  when(io.in.psel && io.in.penable && io.in.pwrite) {
+    switch(offset) {
+      is("h0".U) { ledReg := io.in.pwdata(15, 0) }
+      is("h8".U) { segRawReg := io.in.pwdata }
+    }
+  }
+
+  io.in.prdata := 0.U
+  when(io.in.psel && io.in.penable && !io.in.pwrite) {
+    switch(offset) {
+      is("h0".U) { io.in.prdata := ledReg }
+      is("h4".U) { io.in.prdata := io.gpio.in }
+      is("h8".U) { io.in.prdata := segRawReg }
+    }
+  }
+
+  io.in.pready  := true.B
+  io.in.pslverr := false.B
+
+  io.gpio.out := ledReg
+  val segDigits = segRawReg.asTypeOf(Vec(8, UInt(4.W)))
+  for (i <- 0 until 8) {
+    io.gpio.seg(i) := segTable(segDigits(i))
+  }
 }
 
-class APBGPIO(address: Seq[AddressSet])(implicit p: Parameters) extends LazyModule {
-  val node = APBSlaveNode(Seq(APBSlavePortParameters(
-    Seq(APBSlaveParameters(
-      address       = address,
-      executable    = true,
-      supportsRead  = true,
-      supportsWrite = true)),
-    beatBytes  = 4)))
+class APBGPIO(
+  address:    Seq[AddressSet]
+)(
+  implicit p: Parameters)
+    extends LazyModule {
+  val node = APBSlaveNode(Seq(APBSlavePortParameters(Seq(APBSlaveParameters(address = address, executable = true, supportsRead = true, supportsWrite = true)), beatBytes = 4)))
 
   lazy val module = new Impl
   class Impl extends LazyModuleImp(this) {
-    val (in, _) = node.in(0)
+    val (in, _)     = node.in(0)
     val gpio_bundle = IO(new GPIOIO)
 
-    val mgpio = Module(new gpio_top_apb)
+    val mgpio = Module(new gpioChisel)
     mgpio.io.clock := clock
     mgpio.io.reset := reset
     mgpio.io.in <> in
