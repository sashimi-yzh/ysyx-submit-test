+  // ============================================================
+
+  localparam [3:0] X_IDLE      = 4'd0;
+  localparam [3:0] X_WR_TX0    = 4'd1;
+  localparam [3:0] X_WR_TX1    = 4'd2;
+  localparam [3:0] X_WR_DIV    = 4'd3;
+  localparam [3:0] X_WR_SS     = 4'd4;
+  localparam [3:0] X_WR_CTRL0  = 4'd5;
+  localparam [3:0] X_WR_CTRL1  = 4'd6;
+  localparam [3:0] X_POLL      = 4'd7;
+  localparam [3:0] X_RD_RX0    = 4'd8;
+  localparam [3:0] X_RESP      = 4'd9;
+  localparam [3:0] X_ERR       = 4'd10;
+
+  reg [3:0]  x_state;
+  reg [31:0] x_addr;
+  reg [31:0] x_rdata;
+
+  wire x_busy = (x_state != X_IDLE);
+
+  // flash 读请求：APB setup 阶段锁存地址
+  wire xip_read_start =
+      apb_setup &&
+      is_flash_addr &&
+      !in_pwrite &&
+      (x_state == X_IDLE);
+
+  // XIP 目前不支持写 flash
+  wire xip_write_start =
+      apb_setup &&
+      is_flash_addr &&
+      in_pwrite &&
+      (x_state == X_IDLE);
+
+  function [31:0] bswap32;
+    input [31:0] x;
+    begin
+      bswap32 = {x[7:0], x[15:8], x[23:16], x[31:24]};
+    end
+  endfunction
+
+  // ============================================================
+  // Internal Wishbone signals to spi_top
+  // ============================================================
+
+  reg        x_wb_cyc;
+  reg        x_wb_stb;
+  reg        x_wb_we;
+  reg [4:0]  x_wb_adr;
+  reg [31:0] x_wb_dat;
+  reg [3:0]  x_wb_sel;
+
+  wire [4:0]  spi_wb_adr;
+  wire [31:0] spi_wb_dat_i;
+  wire [31:0] spi_wb_dat_o;
+  wire [3:0]  spi_wb_sel;
+  wire        spi_wb_we;
+  wire        spi_wb_stb;
+  wire        spi_wb_cyc;
+  wire        spi_wb_ack;
+  wire        spi_wb_err;
+
+  // 普通 SPI register 访问：保持你原来的 APB->WB 转发方式
+  wire normal_spi_access = in_psel && !is_flash_addr && (x_state == X_IDLE);
+
+  assign spi_wb_adr   = x_busy ? x_wb_adr   : in_paddr[4:0];
+  assign spi_wb_dat_i = x_busy ? x_wb_dat   : in_pwdata;
+  assign spi_wb_sel   = x_busy ? x_wb_sel   : in_pstrb;
+  assign spi_wb_we    = x_busy ? x_wb_we    : in_pwrite;
+  assign spi_wb_stb   = x_busy ? x_wb_stb   : (normal_spi_access ? in_psel    : 1'b0);
+  assign spi_wb_cyc   = x_busy ? x_wb_cyc   : (normal_spi_access ? in_penable : 1'b0);
+
+  // ============================================================
+  // Generate internal WB operation according to XIP state
+  // ============================================================
+
+  always @(*) begin
+    x_wb_cyc = 1'b0;
+    x_wb_stb = 1'b0;
+    x_wb_we  = 1'b0;
+    x_wb_adr = 5'h00;
+    x_wb_dat = 32'h00000000;
+    x_wb_sel = 4'hf;
+
+    case (x_state)
+      X_WR_TX0: begin
+        x_wb_cyc = 1'b1;
+        x_wb_stb = 1'b1;
+        x_wb_we  = 1'b1;
+        x_wb_adr = SPI_REG_TX0;
+        x_wb_dat = 32'h00000000;
+      end
+
+      X_WR_TX1: begin
+        x_wb_cyc = 1'b1;
+        x_wb_stb = 1'b1;
+        x_wb_we  = 1'b1;
+        x_wb_adr = SPI_REG_TX1;
+
+        // SPI flash read command:
+        // 8'h03 + 24-bit byte address
+        x_wb_dat = {8'h03, x_addr[23:2], 2'b00};
+      end
+
+      X_WR_DIV: begin
+        x_wb_cyc = 1'b1;
+        x_wb_stb = 1'b1;
+        x_wb_we  = 1'b1;
+        x_wb_adr = SPI_REG_DIVIDER;
+        x_wb_dat = 32'h00000000;
+      end
+
+      X_WR_SS: begin
+        x_wb_cyc = 1'b1;
+        x_wb_stb = 1'b1;
+        x_wb_we  = 1'b1;
+        x_wb_adr = SPI_REG_SS;
+
+        // flash 是 slave 0
+        x_wb_dat = 32'h00000001;
+      end
+
+      X_WR_CTRL0: begin
+        x_wb_cyc = 1'b1;
+        x_wb_stb = 1'b1;
+        x_wb_we  = 1'b1;
+        x_wb_adr = SPI_REG_CTRL;
+
+        // 先写配置，不启动
+        x_wb_dat = XIP_CTRL_CFG;
+      end
+
+      X_WR_CTRL1: begin
+        x_wb_cyc = 1'b1;
+        x_wb_stb = 1'b1;
+        x_wb_we  = 1'b1;
+        x_wb_adr = SPI_REG_CTRL;
+
+        // 再写 GO，启动传输
+        x_wb_dat = XIP_CTRL_GO;
+      end
+
+      X_POLL: begin
+        x_wb_cyc = 1'b1;
+        x_wb_stb = 1'b1;
+        x_wb_we  = 1'b0;
+        x_wb_adr = SPI_REG_CTRL;
+        x_wb_dat = 32'h00000000;
+      end
+
+      X_RD_RX0: begin
+        x_wb_cyc = 1'b1;
+        x_wb_stb = 1'b1;
+        x_wb_we  = 1'b0;
+        x_wb_adr = SPI_REG_RX0;
+        x_wb_dat = 32'h00000000;
+      end
+
+      default: begin
+        x_wb_cyc = 1'b0;
+        x_wb_stb = 1'b0;
+        x_wb_we  = 1'b0;
+        x_wb_adr = 5'h00;
+        x_wb_dat = 32'h00000000;
+        x_wb_sel = 4'hf;
+      end
+    endcase
+  end
+
+  // ============================================================
+  // XIP state transition
+  // ============================================================
+
+  always @(posedge clock or posedge reset) begin
+    if (reset) begin
+      x_state <= X_IDLE;
+      x_addr  <= 32'h00000000;
+      x_rdata <= 32'h00000000;
+    end else begin
+      case (x_state)
+        X_IDLE: begin
+          if (xip_write_start) begin
+            x_state <= X_ERR;
+          end else if (xip_read_start) begin
+            x_addr  <= {in_paddr[31:2], 2'b00};
+            x_state <= X_WR_TX0;
+          end
+        end
+
+        X_WR_TX0: begin
+          if (spi_wb_ack) x_state <= X_WR_TX1;
+        end
+
+        X_WR_TX1: begin
+          if (spi_wb_ack) x_state <= X_WR_DIV;
+        end
+
+        X_WR_DIV: begin
+          if (spi_wb_ack) x_state <= X_WR_SS;
+        end
+
+        X_WR_SS: begin
+          if (spi_wb_ack) x_state <= X_WR_CTRL0;
+        end
+
+        X_WR_CTRL0: begin
+          if (spi_wb_ack) x_state <= X_WR_CTRL1;
+        end
+
+        X_WR_CTRL1: begin
+          if (spi_wb_ack) x_state <= X_POLL;
+        end
+
+        X_POLL: begin
+          if (spi_wb_ack) begin
+            if (spi_wb_dat_o[8] == 1'b0)
+              x_state <= X_RD_RX0;
+            else
+              x_state <= X_POLL;
+          end
+        end
+
+        X_RD_RX0: begin
+          if (spi_wb_ack) begin
+            // 和软件 flash_read_word() 一样，再做一次 bswap
+            x_rdata <= bswap32(spi_wb_dat_o);
+            x_state <= X_RESP;
+          end
+        end
+
+        X_RESP: begin
+          if (apb_enable) begin
+            x_state <= X_IDLE;
+          end
+        end
+
+        X_ERR: begin
+          if (apb_enable) begin
+            x_state <= X_IDLE;
+          end
+        end
+
+        default: begin
+          x_state <= X_IDLE;
+        end
+      endcase
+    end
+  end
+
+  // ============================================================
+  // APB response
+  // ============================================================
+
+  assign in_pready =
+      is_flash_addr ? (
+        ((x_state == X_RESP) && apb_enable) ||
+        ((x_state == X_ERR ) && apb_enable)
+      ) : spi_wb_ack;
+
+  assign in_prdata =
+      is_flash_addr ? x_rdata : spi_wb_dat_o;
+
+  assign in_pslverr =
+      is_flash_addr ? (x_state == X_ERR) : spi_wb_err;
+
+  // ============================================================
+  // Original SPI master
+  // ============================================================
+
+  spi_top u0_spi_top (
+    .wb_clk_i(clock),
+    .wb_rst_i(reset),
+    .wb_adr_i(spi_wb_adr),
+    .wb_dat_i(spi_wb_dat_i),
+    .wb_dat_o(spi_wb_dat_o),
+    .wb_sel_i(spi_wb_sel),
+    .wb_we_i (spi_wb_we),
+    .wb_stb_i(spi_wb_stb),
+    .wb_cyc_i(spi_wb_cyc),
+    .wb_ack_o(spi_wb_ack),
+    .wb_err_o(spi_wb_err),
+    .wb_int_o(spi_irq_out),
+
+    .ss_pad_o(spi_ss),
+    .sclk_pad_o(spi_sck),
+    .mosi_pad_o(spi_mosi),
+    .miso_pad_i(spi_miso)
+  );
 
 `endif // FAST_FLASH
 
