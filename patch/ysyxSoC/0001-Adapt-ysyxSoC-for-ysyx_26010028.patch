+localparam [18:0] VGA_PIXELS_19 = VGA_PIXELS[18:0];
+reg [31:0] fb [0:VGA_PIXELS-1];
+integer i;
+initial begin
+    for(i=0;i<VGA_PIXELS;i=i+1)begin
+        fb[i]=32'b0;
+    end
+end
+assign in_pready = 1'b1;
+assign in_pslverr = 1'b0;
+wire apb_read = in_psel && in_penable && !in_pwrite;
+wire apb_write = in_psel && in_penable && in_pwrite;
+wire [18:0] cpu_pix_idx = in_paddr[20:2];
+wire cpu_pix_valid = (cpu_pix_idx < VGA_PIXELS_19);
+assign in_prdata = (apb_read && cpu_pix_valid) ? fb[cpu_pix_idx] : 32'b0;
+
+always@(posedge clock)begin
+	if(!reset)begin
+		if(apb_write && cpu_pix_valid)begin
+			if(in_pstrb[0]) fb[cpu_pix_idx][7:0] <= in_pwdata[7:0];
+			if(in_pstrb[1]) fb[cpu_pix_idx][15:8] <= in_pwdata[15:8];
+			if(in_pstrb[2]) fb[cpu_pix_idx][23:16] <= in_pwdata[23:16];
+			if(in_pstrb[3]) fb[cpu_pix_idx][31:24] <= in_pwdata[31:24];
+		end
+	end
+end
+
+localparam W_VISIBLE = 640;
+localparam W_FRONT = 16;
+localparam W_SYNC = 96;
+localparam W_BACK = 48;
+localparam W_TOTAL = W_VISIBLE + W_FRONT + W_BACK + W_SYNC;
+
+localparam H_VISIBLE = 480;
+localparam H_FRONT = 10;
+localparam H_SYNC = 2;
+localparam H_BACK =33;
+localparam H_TOTAL = H_VISIBLE + H_FRONT + H_BACK + H_SYNC;
+
+reg [9:0] w_cnt;
+reg [9:0] h_cnt;
+
+always@(posedge clock)begin
+	if(reset)begin
+		w_cnt <= 10'd0;
+	    h_cnt <= 10'd0;
+	end
+	else begin
+		if(w_cnt == W_TOTAL - 1)begin
+			w_cnt <= 10'd0;
+    		if(h_cnt == H_TOTAL -1 )begin
+    			h_cnt <= 10'd0;
+    		end
+            else begin
