+assign vga_r = visiable_area ? scan_pixel[23:16] : 8'b0;
+assign vga_g = visiable_area ? scan_pixel[15:8] : 8'b0;
+assign vga_b = visiable_area ? scan_pixel[7:0] : 8'b0;
+assign vga_hsync = ~((w_cnt >= W_VISIBLE + W_FRONT) && (w_cnt < W_VISIBLE + W_FRONT + W_SYNC));
+assign vga_vsync = ~((h_cnt >= H_VISIBLE + H_FRONT) && (h_cnt < H_VISIBLE + H_FRONT + H_SYNC));
 endmodule
