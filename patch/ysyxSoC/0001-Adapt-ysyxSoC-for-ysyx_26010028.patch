+            cmd_shift <= {cmd_shift[6:0], dio_in[0]};
+
+            if (cmd_cnt == 4'd7) begin
+              cmd_cnt <= 4'd0;
+
+              case ({cmd_shift[6:0], dio_in[0]})
+                CMD_ENTER_QPI: begin
+                  qpi_mode <= 1'b1;
+                  state    <= S_IGNORE;
+                end
+
+                CMD_QUAD_READ: begin
+                  state <= S_ADDR;
+                end
+
+                CMD_QUAD_WRITE: begin
+                  state <= S_ADDR;
+                end
+
+                default: begin
+                  state <= S_IGNORE;
+                end
+              endcase
+            end else begin
+              cmd_cnt <= cmd_cnt + 4'd1;
+            end
+          end else begin
+            // QPI Mode command receive: 2 cycles, 4 bits each.
+            cmd_shift <= {cmd_shift[3:0], dio_in};
+
+            if (cmd_cnt == 4'd1) begin
+              cmd_cnt <= 4'd0;
+
+              case ({cmd_shift[3:0], dio_in})
+                CMD_EXIT_QPI: begin
+                  qpi_mode <= 1'b0;
+                  state    <= S_IGNORE;
+                end
+
+                CMD_QUAD_READ: begin
+                  state <= S_ADDR;
+                end
+
+                CMD_QUAD_WRITE: begin
+                  state <= S_ADDR;
+                end
+
+                default: begin
+                  state <= S_IGNORE;
+                end
+              endcase
+            end else begin
+              cmd_cnt <= cmd_cnt + 4'd1;
+            end
+          end
+        end
+
+        // ------------------------------------------------------
+        // Address phase
+        //
+        // Both SPI-Mode Quad I/O and QPI use 4-bit address phase.
+        // 24-bit address = 6 cycles.
+        // ------------------------------------------------------
+        S_ADDR: begin
+          addr_shift <= {addr_shift[19:0], dio_in};
+
+          if (addr_cnt == 3'd5) begin
+            addr_cnt <= 3'd0;
+            addr     <= {addr_shift[19:0], dio_in};
+
+            if (cmd_shift == CMD_QUAD_READ) begin
+              state     <= S_DUMMY;
+              dummy_cnt <= 4'd0;
+              byte_half <= 1'b0;
+            end else if (cmd_shift == CMD_QUAD_WRITE) begin
+              state     <= S_WRITE;
+              byte_half <= 1'b0;
+            end else begin
+              state <= S_IGNORE;
+            end
+          end else begin
+            addr_cnt <= addr_cnt + 3'd1;
+          end
+        end
+
+        // ------------------------------------------------------
+        // Dummy cycles before read data.
+        // ------------------------------------------------------
+        S_DUMMY: begin
+          if (dummy_cnt == READ_DUMMY_CYCLES - 1) begin
+            state     <= S_READ;
+            byte_half <= 1'b0;
+          end else begin
+            dummy_cnt <= dummy_cnt + 4'd1;
+          end
+        end
+
+        // ------------------------------------------------------
+        // Read data phase.
+        //
+        // PSRAM output is prepared at negedge sck.
+        // Controller samples at posedge sck.
+        // Here we only advance nibble/addr after sampling.
+        // ------------------------------------------------------
+        S_READ: begin
+          if (byte_half == 1'b0) begin
+            byte_half <= 1'b1;
+          end else begin
+            byte_half <= 1'b0;
+            addr      <= addr + 24'd1;
+          end
+        end
+
+        // ------------------------------------------------------
+        // Write data phase.
+        //
+        // Two 4-bit nibbles form one byte:
+        //   first nibble  -> high 4 bits
+        //   second nibble -> low 4 bits
+        // ------------------------------------------------------
+        S_WRITE: begin
+          if (byte_half == 1'b0) begin
+            write_byte[7:4] <= dio_in;
+            byte_half       <= 1'b1;
+          end else begin
+            write_byte[3:0] <= dio_in;
+            mem[addr[21:0]] <= {write_byte[7:4], dio_in};
+            addr            <= addr + 24'd1;
+            byte_half       <= 1'b0;
+          end
+        end
+
+        // ------------------------------------------------------
+        // Unsupported command.
+        // Wait until ce_n rises.
+        // ------------------------------------------------------
+        S_IGNORE: begin
+          state <= S_IGNORE;
+        end
+
+        default: begin
+          state <= S_CMD;
+        end
+
+      endcase
+    end
+  end
+
+  // ============================================================
+  // Output data
+  //
+  // During read data phase, PSRAM drives dio[3:0].
+  // In all other phases, PSRAM releases dio[3:0].
+  // ============================================================
+  always @(negedge sck or posedge ce_n) begin
+    if (ce_n) begin
+      dio_oe  <= 1'b0;
+      dio_out <= 4'h0;
+    end else begin
+      if (state == S_READ) begin
+        dio_oe <= 1'b1;
+
+        if (byte_half == 1'b0) begin
+          dio_out <= mem[addr[21:0]][7:4];
+        end else begin
+          dio_out <= mem[addr[21:0]][3:0];
+        end
+      end else begin
+        dio_oe  <= 1'b0;
+        dio_out <= 4'h0;
+      end
+    end
+  end
 
 endmodule
