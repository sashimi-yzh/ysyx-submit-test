diff --git a/perip/psram/psram.v b/perip/psram/psram.v
index d9bdd882..326c8acd 100644
--- a/perip/psram/psram.v
+++ b/perip/psram/psram.v
@@ -4,6 +4,317 @@ module psram(
   inout [3:0] dio
 );
 
-  assign dio = 4'bz;
+  // ============================================================
+  // 4MB PSRAM storage
+  // ============================================================
+  localparam MEM_SIZE = 4 * 1024 * 1024;
+
+  reg [7:0] mem [0:MEM_SIZE-1];
+
+  // ============================================================
+  // Commands
+  // ============================================================
+  localparam CMD_QUAD_READ  = 8'hEB;
+  localparam CMD_QUAD_WRITE = 8'h38;
+
+  /*
+   * 常见 PSRAM QPI 命令：
+   *   35h: Enter QPI
+   *   F5h: Exit QPI
+   *
+   * 如果你的手册写的 Enter QPI 不是 35h，就把这里改成手册值。
+   */
+  localparam CMD_ENTER_QPI  = 8'h35;
+  localparam CMD_EXIT_QPI   = 8'hF5;
+
+  /*
+   * 当前控制器：
+   *   QPI Read:
+   *     command 2 cycles
+   *     address 6 cycles
+   *     dummy   6 cycles
+   *     data
+   *
+   * SPI-Mode Quad I/O Read 也继续使用 6 个 dummy cycles。
+   */
+  localparam READ_DUMMY_CYCLES = 6;
+
+  // ============================================================
+  // Tri-state dio
+  // ============================================================
+  reg  [3:0] dio_out;
+  reg        dio_oe;
+
+  assign dio = dio_oe ? dio_out : 4'bzzzz;
+
+  wire [3:0] dio_in = dio;
+
+  // ============================================================
+  // QPI mode flag
+  //
+  // Power-on default:
+  //   SPI Mode
+  //
+  // After receiving 35h in SPI Mode:
+  //   QPI Mode
+  // ============================================================
+  reg qpi_mode;
+
+  // ============================================================
+  // State machine
+  // ============================================================
+  localparam S_CMD    = 3'd0;
+  localparam S_ADDR   = 3'd1;
+  localparam S_DUMMY  = 3'd2;
+  localparam S_READ   = 3'd3;
+  localparam S_WRITE  = 3'd4;
+  localparam S_IGNORE = 3'd5;
+
+  reg [2:0]  state;
+
+  reg [7:0]  cmd_shift;
+  reg [3:0]  cmd_cnt;
+
+  reg [23:0] addr_shift;
+  reg [2:0]  addr_cnt;
+  reg [23:0] addr;
+
+  reg [3:0]  dummy_cnt;
+
+  reg [7:0]  write_byte;
+  reg        byte_half;
+
+  integer i;
+
+  initial begin
+    state      = S_CMD;
+    cmd_shift  = 8'h00;
+    cmd_cnt    = 4'd0;
+
+    addr_shift = 24'h0;
+    addr_cnt   = 3'd0;
+    addr       = 24'h0;
+
+    dummy_cnt  = 4'd0;
+
+    write_byte = 8'h00;
+    byte_half  = 1'b0;
+
+    dio_out    = 4'h0;
+    dio_oe     = 1'b0;
+
+    qpi_mode   = 1'b0;
