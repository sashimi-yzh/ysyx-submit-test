-/*
-    QSPI PSRAM Controller
-
-    Pseudostatic RAM (PSRAM) is DRAM combined with a self-refresh circuit.
-    It appears externally as slower SRAM, albeit with a density/cost advantage
-    over true SRAM, and without the access complexity of DRAM.
-
-    The controller was designed after https://www.issi.com/WW/pdf/66-67WVS4M8ALL-BLL.pdf
-    utilizing both EBh and 38h commands for reading and writting.
-
-    Benchmark data collected using CM0 CPU when memory is PSRAM only
-
-        Benchmark       PSRAM (us)  1-cycle SRAM (us)   Slow-down
-        ---------       ----------  -----------------   ---------
-        xtea            840         212                 3.94
-        stress          1607        446                 3.6
-        hash            5340        1281                4.16
-        chacha          2814        320                 8.8
-        aes sbox        2370        322                 7.3
-        nqueens         3496        459                 7.6
-        mtrans          2171        2034                1.06
-        rle             903         155                 5.8
-        prime           549         97                  5.66
+	Licensed under the Apache License, Version 2.0
 */
 
 `timescale              1ns/1ps
 `default_nettype        none
 
+// ============================================================
+// QPI PSRAM Reader
+//
+// QPI Read transaction:
+//
+//   counter 0~1   : command EBh, 4-bit per cycle
+//   counter 2~7   : 24-bit address, 4-bit per cycle
+//   counter 8~13  : dummy cycles
+//   counter 14... : read data, 4-bit per cycle
+//
+// Compared with original SPI-Mode Quad I/O:
+//   command phase: 8 cycles -> 2 cycles
+// ============================================================
 module PSRAM_READER (
     input   wire            clk,
     input   wire            rst_n,
@@ -60,93 +41,165 @@ module PSRAM_READER (
     localparam  IDLE = 1'b0,
                 READ = 1'b1;
 
-    wire [7:0]  FINAL_COUNT = 19 + size*2; // was 27: Always read 1 word
-
-    reg         state, nstate;
-    reg [7:0]   counter;
-    reg [23:0]  saddr;
-    reg [7:0]   data [3:0];
-
-    wire[7:0]   CMD_EBH = 8'heb;
-
-    always @*
+    /*
+     * For QPI read:
+     *   command: 2 cycles
+     *   address: 6 cycles
+     *   dummy  : 6 cycles
+     *   data   : size * 2 cycles
+     *
+     * Data starts at counter == 14.
+     * Last data nibble is at counter == 13 + size * 2.
+     */
+    wire [7:0] FINAL_COUNT = 8'd13 + size * 8'd2;
+
+    reg        state;
+    reg        nstate;
+    reg [7:0]  counter;
+    reg [23:0] saddr;
+    reg [7:0]  data [3:0];
+
+    wire [7:0] CMD_EBH = 8'heb;
+
+    always @* begin
         case (state)
-            IDLE: if(rd) nstate = READ; else nstate = IDLE;
-            READ: if(done) nstate = IDLE; else nstate = READ;
+            IDLE: begin
+                if (rd)
+                    nstate = READ;
+                else
+                    nstate = IDLE;
+            end
+
+            READ: begin
+                if (done)
+                    nstate = IDLE;
+                else
+                    nstate = READ;
+            end
+
+            default: begin
+                nstate = IDLE;
+            end
         endcase
+    end
 
-    always @ (posedge clk or negedge rst_n)
-        if(!rst_n) state <= IDLE;
-        else state <= nstate;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n)
+            state <= IDLE;
+        else
+            state <= nstate;
+    end
 
-    // Drive the Serial Clock (sck) @ clk/2
-    always @ (posedge clk or negedge rst_n)
-        if(!rst_n)
+    // Drive serial clock: sck = clk / 2 while ce_n is low.
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n)
             sck <= 1'b0;
-        else if(~ce_n)
-            sck <= ~ sck;
-        else if(state == IDLE)
+        else if (~ce_n)
+            sck <= ~sck;
+        else if (state == IDLE)
             sck <= 1'b0;
+    end
 
-    // ce_n logic
-    always @ (posedge clk or negedge rst_n)
-        if(!rst_n)
+    // Chip enable.
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n)
             ce_n <= 1'b1;
-        else if(state == READ)
+        else if (state == READ)
             ce_n <= 1'b0;
         else
             ce_n <= 1'b1;
+    end
 
-    always @ (posedge clk or negedge rst_n)
