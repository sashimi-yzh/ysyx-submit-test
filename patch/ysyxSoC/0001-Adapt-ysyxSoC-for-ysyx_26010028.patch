+  assign dq = dq_oe ? dq_out : 16'hzzzz;
+
+  /* READ burst 状态。 */
+  reg        read_active;
+  reg [ 2:0] read_wait;
+  reg [ 1:0] read_bank;
+  reg [12:0] read_row;
+  reg [ 8:0] read_col;
+  reg [ 3:0] read_length;
+  reg [ 3:0] read_index;
+
+  /* WRITE 命令当拍写入第 0 beat，后续 beat 由这里记录。 */
