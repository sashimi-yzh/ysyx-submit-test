+      mem[i] = 8'h00;
+    end
+  end
+
+  // ============================================================
+  // Input sampling
+  //
+  // Controller changes dout around sck falling edge,
+  // PSRAM samples input at sck rising edge.
+  // ============================================================
+  always @(posedge sck or posedge ce_n) begin
+    if (ce_n) begin
+      state      <= S_CMD;
+      cmd_shift  <= 8'h00;
+      cmd_cnt    <= 4'd0;
+
+      addr_shift <= 24'h0;
+      addr_cnt   <= 3'd0;
+
+      dummy_cnt  <= 4'd0;
+      byte_half  <= 1'b0;
+    end else begin
+      case (state)
+
+        // ------------------------------------------------------
+        // Command phase
+        //
+        // SPI Mode:
+        //   command is transferred on dio[0], 1 bit per cycle.
+        //
+        // QPI Mode:
+        //   command is transferred on dio[3:0], 4 bits per cycle.
