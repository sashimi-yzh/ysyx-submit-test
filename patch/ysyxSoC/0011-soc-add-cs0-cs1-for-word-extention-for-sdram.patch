From 23c08c0fcdf4946e0c89e74831877571ebd4d974 Mon Sep 17 00:00:00 2001
From: "Wang, Yuan" <hallo_sun@hotmail.com>
Date: Tue, 10 Feb 2026 22:47:39 +0800
Subject: [PATCH 11/40] [soc] add cs0/cs1 for word extention for sdram

Signed-off-by: Wang, Yuan <hallo_sun@hotmail.com>
---
 perip/sdram/core_sdram_axi4/sdram_axi.v      | 6 ++++--
 perip/sdram/core_sdram_axi4/sdram_axi_core.v | 6 ++++--
 perip/sdram/sdram_top_apb.v                  | 6 ++++--
 perip/sdram/sdram_top_axi.v                  | 6 ++++--
 4 files changed, 16 insertions(+), 8 deletions(-)

diff --git a/perip/sdram/core_sdram_axi4/sdram_axi.v b/perip/sdram/core_sdram_axi4/sdram_axi.v
index 64641f58..cd42e94f 100644
--- a/perip/sdram/core_sdram_axi4/sdram_axi.v
+++ b/perip/sdram/core_sdram_axi4/sdram_axi.v
@@ -69,7 +69,8 @@ module sdram_axi
     ,output          inport_rlast_o
     ,output          sdram_clk_o
     ,output          sdram_cke_o
-    ,output          sdram_cs_o
+    ,output          sdram_cs0_o
+    ,output          sdram_cs1_o
     ,output          sdram_ras_o
     ,output          sdram_cas_o
     ,output          sdram_we_o
@@ -177,7 +178,8 @@ u_core
 
     ,.sdram_clk_o(sdram_clk_o)
     ,.sdram_cke_o(sdram_cke_o)
-    ,.sdram_cs_o(sdram_cs_o)
+    ,.sdram_cs0_o(sdram_cs0_o)
+    ,.sdram_cs1_o(sdram_cs1_o)
     ,.sdram_ras_o(sdram_ras_o)
     ,.sdram_cas_o(sdram_cas_o)
     ,.sdram_we_o(sdram_we_o)
diff --git a/perip/sdram/core_sdram_axi4/sdram_axi_core.v b/perip/sdram/core_sdram_axi4/sdram_axi_core.v
index cc339b54..3691eee8 100644
--- a/perip/sdram/core_sdram_axi4/sdram_axi_core.v
+++ b/perip/sdram/core_sdram_axi4/sdram_axi_core.v
@@ -51,7 +51,8 @@ module sdram_axi_core
     ,output [ 31:0]  inport_read_data_o
     ,output          sdram_clk_o
     ,output          sdram_cke_o
-    ,output          sdram_cs_o
+    ,output          sdram_cs0_o
+    ,output          sdram_cs1_o
     ,output          sdram_ras_o
     ,output          sdram_cas_o
     ,output          sdram_we_o
@@ -764,7 +765,8 @@ assign sdram_data_output_o   =  data_q;
 assign sdram_data_in_w       = sdram_data_input_i;
 
 assign sdram_cke_o  = cke_q;
-assign sdram_cs_o   = command_q[3];
+assign sdram_cs0_o  = command_q[3] & ram_addr_w[SDRAM_ADDR_W + 1];
+assign sdram_cs1_o  = command_q[3] & !ram_addr_w[SDRAM_ADDR_W + 1];
 assign sdram_ras_o  = command_q[2];
 assign sdram_cas_o  = command_q[1];
 assign sdram_we_o   = command_q[0];
diff --git a/perip/sdram/sdram_top_apb.v b/perip/sdram/sdram_top_apb.v
index f127d714..8f33d42e 100644
--- a/perip/sdram/sdram_top_apb.v
+++ b/perip/sdram/sdram_top_apb.v
@@ -14,7 +14,8 @@ module sdram_top_apb (
 
   output        sdram_clk,
   output        sdram_cke,
-  output        sdram_cs,
+  output        sdram_cs0,
+  output        sdram_cs1,
   output        sdram_ras,
   output        sdram_cas,
   output        sdram_we,
@@ -65,7 +66,8 @@ module sdram_top_apb (
 
     .sdram_clk_o(sdram_clk),
     .sdram_cke_o(sdram_cke),
-    .sdram_cs_o(sdram_cs),
+    .sdram_cs0_o(sdram_cs0),
+    .sdram_cs1_o(sdram_cs1),
     .sdram_ras_o(sdram_ras),
     .sdram_cas_o(sdram_cas),
     .sdram_we_o(sdram_we),
diff --git a/perip/sdram/sdram_top_axi.v b/perip/sdram/sdram_top_axi.v
index f0fd6fdb..0cb24f74 100644
--- a/perip/sdram/sdram_top_axi.v
+++ b/perip/sdram/sdram_top_axi.v
@@ -33,7 +33,8 @@ module sdram_top_axi(
 
   output        sdram_clk,
   output        sdram_cke,
-  output        sdram_cs,
+  output        sdram_cs0,
+  output        sdram_cs1,
   output        sdram_ras,
   output        sdram_cas,
   output        sdram_we,
@@ -84,7 +85,8 @@ module sdram_top_axi(
     .inport_rlast_o(in_rlast),
     .sdram_clk_o(sdram_clk),
     .sdram_cke_o(sdram_cke),
-    .sdram_cs_o(sdram_cs),
+    .sdram_cs0_o(sdram_cs0),
+    .sdram_cs1_o(sdram_cs1),
     .sdram_ras_o(sdram_ras),
     .sdram_cas_o(sdram_cas),
     .sdram_we_o(sdram_we),
-- 
2.34.1

