 .mill-version        | 2 +-
 src/device/VGA.scala | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/.mill-version b/.mill-version
index 7fd0b1e8..bcc7c361 100644
--- a/.mill-version
+++ b/.mill-version
@@ -1 +1 @@
-0.12.4
\ No newline at end of file
+0.12.16
diff --git a/src/device/VGA.scala b/src/device/VGA.scala
index 2d545fb6..c4174b6f 100644
--- a/src/device/VGA.scala
+++ b/src/device/VGA.scala
@@ -48,7 +48,7 @@ class vgaChisel extends Module {
   val do_write = apb.psel && apb.penable && apb.pwrite
   when(do_write) {
     buffer.write(
-      apb.paddr(19, 2),
+      apb.paddr(20, 2),
       apb.pwdata.asTypeOf(Vec(4, UInt(8.W))),
       apb.pstrb.asBools
     )
@@ -93,9 +93,9 @@ class vgaChisel extends Module {
   vga.valid := RegNext(pixel_valid, false.B)
   vga.vsync := RegNext(vs, false.B)
   vga.hsync := RegNext(hs, false.B)
-  vga.r := pixel(7, 0)
+  vga.r := pixel(23, 16)
   vga.g := pixel(15, 8)
-  vga.b := pixel(23, 16)
+  vga.b := pixel(7, 0)
 }
 
 class APBVGA(address: Seq[AddressSet])(implicit p: Parameters)
