From 9c6048364b42be561d72066a35922b75911d15d1 Mon Sep 17 00:00:00 2001
From: "Wang, Yuan" <hallo_sun@hotmail.com>
Date: Sun, 8 Feb 2026 14:29:28 +0800
Subject: [PATCH 08/40] [sdram] bit extend for 32bit access one time

Signed-off-by: Wang, Yuan <hallo_sun@hotmail.com>
---
 perip/sdram/core_sdram_axi4/sdram_axi_core.v | 150 +++++++++++++------
 perip/sdram/sdram.v                          |  34 +++--
 perip/sdram/sdram_top_apb.v                  |   8 +-
 3 files changed, 131 insertions(+), 61 deletions(-)

diff --git a/perip/sdram/core_sdram_axi4/sdram_axi_core.v b/perip/sdram/core_sdram_axi4/sdram_axi_core.v
index cedbf77b..cc339b54 100644
--- a/perip/sdram/core_sdram_axi4/sdram_axi_core.v
+++ b/perip/sdram/core_sdram_axi4/sdram_axi_core.v
@@ -42,7 +42,7 @@ module sdram_axi_core
     ,input  [  7:0]  inport_len_i
     ,input  [ 31:0]  inport_addr_i
     ,input  [ 31:0]  inport_write_data_i
-    ,input  [ 15:0]  sdram_data_input_i
+    ,input  [ 31:0]  sdram_data_input_i
 
     // Outputs
     ,output          inport_accept_o
@@ -55,10 +55,10 @@ module sdram_axi_core
     ,output          sdram_ras_o
     ,output          sdram_cas_o
     ,output          sdram_we_o
-    ,output [  1:0]  sdram_dqm_o
+    ,output [  3:0]  sdram_dqm_o
     ,output [ 12:0]  sdram_addr_o
     ,output [  1:0]  sdram_ba_o
-    ,output [ 15:0]  sdram_data_output_o
+    ,output [ 31:0]  sdram_data_output_o
     ,output          sdram_data_out_en_o
 );
 
@@ -76,7 +76,7 @@ parameter SDRAM_READ_LATENCY     = 2;
 // Defines / Local params
 //-----------------------------------------------------------------
 localparam SDRAM_BANK_W          = 2;
-localparam SDRAM_DQM_W           = 2;
+localparam SDRAM_DQM_W           = 4;
 localparam SDRAM_BANKS           = 2 ** SDRAM_BANK_W;
 localparam SDRAM_ROW_W           = SDRAM_ADDR_W - SDRAM_COL_W - SDRAM_BANK_W;
 localparam SDRAM_REFRESH_CNT     = 2 ** SDRAM_ROW_W;
@@ -94,7 +94,10 @@ localparam CMD_REFRESH       = 4'b0001;
 localparam CMD_LOAD_MODE     = 4'b0000;
 
 // Mode: Burst Length = 4 bytes, CAS=2
-localparam MODE_REG          = {3'b000,1'b0,2'b00,3'b010,1'b0,3'b001};
+//localparam MODE_REG          = {3'b000,1'b0,2'b00,3'b010,1'b0,3'b001};
+
+// Mode: Burst Length = 0 bytes, CAS=2
+localparam MODE_REG            = {3'b000,1'b0,2'b00,3'b010,1'b0,3'b000};
 
 // SM states
 localparam STATE_W           = 4;
@@ -108,11 +111,13 @@ localparam STATE_WRITE0      = 4'd6;
 localparam STATE_WRITE1      = 4'd7;
 localparam STATE_PRECHARGE   = 4'd8;
 localparam STATE_REFRESH     = 4'd9;
+localparam STATE_FULL_READ   = 4'd10;
+localparam STATE_FULL_WRITE  = 4'd11;
 
 localparam AUTO_PRECHARGE    = 10;
 localparam ALL_BANKS         = 10;
 
-localparam SDRAM_DATA_W      = 16;
+localparam SDRAM_DATA_W      = 32;
 
 localparam CYCLE_TIME_NS     = 1000 / SDRAM_MHZ;
 
@@ -223,9 +228,9 @@ begin
             if (row_open_q[addr_bank_w] && addr_row_w == active_row_q[addr_bank_w])
             begin
                 if (!ram_rd_w)
-                    next_state_r = STATE_WRITE0;
+                    next_state_r = STATE_FULL_WRITE;
                 else
-                    next_state_r = STATE_READ;
+                    next_state_r = STATE_FULL_READ;
             end
             // Row miss, close row, open new row
             else if (row_open_q[addr_bank_w])
@@ -233,9 +238,9 @@ begin
                 next_state_r   = STATE_PRECHARGE;
 
                 if (!ram_rd_w)
-                    target_state_r = STATE_WRITE0;
+                    target_state_r = STATE_FULL_WRITE;
                 else
-                    target_state_r = STATE_READ;
+                    target_state_r = STATE_FULL_READ;
             end
             // No open row, open row
             else
@@ -243,9 +248,9 @@ begin
                 next_state_r   = STATE_ACTIVATE;
 
                 if (!ram_rd_w)
-                    target_state_r = STATE_WRITE0;
+                    target_state_r = STATE_FULL_WRITE;
                 else
-                    target_state_r = STATE_READ;
+                    target_state_r = STATE_FULL_READ;
             end
         end
     end
@@ -279,6 +284,17 @@ begin
                 next_state_r = STATE_READ;
         end
     end
+    STATE_FULL_READ :
+    begin
+        next_state_r = STATE_IDLE;
+        // Another pending read request (with no refresh pending)
+        if (!refresh_q && ram_req_w && ram_rd_w)
+        begin
+            // Open row hit
+            if (row_open_q[addr_bank_w] && addr_row_w == active_row_q[addr_bank_w])
+                next_state_r = STATE_FULL_READ;
+        end
+    end
     //-----------------------------------------
     // STATE_WRITE0
     //-----------------------------------------
@@ -301,6 +317,16 @@ begin
                 next_state_r = STATE_WRITE0;
         end
     end
+    STATE_FULL_WRITE :
+    begin
+        next_state_r = STATE_IDLE;
+        if (!refresh_q && ram_req_w && (ram_wr_w != 4'b0))
+        begin
+            // Open row hit
+            if (row_open_q[addr_bank_w] && addr_row_w == active_row_q[addr_bank_w])
+                next_state_r = STATE_FULL_WRITE;
+        end
+    end
     //-----------------------------------------
     // STATE_PRECHARGE
     //-----------------------------------------
@@ -460,19 +486,19 @@ else if (state_q == STATE_REFRESH)
 // Input sampling
 //-----------------------------------------------------------------
 
-reg [SDRAM_DATA_W-1:0] sample_data0_q;
-always @ (posedge clk_i or posedge rst_i)
-if (rst_i)
-    sample_data0_q <= {SDRAM_DATA_W{1'b0}};
-else
-    sample_data0_q <= sdram_data_in_w;
+// reg [SDRAM_DATA_W-1:0] sample_data0_q;
+// always @ (posedge clk_i or posedge rst_i)
+// if (rst_i)
+//     sample_data0_q <= {SDRAM_DATA_W{1'b0}};
+// else
+//     sample_data0_q <= sdram_data_in_w;
 
 reg [SDRAM_DATA_W-1:0] sample_data_q;
 always @ (posedge clk_i or posedge rst_i)
 if (rst_i)
     sample_data_q <= {SDRAM_DATA_W{1'b0}};
 else
-    sample_data_q <= sample_data0_q;
+    sample_data_q <= sdram_data_in_w;
 
 //-----------------------------------------------------------------
 // Command Output
@@ -483,13 +509,13 @@ always @ (posedge clk_i or posedge rst_i)
 if (rst_i)
 begin
     command_q       <= CMD_NOP;
-    data_q          <= 16'b0;
+    data_q          <= 32'b0;
     addr_q          <= {SDRAM_ROW_W{1'b0}};
     bank_q          <= {SDRAM_BANK_W{1'b0}};
     cke_q           <= 1'b0;
     dqm_q           <= {SDRAM_DQM_W{1'b0}};
     data_rd_en_q    <= 1'b1;
-    dqm_buffer_q    <= {SDRAM_DQM_W{1'b0}};
+//  dqm_buffer_q    <= {SDRAM_DQM_W{1'b0}};
 
     for (idx=0;idx<SDRAM_BANKS;idx=idx+1)
         active_row_q[idx] <= {SDRAM_ROW_W{1'b0}};
@@ -608,41 +634,72 @@ begin
         // Read mask (all bytes in burst)
         dqm_q       <= {SDRAM_DQM_W{1'b0}};
     end
+    STATE_FULL_READ :
+    begin
+        command_q   <= CMD_READ;
+        addr_q      <= addr_col_w;
+        bank_q      <= addr_bank_w;
+
+        // Disable auto precharge (auto close of row)
+        addr_q[AUTO_PRECHARGE]  <= 1'b0;
+
+        // Read mask (all bytes in burst)
+        dqm_q       <= {SDRAM_DQM_W{1'b0}};
+    end
+
     //-----------------------------------------
-    // STATE_WRITE0
+    // STATE_WRITE
     //-----------------------------------------
-    STATE_WRITE0 :
+    STATE_FULL_WRITE :
     begin
         command_q       <= CMD_WRITE;
         addr_q          <= addr_col_w;
         bank_q          <= addr_bank_w;
-        data_q          <= ram_write_data_w[15:0];
+        data_q          <= ram_write_data_w;
 
         // Disable auto precharge (auto close of row)
         addr_q[AUTO_PRECHARGE]  <= 1'b0;
 
         // Write mask
-        dqm_q           <= ~ram_wr_w[1:0];
-        dqm_buffer_q    <= ~ram_wr_w[3:2];
-
+        dqm_q           <= ~ram_wr_w[3:0];
         data_rd_en_q    <= 1'b0;
     end
+
+    //-----------------------------------------
+    // STATE_WRITE0
+    //-----------------------------------------
+    // STATE_WRITE0 :
+    // begin
+    //     command_q       <= CMD_WRITE;
+    //     addr_q          <= addr_col_w;
+    //     bank_q          <= addr_bank_w;
+    //     data_q          <= ram_write_data_w[15:0];
+
+    //     // Disable auto precharge (auto close of row)
+    //     addr_q[AUTO_PRECHARGE]  <= 1'b0;
+
+    //     // Write mask
+    //     dqm_q           <= ~ram_wr_w[1:0];
+    //     dqm_buffer_q    <= ~ram_wr_w[3:2];
+
+    //     data_rd_en_q    <= 1'b0;
+    // end
     //-----------------------------------------
     // STATE_WRITE1
     //-----------------------------------------
-    STATE_WRITE1 :
-    begin
-        // Burst continuation
-        command_q   <= CMD_NOP;
+    // STATE_WRITE1 :
+    // begin
+    //     // Burst continuation
+    //     command_q   <= CMD_NOP;
 
-        data_q      <= data_buffer_q;
+    //     data_q      <= data_buffer_q;
 
-        // Disable auto precharge (auto close of row)
-        addr_q[AUTO_PRECHARGE]  <= 1'b0;
+    //     // Disable auto precharge (auto close of row)
+    //     addr_q[AUTO_PRECHARGE]  <= 1'b0;
 
-        // Write mask
-        dqm_q       <= dqm_buffer_q;
-    end
+    //     // Write mask
+    //     dqm_q       <= dqm_buffer_q;
+    // end
     endcase
 end
 
@@ -655,7 +712,7 @@ always @ (posedge clk_i or posedge rst_i)
 if (rst_i)
     rd_q    <= {(SDRAM_READ_LATENCY+2){1'b0}};
 else
-    rd_q    <= {rd_q[SDRAM_READ_LATENCY:0], (state_q == STATE_READ)};
+    rd_q    <= {rd_q[SDRAM_READ_LATENCY:0], (state_q == STATE_FULL_READ)};
 
 //-----------------------------------------------------------------
 // Data Buffer
@@ -665,14 +722,15 @@ else
 // in WRITE0. Also buffer lower 16-bits of read data.
 always @ (posedge clk_i or posedge rst_i)
 if (rst_i)
-    data_buffer_q <= 16'b0;
+    data_buffer_q <= 32'b0;
 else if (state_q == STATE_WRITE0)
-    data_buffer_q <= ram_write_data_w[31:16];
-else if (rd_q[SDRAM_READ_LATENCY+1])
+    data_buffer_q <= ram_write_data_w;
+else if (rd_q[SDRAM_READ_LATENCY])
     data_buffer_q <= sample_data_q;
 
 // Read data output
-assign ram_read_data_w = {sample_data_q, data_buffer_q};
+//assign ram_read_data_w = {sample_data_q, data_buffer_q};
+assign ram_read_data_w = data_buffer_q;
 
 //-----------------------------------------------------------------
 // ACK
@@ -684,9 +742,9 @@ if (rst_i)
     ack_q   <= 1'b0;
 else
 begin
-    if (state_q == STATE_WRITE1)
+    if (state_q == STATE_FULL_WRITE)
         ack_q <= 1'b1;
-    else if (rd_q[SDRAM_READ_LATENCY+1])
+    else if (rd_q[SDRAM_READ_LATENCY])
         ack_q <= 1'b1;
     else
         ack_q <= 1'b0;
@@ -695,7 +753,7 @@ end
 assign ram_ack_w = ack_q;
 
 // Accept command in READ or WRITE0 states
-assign ram_accept_w = (state_q == STATE_READ || state_q == STATE_WRITE0);
+assign ram_accept_w = (state_q == STATE_FULL_READ || state_q == STATE_FULL_WRITE);
 
 //-----------------------------------------------------------------
 // SDRAM I/O
@@ -733,6 +791,8 @@ begin
     STATE_WRITE1      : dbg_state = "WRITE1";
     STATE_PRECHARGE   : dbg_state = "PRECHARGE";
     STATE_REFRESH     : dbg_state = "REFRESH";
+    STATE_FULL_READ   : dbg_state = "FULLREAD";
+    STATE_FULL_WRITE  : dbg_state = "FULLWRITE";
     default           : dbg_state = "UNKNOWN";
     endcase
 end
diff --git a/perip/sdram/sdram.v b/perip/sdram/sdram.v
index 4448c3d7..356b4995 100644
--- a/perip/sdram/sdram.v
+++ b/perip/sdram/sdram.v
@@ -1,4 +1,7 @@
-module sdram (
+module sdram #(
+  parameter int CHIPID = 0
+)
+ (
   input        clk,
   input        cke,
   input        cs,
@@ -17,12 +20,14 @@ module sdram (
     input int col,
     input shortint data,
     input int dqm_low,
-    input int dqm_high
+    input int dqm_high,
+    input int chip_id
   );
   import "DPI-C" function shortint sdram_read(
     input int bank,
     input int row,
-    input int col
+    input int col,
+    input int chip_id
   );
 
   // --- States Definition ---
@@ -63,7 +68,7 @@ module sdram (
             curr_state <= ST_LMR;
             // Decode LMR immediately or in next state
             // BL = 1, 2, 4, 8
-            reg_bl     <= (a[2:0] == 3'b000) ? 1 : (a[2:0] == 3'b011) ? 8 : (1 << a[2:0]);
+            reg_bl     <= (a[2:0] == 3'b000) ? 0 : (a[2:0] == 3'b011) ? 8 : (1 << a[2:0]);
             reg_cl     <= a[6:4];
           end else if (cmd == CMD_ACT) begin
             active_row[ba] <= a;
@@ -75,8 +80,9 @@ module sdram (
             burst_cnt           <= 0;
             curr_state          <= ST_READ_START;
             dq_out_en           <= 1'b1;
-          end else if (cmd == CMD_WRITE) begin
-            sdram_write(32'(ba), 32'(active_row[ba]), 32'(a[8:0]), dq, 32'(dqm[0]), 32'(dqm[1]));
+          end else if (cmd == CMD_WRITE && (!dqm[0] || !dqm[1])) begin
+            sdram_write(32'(ba), 32'(active_row[ba]), 32'(a[8:0]), dq, 32'(dqm[0]), 32'(dqm[1]),
+                        CHIPID);
             target_ba  <= ba;
             target_col <= a[8:0] + 1'b1;
             burst_cnt  <= 1;
@@ -86,9 +92,11 @@ module sdram (
 
         ST_READ_START: begin
           if (read_pipe[1]) begin
-            dq_out     <= sdram_read(32'(target_ba), 32'(active_row[target_ba]), 32'(target_col));
+            dq_out <= sdram_read(
+            32'(target_ba), 32'(active_row[target_ba]), 32'(target_col), CHIPID
+            );
             target_col <= target_col + 1;
-            burst_cnt  <= burst_cnt + 1;
+            burst_cnt <= burst_cnt + 1;
             curr_state <= ST_READ_CONT;
           end else begin
             read_pipe <= read_pipe >> 1;
@@ -98,9 +106,11 @@ module sdram (
         ST_READ_CONT: begin
           curr_state <= ST_READ_CONT;
           if (burst_cnt < reg_bl && !dqm[0]) begin
-            dq_out     <= sdram_read(32'(target_ba), 32'(active_row[target_ba]), 32'(target_col));
+            dq_out <= sdram_read(
+            32'(target_ba), 32'(active_row[target_ba]), 32'(target_col), CHIPID
+            );
             target_col <= target_col + 1;
-            burst_cnt  <= burst_cnt + 1;
+            burst_cnt <= burst_cnt + 1;
           end else begin
             curr_state <= ST_IDLE;
             read_pipe  <= 0;
@@ -110,9 +120,9 @@ module sdram (
         end
 
         ST_WRITE: begin
-          if (burst_cnt < reg_bl) begin
+          if (burst_cnt < reg_bl && (!dqm[0] || !dqm[1])) begin
             sdram_write(32'(target_ba), 32'(active_row[target_ba]), 32'(target_col), dq,
-                        32'(dqm[0]), 32'(dqm[1]));
+                        32'(dqm[0]), 32'(dqm[1]), CHIPID);
             target_col <= target_col + 1'b1;
             burst_cnt  <= burst_cnt + 1'b1;
           end else begin
diff --git a/perip/sdram/sdram_top_apb.v b/perip/sdram/sdram_top_apb.v
index 3bc5b93b..f127d714 100644
--- a/perip/sdram/sdram_top_apb.v
+++ b/perip/sdram/sdram_top_apb.v
@@ -20,13 +20,13 @@ module sdram_top_apb (
   output        sdram_we,
   output [12:0] sdram_a,
   output [ 1:0] sdram_ba,
-  output [ 1:0] sdram_dqm,
-  inout  [15:0] sdram_dq
+  output [ 3:0] sdram_dqm,
+  inout  [31:0] sdram_dq
 );
 
   wire sdram_dout_en;
-  wire [15:0] sdram_dout;
-  assign sdram_dq = sdram_dout_en ? sdram_dout : 16'bz;
+  wire [31:0] sdram_dout;
+  assign sdram_dq = sdram_dout_en ? sdram_dout : 32'bz;
 
   typedef enum [1:0] { ST_IDLE, ST_WAIT_ACCEPT, ST_WAIT_ACK } state_t;
   reg [1:0] state;
-- 
2.34.1

