-    writerh.io.clk := io.clk
+    reader.io.valid := false.B
+    reader.io.addr := 0.U
+
+    writer.io.valid := false.B
+    List(writer.io.addr, writer.io.data, writer.io.mask).map(_ := 0.U)
+    writer.io.clk := io.clk
 
     when(io.cke){
       
@@ -165,90 +151,33 @@ class sdramChisel extends RawModule {
         mode_reg := io.a
       }
       
-      // 写命令处理
-      val WRITE_CMD = (cmd === "b0100".U)
-      val write_bursting = withReset(!io.cke)(RegInit(false.B))
-      val wburst_cnt = Reg(UInt(4.W))
-      val waddr_reg = Reg(UInt(24.W))
-      when(WRITE_CMD) {
-        // 当前周期：立即锁存数据
-        write_bursting := !(burst_length === 1.U)
