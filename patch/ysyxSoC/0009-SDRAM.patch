+/*
+ * MT48LC16M16A2 简易模型
+ *
+ *
+ * 【引脚】
+ *   cs[1:0]  片选，低有效；
+ *   dqm[3:0] 字节掩码，低有效；dqm[1:0] 掩低 16 位，dqm[3:2] 掩高 16 位
+ *   dq[31:0] 双向数据：低 16 位（high=0）↔ sdram_l(*)，高 16 位（high=1）↔ sdram_h(*)
+ *   a[12:0]  行/列复用地址；ba[1:0] 存储体地址
+ *   命令 = {~cs, ras, cas, we}（各控制信号低有效）
+ *
+ * 【实现的命令】
+ *   0000 LOAD MODE REGISTER：只取 CAS latency = mode_reg[6:4]
+ *   0011 ACTIVE ：rows(ba) := a，打开目标 bank 的第a行
+ *   0100 WRITE  ：把 dq 上的 32 位写到 {row, ba, col} 处，DQM 做字节掩码
+ *   0101 READ   ：收到命令后等 CAS latency 拍，再把该地址的 32 位送上 dq；
+ * ============================================================================
+ */
 package ysyx
 
 import chisel3._
@@ -48,22 +66,20 @@ class sdram extends BlackBox {
 class SDRAMReader extends BlackBox with HasBlackBoxInline {
   val io = IO(new Bundle{
     val high_sdram = Input(Bool())
-    val high = Input(Bool())
     val addr = Input(UInt(24.W))
     val valid = Input(Bool())
-    val rdata = Output(UInt(16.W))
+    val rdata = Output(UInt(32.W))
   })
   setInline("SDRAMReader.v",
     """module SDRAMReader(
       |  input high_sdram,
-      |  input high,
       |  input [23:0] addr,
       |  input valid,
-      |  output reg [15:0] rdata
+      |  output reg [31:0] rdata
       |);
-      |import "DPI-C" function void sdram_read(input byte high_sdram, input byte high, input int addr, output shortint rdata);
+      |import "DPI-C" function void sdram_read(input byte high_sdram, input int addr, output int rdata);
       |always @(*) begin
-      |  if (valid) sdram_read({7'd0, high_sdram}, {7'd0, high}, {8'd0, addr}, rdata);
+      |  if (valid) sdram_read({7'd0, high_sdram}, {8'd0, addr}, rdata);
       |  else rdata = 0;
       |end
       |endmodule
@@ -74,25 +90,23 @@ class SDRAMWriter extends BlackBox with HasBlackBoxInline {
   val io = IO(new Bundle{
     val high_sdram = Input(Bool())
     val clk = Input(Bool())
-    val high = Input(Bool())
     val addr = Input(UInt(24.W))
-    val data = Input(UInt(16.W))
-    val mask = Input(UInt(2.W))
+    val data = Input(UInt(32.W))
+    val mask = Input(UInt(4.W))
     val valid = Input(Bool())
   })
   setInline("SDRAMWriter.v",
     """module SDRAMWriter(
       |  input high_sdram,
       |  input clk,
-      |  input high,
       |  input [23:0] addr,
-      |  input [15:0] data,
-      |  input [1:0] mask,
+      |  input [31:0] data,
+      |  input [3:0] mask,
       |  input valid
       |);
-      |import "DPI-C" function void sdram_write(input byte high_sdram, input byte high, input int addr, input shortint wdata, input byte mask);
+      |import "DPI-C" function void sdram_write(input byte high_sdram, input int addr, input int wdata, input byte mask);
       |always @(posedge clk) begin
-      |  if (valid) sdram_write({7'd0, high_sdram}, {7'd0, high}, {8'd0, addr}, data, {6'd0, mask});
+      |  if (valid) sdram_write({7'd0, high_sdram}, {8'd0, addr}, data, {4'd0, mask});
       |end
       |endmodule
     """.stripMargin)
@@ -110,51 +124,23 @@ class sdramChisel extends RawModule {
     val cs = WireDefault(true.B)
     
     val mode_reg = Reg(UInt(13.W))
-
     val rows = Reg(Vec(4,UInt(13.W)))
     val addr_reg = Reg(UInt(24.W))
-
     val cas_latency = mode_reg(6,4)
-    val burst_length = MuxLookup(mode_reg(2,0), 1.U)(Seq(
