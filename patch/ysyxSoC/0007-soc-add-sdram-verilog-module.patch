From 66e8a799e54eac454d281e72ad14aa77cd1fb561 Mon Sep 17 00:00:00 2001
From: "Wang, Yuan1" <hallo_sun@hotmail.com>
Date: Fri, 6 Feb 2026 04:03:22 +0000
Subject: [PATCH 07/40] [soc] add sdram verilog module

Signed-off-by: Wang, Yuan1 <hallo_sun@hotmail.com>
---
 perip/sdram/sdram.v | 120 +++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 118 insertions(+), 2 deletions(-)

diff --git a/perip/sdram/sdram.v b/perip/sdram/sdram.v
index 3613b231..4448c3d7 100644
--- a/perip/sdram/sdram.v
+++ b/perip/sdram/sdram.v
@@ -1,4 +1,4 @@
-module sdram(
+module sdram (
   input        clk,
   input        cke,
   input        cs,
@@ -11,6 +11,122 @@ module sdram(
   inout [15:0] dq
 );
 
-  assign dq = 16'bz;
+  import "DPI-C" function void sdram_write(
+    input int bank,
+    input int row,
+    input int col,
+    input shortint data,
+    input int dqm_low,
+    input int dqm_high
+  );
+  import "DPI-C" function shortint sdram_read(
+    input int bank,
+    input int row,
+    input int col
+  );
+
+  // --- States Definition ---
+  localparam ST_IDLE = 3'b000;
+  localparam ST_ACT = 3'b001;
+  localparam ST_READ_START = 3'b010;
+  localparam ST_READ_CONT = 3'b011;
+  localparam ST_WRITE = 3'b100;
+  localparam ST_LMR = 3'b101;
+
+  reg [2:0] curr_state;
+
+  // --- Internal Registers ---
+  reg [3:0] reg_bl;
+  reg [2:0] reg_cl;
+  reg [12:0] active_row[3:0];
+  reg [7:0] read_pipe;
+  reg [3:0] burst_cnt;
+  reg [1:0] target_ba;
+  reg [8:0] target_col;
+  reg [15:0] dq_out;
+  reg dq_out_en;
+
+  // --- Command Decoding ---
+  wire [3:0] cmd = {cs, ras, cas, we};
+  localparam CMD_LMR = 4'b0000;
+  localparam CMD_ACT = 4'b0011;
+  localparam CMD_READ = 4'b0101;
+  localparam CMD_WRITE = 4'b0100;
+  localparam CMD_NOP = 4'b0111;
+
+  // --- State Machine and Logic ---
+  always @(posedge clk) begin
+    if (cke) begin
+      case (curr_state)
+        ST_IDLE: begin
+          if (cmd == CMD_LMR) begin
+            curr_state <= ST_LMR;
+            // Decode LMR immediately or in next state
+            // BL = 1, 2, 4, 8
+            reg_bl     <= (a[2:0] == 3'b000) ? 1 : (a[2:0] == 3'b011) ? 8 : (1 << a[2:0]);
+            reg_cl     <= a[6:4];
+          end else if (cmd == CMD_ACT) begin
+            active_row[ba] <= a;
+            curr_state     <= ST_IDLE;  // Simplified: Return to IDLE to wait for READ/WRITE
+          end else if (cmd == CMD_READ) begin
+            read_pipe[reg_cl-1] <= 1'b1;
+            target_ba           <= ba;
+            target_col          <= a[8:0];
+            burst_cnt           <= 0;
+            curr_state          <= ST_READ_START;
+            dq_out_en           <= 1'b1;
+          end else if (cmd == CMD_WRITE) begin
+            sdram_write(32'(ba), 32'(active_row[ba]), 32'(a[8:0]), dq, 32'(dqm[0]), 32'(dqm[1]));
+            target_ba  <= ba;
+            target_col <= a[8:0] + 1'b1;
+            burst_cnt  <= 1;
+            curr_state <= (reg_bl > 1) ? ST_WRITE : ST_IDLE;
+          end
+        end
+
+        ST_READ_START: begin
+          if (read_pipe[1]) begin
+            dq_out     <= sdram_read(32'(target_ba), 32'(active_row[target_ba]), 32'(target_col));
+            target_col <= target_col + 1;
+            burst_cnt  <= burst_cnt + 1;
+            curr_state <= ST_READ_CONT;
+          end else begin
+            read_pipe <= read_pipe >> 1;
+          end
+        end
+
+        ST_READ_CONT: begin
+          curr_state <= ST_READ_CONT;
+          if (burst_cnt < reg_bl && !dqm[0]) begin
+            dq_out     <= sdram_read(32'(target_ba), 32'(active_row[target_ba]), 32'(target_col));
+            target_col <= target_col + 1;
+            burst_cnt  <= burst_cnt + 1;
+          end else begin
+            curr_state <= ST_IDLE;
+            read_pipe  <= 0;
+            dq_out     <= 0;
+            dq_out_en  <= 1'b0;
+          end
+        end
+
+        ST_WRITE: begin
+          if (burst_cnt < reg_bl) begin
+            sdram_write(32'(target_ba), 32'(active_row[target_ba]), 32'(target_col), dq,
+                        32'(dqm[0]), 32'(dqm[1]));
+            target_col <= target_col + 1'b1;
+            burst_cnt  <= burst_cnt + 1'b1;
+          end else begin
+            curr_state <= ST_IDLE;
+          end
+        end
+
+        ST_LMR:  curr_state <= ST_IDLE;
+        default: curr_state <= ST_IDLE;
+
+      endcase
+    end
+  end
+
+  assign dq = dq_out_en ? dq_out : 16'bz;
 
 endmodule
-- 
2.34.1

