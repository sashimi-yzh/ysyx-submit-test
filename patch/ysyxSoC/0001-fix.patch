diff --git a/src/device/BitRev.scala b/src/device/BitRev.scala
index 6bd3d572..643bfb23 100644
--- a/src/device/BitRev.scala
+++ b/src/device/BitRev.scala
@@ -6,8 +6,37 @@ import chisel3.util._
 class bitrev extends BlackBox {
   val io = IO(Flipped(new SPIIO(1)))
 }
-
+/**
+                    +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+
+ SCK            |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |
+        --------+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +---+   +------------
+        --------+                                                                                                                               +--------
+ SS             |                                                                                                                               |
+                +-------------------------------------------------------------------------------------------------------------------------------+
+        +-------+-------+-------+-------+-------+-------+-------+-------+-------+------------------------------------------------------------------------
+ MOSI            |   b7  |   b6  |   b5  |   b4  |   b3  |   b2  |   b1  |   b0  |
+                +-------+-------+-------+-------+-------+-------+-------+-------+
+        +-----------------------------------------------------------------------+-------+-------+-------+-------+-------+-------+-------+-------+--------
+ MISO                                                                            |   b0  |   b1  |   b2  |   b3  |   b4  |   b5  |   b6  |   b7  |
+                                                                                +-------+-------+-------+-------+-------+-------+-------+-------+
+  */
 class bitrevChisel extends RawModule { // we do not need clock and reset
   val io = IO(Flipped(new SPIIO(1)))
-  io.miso := true.B
+
+  withClockAndReset((!io.sck).asClock, io.ss(0).asAsyncReset) {
+    val bitCnt = RegInit(0.U(4.W))
+    bitCnt := bitCnt + 1.U
+
+    val rxReg = RegInit(0.U(8.W))
+    val rxNext = Cat(rxReg(6, 0), io.mosi)
+    rxReg := rxNext
+
+    val txReg = RegInit("hFF".U(8.W))
+    when(bitCnt === 7.U) {
+      txReg := Reverse(rxNext)
+    }.otherwise {
+      txReg := Cat(txReg(6, 0), 0.U(1.W))
+    }
+    io.miso := txReg(7)
+  }
 }
diff --git a/src/device/PSRAM.scala b/src/device/PSRAM.scala
index 09d889e4..b70d981b 100644
--- a/src/device/PSRAM.scala
+++ b/src/device/PSRAM.scala
@@ -10,17 +10,18 @@ import freechips.rocketchip.diplomacy._
 import freechips.rocketchip.util._
 
 class QSPIIO extends Bundle {
-  val sck = Output(Bool())
+  val sck  = Output(Bool())
   val ce_n = Output(Bool())
-  val dio = Analog(4.W)
+  val dio  = Analog(4.W)
 }
 
 class psram_top_apb extends BlackBox {
   val io = IO(new Bundle {
     val clock = Input(Clock())
     val reset = Input(Reset())
-    val in = Flipped(new APBBundle(APBBundleParameters(addrBits = 32, dataBits = 32)))
-    val qspi = new QSPIIO
+    val in    =
+      Flipped(new APBBundle(APBBundleParameters(addrBits = 32, dataBits = 32)))
+    val qspi  = new QSPIIO
   })
 }
 
@@ -29,22 +30,112 @@ class psram extends BlackBox {
 }
 
 class psramChisel extends RawModule {
-  val io = IO(Flipped(new QSPIIO))
-  val di = TriStateInBuf(io.dio, 0.U, false.B) // change this if you need
+  val io     = IO(Flipped(new QSPIIO))
+  val dout   = Wire(UInt(4.W))
+  val out_en = Wire(Bool())
+  val din    = TriStateInBuf(io.dio, dout, out_en)
+  dout   := 0.U
+  out_en := false.B
+  val mem = Mem(1 << 22, UInt(8.W))
+
+  val inQPI = withClockAndReset(io.sck.asClock, false.B.asAsyncReset) { RegInit(false.B) }
+  withClockAndReset(io.sck.asClock, io.ce_n.asAsyncReset) {
+    val counter      = RegInit(0.U(8.W))
+    val cmd          = RegInit(0.U(8.W))
+    val addr         = RegInit(0.U(24.W))
+    val isReadCmd    = RegInit(false.B)
+    val isWriteCmd   = RegInit(false.B)
+    val writeDataPre = RegInit(0.U(4.W))
+    counter := counter + 1.U
+    when(inQPI === false.B) {
+      when(counter < 8.U) {
+        cmd := Cat(cmd(6, 0), din(0))
+      }
+      when(counter === 8.U) {
+        isReadCmd  := (cmd === 0xeb.U)
+        isWriteCmd := (cmd === 0x38.U)
+        inQPI      := (cmd === 0x35.U)
+      }
+      when(counter >= 8.U && counter < 14.U) {
+        addr := Cat(addr(19, 0), din)
+      }
+      when(isWriteCmd && counter >= 14.U) {
+        writeDataPre := din
+      }
+      when(isWriteCmd && counter > 14.U) {
+        val wIdx = (counter - 14.U)(2, 1)
+        when(counter(0) === 1.U) {
+          mem.write(addr(21, 0) + wIdx, Cat(writeDataPre, din))
+        }
+      }
+      when(isReadCmd && counter >= 21.U && counter < 29.U) {
+        out_en := true.B
+        val rIdx = (counter - 21.U)(2, 1)
+        val byte = mem.read(addr(21, 0) + rIdx)
+        when(counter(0) === 1.U) {
+          dout := byte(7, 4)
+        }.otherwise {
+          dout := byte(3, 0)
+        }
+      }
+    }.otherwise({
+      when(counter < 2.U) {
+        cmd := Cat(cmd(3, 0), din)
+      }
+      when(counter === 2.U) {
+        isReadCmd  := (cmd === 0xeb.U)
+        isWriteCmd := (cmd === 0x38.U)
+      }
+      when(counter >= 2.U && counter < 8.U) {
+        addr := Cat(addr(19, 0), din)
+      }
+      when(isWriteCmd && counter >= 8.U) {
+        writeDataPre := din
+      }
+      when(isWriteCmd && counter > 8.U) {
+        val wIdx = (counter - 8.U)(2, 1)
+        when(counter(0) === 1.U) {
+          mem.write(addr(21, 0) + wIdx, Cat(writeDataPre, din))
+        }
+      }
+      when(isReadCmd && counter >= 15.U && counter < 23.U) {
+        out_en := true.B
+        val rIdx = (counter - 15.U)(2, 1)
+        val byte = mem.read(addr(21, 0) + rIdx)
+        when(counter(0) === 1.U) {
+          dout := byte(7, 4)
+        }.otherwise {
+          dout := byte(3, 0)
+        }
+      }
+    })
+  }
 }
 
-class APBPSRAM(address: Seq[AddressSet])(implicit p: Parameters) extends LazyModule {
