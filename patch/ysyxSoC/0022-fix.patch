 perip/uart16550/rtl/uart_regs.v | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/perip/uart16550/rtl/uart_regs.v b/perip/uart16550/rtl/uart_regs.v
index b48d1d6c..04d2fef9 100644
--- a/perip/uart16550/rtl/uart_regs.v
+++ b/perip/uart16550/rtl/uart_regs.v
@@ -423,6 +423,15 @@ end // always @ (dl or dlab or ier or iir or scratch...
 
 
 // rf_pop signal handling
+reg wb_re_i_r;
+always @(posedge clk or posedge wb_rst_i)
+begin
+    if (wb_rst_i)
+        wb_re_i_r <= #1 0;
+    else
+        wb_re_i_r <= #1 wb_re_i;
+end
+
 always @(posedge clk or posedge wb_rst_i)
 begin
     if (wb_rst_i)
@@ -431,7 +440,7 @@ begin
     if (rf_pop)    // restore the signal to 0 after one clock cycle
         rf_pop <= #1 0;
     else
-    if (wb_re_i && wb_addr_i == `UART_REG_RB && !dlab)
+    if (wb_re_i_r && wb_addr_i == `UART_REG_RB && !dlab)
         rf_pop <= #1 1; // advance read pointer
 end
 
