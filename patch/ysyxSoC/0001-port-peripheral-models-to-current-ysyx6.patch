diff --git a/perip/vga/vga_top_apb.v b/perip/vga/vga_top_apb.v
index 5c74cfbe..069d1fcd 100644
--- a/perip/vga/vga_top_apb.v
+++ b/perip/vga/vga_top_apb.v
@@ -19,5 +19,205 @@ module vga_top_apb(
   output        vga_vsync,
   output        vga_valid
 );
+  typedef enum logic [1:0] {
+    ST_IDLE, ST_WAIT_ACCEPT, ST_WAIT_ACK
+  } state_t;
+
+  reg [1:0] state;
+
+  always @(posedge clock) begin
+    if(reset) begin
+      state <= ST_IDLE;
+    end else begin
+      case(state)
+        ST_IDLE: state <= (is_write ? (req_accept ? ST_WAIT_ACK : ST_WAIT_ACCEPT) : ST_IDLE);
+        ST_WAIT_ACCEPT: state <= req_accept ? ST_WAIT_ACK : ST_WAIT_ACCEPT;
+        ST_WAIT_ACK: if (in_pready) state <= ST_IDLE;
+        default: state <= state;
+      endcase
+    end
+  end
+
+  wire is_write = ((in_psel && !in_penable) || (state == ST_WAIT_ACCEPT)) && in_pwrite;
+  wire req_accept = is_write;
+
+  wire [23:0] vga_data;
+  wire [9:0] r_v_addr, r_h_addr, w_v_addr, w_h_addr;
+
+  vga_core vga_core_inst (
+    .clk_i(clock),
+    .rst_i(reset),
+
+    .inport_wr_i(in_pstrb&{4{is_write}}),
+    .inport_addr_i(in_paddr),
+    .inport_write_data_i(in_pwdata),
+
+    .vga_data(vga_data),
+    .r_v_addr(r_v_addr),
+    .r_h_addr(r_h_addr),
+    .w_v_addr(w_v_addr),
+    .w_h_addr(w_h_addr),
+
+    .vga_r(vga_r),
+    .vga_g(vga_g),
+    .vga_b(vga_b),
+    .vga_hsync(vga_hsync),
+    .vga_vsync(vga_vsync),
+    .vga_valid(vga_valid)
+  );
+
+  vga_mem_block mem(
+    .clk_i(clock),
+    .rst_i(reset),
+    .w_h_addr(w_h_addr),
+    .w_v_addr(w_v_addr[8:0]),
+    .strb_i(in_pstrb & {4{is_write}}),
+    .data_i(in_pwdata),
+    .ack(in_pready),
+    .h_addr(r_h_addr),
+    .v_addr(r_v_addr[8:0]),
+    .vga_data(vga_data)
+  );
+
+endmodule
+
+module vga_mem_block (
+  input clk_i,
+  input rst_i,
+
+  input [9:0] w_h_addr,
+  input [8:0] w_v_addr,
+  input [3:0] strb_i,
+  input [31:0] data_i,
+  output ack,
+
+  input [8:0] v_addr,
+  input [9:0] h_addr,
+  output [23:0] vga_data
+);
+  reg [23:0] vga_mem [524287:0];
+
+  // initial begin
+  //   $readmemh("/home/ysyx/project/ysyx-workbench/nvboard/example/preexmple/resource/picture.hex", vga_mem);
+  // end
+
+  // ------------------------------------
+  // WRITE LOGIC
+  // ------------------------------------
+  wire write_enable = (strb_i != 4'b0);
+  always @(posedge clk_i) begin
+    if(rst_i) begin
+      vga_mem[{w_h_addr, w_v_addr}] <= 0;
+    end else if(write_enable) begin
+      // $display("[VGA_MEM] Write: addr w_h_addr=%0d, w_v_addr=%0d, combined_addr=%0d, strb=0x%h, data=0x%h",
+      //          w_h_addr, w_v_addr, {w_h_addr, w_v_addr}, strb_i, data_i);
+      // $fflush();
+      if(strb_i[0]) begin
+        vga_mem[{w_h_addr, w_v_addr}][7:0] <= data_i[7:0];
+        // $display("[VGA_MEM]   Writing byte[7:0] = 0x%h", data_i[7:0]);
+        // $fflush();
+      end
+      if(strb_i[1]) begin
+        vga_mem[{w_h_addr, w_v_addr}][15:8] <= data_i[15:8];
+        // $display("[VGA_MEM]   Writing byte[15:8] = 0x%h", data_i[15:8]);
+        // $fflush();
+      end
+      if(strb_i[2]) begin
+        vga_mem[{w_h_addr, w_v_addr}][23:16] <= data_i[23:16];
+        // $display("[VGA_MEM]   Writing byte[23:16] = 0x%h", data_i[23:16]);
+        // $fflush();
+      end
+      // $display("[VGA_MEM]   Final mem value = 0x%h", vga_mem[{w_h_addr, w_v_addr}]);
+      // $fflush();
+    end
+  end
+
+  // ------------------------------------
+  // READ LOGIC
+  // ------------------------------------
+
+  assign vga_data = vga_mem[{h_addr, v_addr}];
+
+  // ACK生成 -- 读不需要确认
+  reg ack_o;
+  always @(posedge clk_i or posedge rst_i) begin
+    if (rst_i) begin
+      ack_o <= 1'b0;
+    end else begin
+      ack_o <= (|strb_i);
+    end
+  end
+
+  assign ack = ack_o;
+
+endmodule
+
+module vga_core (
+  input clk_i,
+  input rst_i,
+  input [3:0] inport_wr_i,
+  input [31:0] inport_write_data_i,
+  input [31:0] inport_addr_i,
+
+  input [23:0] vga_data,
+  output [9:0] r_v_addr,
+  output [9:0] r_h_addr,
+  output [9:0] w_v_addr,
+  output [9:0] w_h_addr,
+
+  output [7:0] vga_r,
+  output [7:0] vga_g,
+  output [7:0] vga_b,
+  output vga_hsync,
+  output vga_vsync,
+  output vga_valid
+);
+
+  localparam h_frontporch = 96;
+  localparam h_active = 144;
+  localparam h_backporch = 784;
+  localparam h_total = 800;
+
+  localparam v_frontporch = 2;
+  localparam v_active = 35;
+  localparam v_backporch = 515;
+  localparam v_total = 525;
+
+  reg [9:0] x_cnt;
+  reg [9:0] y_cnt;
+  wire h_valid, v_valid;
+
+  always @(posedge clk_i) begin
+    if(rst_i) begin
+      x_cnt <= 1;
+      y_cnt <= 1;
+    end else begin
+      if(x_cnt == h_total) begin
+        x_cnt <= 1;
+        if(y_cnt == v_total)
+          y_cnt <= 1;
+        else
+          y_cnt <= y_cnt + 1;
+      end else begin
+        x_cnt <= x_cnt + 1;
+      end
+    end
+  end
+
+  //生成同步信号
+  assign vga_hsync = (x_cnt > h_frontporch);
+  assign vga_vsync = (y_cnt > v_frontporch);
+  //生成消隐信号
+  assign h_valid = (x_cnt > h_active) & (x_cnt <= h_backporch);
+  assign v_valid = (y_cnt > v_active) & (y_cnt <= v_backporch);
+  assign vga_valid = h_valid & v_valid;
+  //计算当前有效像素坐标
+  assign r_h_addr = h_valid ? (x_cnt - 10'd145) : 10'd0;
+  assign r_v_addr = v_valid ? (y_cnt - 10'd36) : 10'd0;
+  //设置输出的颜色值
+  assign {vga_r, vga_g, vga_b} = vga_data;
+
+  assign w_h_addr = inport_addr_i[11:2];
+  assign w_v_addr = inport_addr_i[21:12];
 
 endmodule
