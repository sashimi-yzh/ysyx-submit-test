-  output [1:0]  in_rresp,
-  output        in_rlast,
-  output        in_awready,
-  input         in_awvalid,
-  input  [3:0]  in_awid,
-  input  [31:0] in_awaddr,
-  input  [7:0]  in_awlen,
-  input  [2:0]  in_awsize,
-  input  [1:0]  in_awburst,
-  output        in_wready,
-  input         in_wvalid,
-  input  [31:0] in_wdata,
-  input  [3:0]  in_wstrb,
-  input         in_wlast,
-                in_bready,
-  output        in_bvalid,
-  output [3:0]  in_bid,
-  output [1:0]  in_bresp,
-
-  input         out_arready,
-  output        out_arvalid,
-  output [3:0]  out_arid,
-  output [31:0] out_araddr,
-  output [7:0]  out_arlen,
-  output [2:0]  out_arsize,
-  output [1:0]  out_arburst,
-  output        out_rready,
-  input         out_rvalid,
-  input  [3:0]  out_rid,
-  input  [31:0] out_rdata,
-  input  [1:0]  out_rresp,
-  input         out_rlast,
-  input         out_awready,
-  output        out_awvalid,
-  output [3:0]  out_awid,
-  output [31:0] out_awaddr,
-  output [7:0]  out_awlen,
-  output [2:0]  out_awsize,
-  output [1:0]  out_awburst,
-  input         out_wready,
-  output        out_wvalid,
-  output [31:0] out_wdata,
-  output [3:0]  out_wstrb,
-  output        out_wlast,
-                out_bready,
-  input         out_bvalid,
-  input  [3:0]  out_bid,
-  input  [1:0]  out_bresp
+// `define FAST_AXI4
+
+module axi4_delayer (
+    input clock,
+    input reset,
+
+    output        in_arready,
+    input         in_arvalid,
+    input  [ 3:0] in_arid,
+    input  [31:0] in_araddr,
+    input  [ 7:0] in_arlen,
+    input  [ 2:0] in_arsize,
+    input  [ 1:0] in_arburst,
+    input         in_rready,
+    output        in_rvalid,
+    output [ 3:0] in_rid,
+    output [31:0] in_rdata,
+    output [ 1:0] in_rresp,
+    output        in_rlast,
+    output        in_awready,
+    input         in_awvalid,
+    input  [ 3:0] in_awid,
+    input  [31:0] in_awaddr,
+    input  [ 7:0] in_awlen,
+    input  [ 2:0] in_awsize,
+    input  [ 1:0] in_awburst,
+    output        in_wready,
+    input         in_wvalid,
+    input  [31:0] in_wdata,
+    input  [ 3:0] in_wstrb,
+    input         in_wlast,
+    in_bready,
+    output        in_bvalid,
+    output [ 3:0] in_bid,
+    output [ 1:0] in_bresp,
+
+    input         out_arready,
+    output        out_arvalid,
+    output [ 3:0] out_arid,
+    output [31:0] out_araddr,
+    output [ 7:0] out_arlen,
+    output [ 2:0] out_arsize,
+    output [ 1:0] out_arburst,
+    output        out_rready,
+    input         out_rvalid,
+    input  [ 3:0] out_rid,
+    input  [31:0] out_rdata,
+    input  [ 1:0] out_rresp,
+    input         out_rlast,
+    input         out_awready,
+    output        out_awvalid,
+    output [ 3:0] out_awid,
+    output [31:0] out_awaddr,
+    output [ 7:0] out_awlen,
+    output [ 2:0] out_awsize,
+    output [ 1:0] out_awburst,
+    input         out_wready,
+    output        out_wvalid,
+    output [31:0] out_wdata,
+    output [ 3:0] out_wstrb,
+    output        out_wlast,
+    out_bready,
+    input         out_bvalid,
+    input  [ 3:0] out_bid,
+    input  [ 1:0] out_bresp
 );
 
+`ifdef FAST_AXI4
   assign in_arready = out_arready;
   assign out_arvalid = in_arvalid;
   assign out_arid = in_arid;
@@ -93,4 +96,260 @@ module axi4_delayer(
   assign in_bid = out_bid;
   assign in_bresp = out_bresp;
 
+`else
+
+  // ------------------------------------
+  //  THE AXI4 BUS DELAER
+  //  divide to two part -> read channel and write channel
+  // ------------------------------------
+  // assume the Hz of the npc is 550MHZ
+  // and the sdram env is 100MHZ
+  localparam k_s = 11;
+  localparam k = 2;
+
+  // ------------------------------------
+  // READ CHANNEL
+  // 1.read timer record -- @@1@@
+  // 2.trans and fifo -- @@2@@
+  // ------------------------------------
+  // to simply the implement assign the
+  // read burst would not up to 8
+  typedef enum logic [1:0] {
+    RD_IDLE  = 2'b00,  // 空闲等待请求
+    RD_TRANS = 2'b01,  // 正在向下游传输读数据
+    RD_DELAY = 2'b10,  // 插入延迟周期
+    RD_RESP  = 2'b11   // 向上游返回/完成本次读
+  } rd_state_e;
+
+  rd_state_e rd_state_q;
+  rd_state_e rd_state_r;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      rd_state_q <= RD_IDLE;
+    end else begin
+      rd_state_q <= rd_state_r;
+    end
+  end
+
+  always @(*) begin
+    rd_state_r = rd_state_q;
+    case (rd_state_q)
+      RD_IDLE: begin
+        if (in_arvalid && out_arready) begin
+          rd_state_r = RD_TRANS;
+        end
+      end
+
+      RD_TRANS: begin
+        if (out_rlast & out_rready_r & out_rvalid) begin
+          rd_state_r = RD_DELAY;
+        end
+      end
+
+      RD_DELAY: begin
+        if (rd_delay_done) begin
+          rd_state_r = RD_RESP;
+        end
+      end
+
+      RD_RESP: begin
+        if (rd_resp_done) begin
+          rd_state_r = RD_IDLE;
+        end
+      end
+    endcase
+  end
+
+  // read timer record -- @@1@@
+  // t1 * rk == t1' * k
+  reg [31:0] rd_t1;
+  always @(posedge clock) begin
+    if (reset) begin
+      rd_t1 <= 32'b0;
+    end else begin
+      if (rd_state_q == RD_TRANS) begin
+        rd_t1 <= rd_t1 + 32'b1;
+      end else if (rd_state_q == RD_RESP & rd_resp_done) begin
+        rd_t1 <= 32'b0;
+      end
+    end
+  end
+
+  reg [31:0] rd_t1_x;
+  always @(posedge clock) begin
+    if (reset) begin
+      rd_t1_x <= 32'b0;
+    end else begin
+      if (rd_state_q == RD_TRANS || rd_state_q == RD_DELAY) begin
+        rd_t1_x <= rd_t1_x + 32'b1;
+      end else if (rd_state_q == RD_RESP && rd_resp_done) begin
+        rd_t1_x <= 32'b0;
+      end
+    end
+  end
+
+  wire rd_delay_done = ((rd_t1 * k_s) < (rd_t1_x * k));
+
+  // trans and fifo -- @@2@@
+  // Separate the upstream and downstream paths
+  // after the handshake is completed.
+  reg [2:0] fifo_top;
+  wire [2:0] next_fifo_top = fifo_top + 3'b1;
+  ;
+  reg [2:0] fifo_p;
+  reg [7:0][31:0] fifo;
+  reg is_empty;
+  always @(posedge clock) begin
+    if (reset) begin
+      is_empty <= 1'b1;
+      fifo_top <= 3'b0;
+    end else begin
+      if (out_rvalid & out_rready_r) begin
+        if (is_empty) begin
+          is_empty <= 1'b0;
+          fifo[fifo_top] <= out_rdata;
+        end else begin
+          fifo_top <= next_fifo_top;
+          fifo[next_fifo_top] <= out_rdata;
+        end
+      end else if (rd_resp_valid) begin
+        if (in_rlast_r) begin
+          fifo_top <= 3'b0;
+          fifo_p   <= 3'b0;
+          is_empty <= 1'b1;
+        end else begin
+          fifo_p <= fifo_p + 3'b1;
+        end
+      end
+    end
+  end
+
+  wire fifo_last = (fifo_p == fifo_top) & !is_empty;
+  wire fifo_full = !(is_empty) && (fifo_top == 3'b111);
+
+  always @(*) begin
+    if (fifo_full && out_rvalid) begin
+      $error("the axi4_delayer fifo overflow, the max read burst is 8");
+    end
+  end
+
+  wire in_rvalid_r = (rd_state_q == RD_RESP);
+  wire in_rlast_r = (rd_state_q == RD_RESP & fifo_last);
+  wire rd_resp_done = in_rlast_r & in_rready & in_rvalid_r;
+  wire rd_resp_valid = in_rvalid_r & in_rready;
+  assign in_rlast  = in_rlast_r;
+  assign in_rvalid = in_rvalid_r;
+  assign in_rdata  = (in_rvalid_r) ? fifo[fifo_p] : 32'b0;
+
+  // axi channel control
+  wire rd_take_over = (rd_state_q == RD_DELAY & rd_state_q == RD_RESP);
+  wire out_rready_r = (rd_state_q == RD_TRANS);
+  assign out_rready  = out_rready_r;
+  assign out_arvalid = (rd_take_over) ? 1'b0 : in_arvalid;
+  assign out_arburst = (rd_take_over) ? 2'b0 : in_arburst;
+  assign out_arlen   = (rd_take_over) ? 8'b0 : in_arlen;
+  assign out_arsize  = (rd_take_over) ? 3'b0 : in_arsize;
+  assign out_araddr  = (rd_take_over) ? 32'b0 : in_araddr;
+  assign in_arready  = (rd_take_over) ? 1'b0 : out_arready;
+
+  // ------------------------------------
+  // WRITE CHANNEL
+  // ------------------------------------
+  typedef enum logic [1:0] {
+    WR_IDLE  = 2'b00,
+    WR_TRANS = 2'b01,
+    WR_DELAY = 2'b10,
+    WR_RESP  = 2'b11
+  } wr_state_e;
+
+  wr_state_e wr_state_q;
+  wr_state_e wr_state_r;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      wr_state_q <= WR_IDLE;
+    end else begin
+      wr_state_q <= wr_state_r;
+    end
+  end
+
+  always @(*) begin
+    wr_state_r = wr_state_q;
+    case (wr_state_q)
+      WR_IDLE: begin
+        if (in_awvalid & in_awready) begin
+          wr_state_r = WR_TRANS;
+        end
+      end
+
+      WR_TRANS: begin
+        if (out_bvalid & wr_out_bready) begin
+          wr_state_r = WR_DELAY;
+        end
+      end
+
+      WR_DELAY: begin
+        if (wr_delay_done) begin
+          wr_state_r = WR_RESP;
+        end
+      end
+
+      WR_RESP: begin
+        if (wr_resp_done) begin
+          wr_state_r = WR_IDLE;
+        end
+      end
+    endcase
+  end
+
+  reg [31:0] wr_t1;
+  always @(posedge clock) begin
+    if (reset) begin
+      wr_t1 <= 32'b0;
+    end else begin
+      if (wr_state_q == WR_TRANS) begin
+        wr_t1 <= wr_t1 + 32'b1;
+      end else if (wr_state_q == WR_RESP & wr_resp_done) begin
+        wr_t1 <= 32'b0;
+      end
+    end
+  end
+
+  reg [31:0] wr_t1_x;
+  always @(posedge clock) begin
+    if (reset) begin
+      wr_t1_x <= 32'b0;
+    end else begin
+      if (wr_state_q == WR_TRANS || wr_state_q == WR_DELAY) begin
+        wr_t1_x <= wr_t1_x + 32'b1;
+      end else if (wr_state_q == WR_RESP && wr_resp_done) begin
+        wr_t1_x <= 32'b0;
+      end
+    end
+  end
+
+  wire wr_delay_done = ((rd_t1 * k_s) == (rd_t1_x * k));
+  wire wr_resp_done = in_bvalid_r & in_bready;
+  wire in_bvalid_r = (wr_state_q == WR_RESP);
+  assign in_bvalid = in_bvalid_r;
+  assign in_bresp  = 2'b0;
+
+  wire wr_take_over = (wr_state_q == WR_TRANS && wr_state_q == WR_RESP);
+  assign out_awvalid = (wr_take_over) ? 1'b0 : in_awvalid;
+  assign out_wvalid  = (wr_take_over) ? 1'b0 : in_wvalid;
+  assign out_wdata   = (wr_take_over) ? 32'b0 : in_wdata;
+  assign out_awsize  = (wr_take_over) ? 3'b0 : in_awsize;
+  assign out_wstrb   = (wr_take_over) ? 4'b0 : in_wstrb;
+  assign out_awaddr  = (wr_take_over) ? 32'b0 : in_awaddr;
+  assign out_awburst = (wr_take_over) ? 2'b0 : in_awburst;
+  assign out_wlast   = (wr_take_over) ? 1'b0 : in_wlast;
+
+  assign in_awready  = (wr_take_over) ? 1'b0 : out_awready;
+  assign in_wready   = (wr_take_over) ? 1'b0 : out_wready;
+
+  wire wr_out_bready = (wr_state_q == WR_TRANS);
+  assign out_bready = wr_out_bready;
+`endif
+
 endmodule
diff --git a/perip/bitrev/bitrev.v b/perip/bitrev/bitrev.v
index f1c3b363..40eaf438 100644
--- a/perip/bitrev/bitrev.v
+++ b/perip/bitrev/bitrev.v
@@ -4,5 +4,58 @@ module bitrev (
   input  mosi,
   output miso
 );
-  assign miso = 1'b1;
+  typedef enum logic [1:0] {
+    INPUT,
+    WAIT,
+    OUTPUT
+  } state_t;
+
+  reg [7:0] buffer;
+  reg [2:0] count;
+  reg [1:0] state;
+
+  initial begin
+    count = 0;
+  end
+
+  always @(posedge sck or posedge ss) begin
+    if(ss) begin
+      buffer <= 8'h00;
+      state <= INPUT;
+      count <= 3'b000;
+    end else begin
+      case(state[1:0])
+        WAIT:
+          state <= OUTPUT;
+
+        INPUT: begin
+          buffer[count] <= mosi;
+          count <= count + 1;
+          if(count == 3'b111) begin
+            state <= WAIT;
+            count <= 3'b000;
+          end
+        end
+
+        OUTPUT: begin
+          count <= count + 1;
+          if(count == 3'b111) begin
+            state <= INPUT;
+            count <= 3'b000;
+          end
+        end
+
+        default: begin
+          // synopsys translate_off
+          $stop();
+          // synopsys translate_on
+        end
+      endcase
+    end
+  end
+
+  wire buffer_out = buffer[7 - count];
+  assign miso = (ss == 1) ? 1 :
+                (state == OUTPUT) ? buffer_out :
+                1;
 endmodule
diff --git a/perip/flash/flash.v b/perip/flash/flash.v
index 480d7092..11c82155 100644
--- a/perip/flash/flash.v
+++ b/perip/flash/flash.v
@@ -11,7 +11,7 @@ module flash (
 );
   wire reset = ss;
 
-  typedef enum [2:0] { cmd_t, addr_t, data_t, err_t } state_t;
+  typedef enum logic [2:0] { cmd_t, addr_t, data_t, err_t } state_t;
   reg [2:0]  state;
   reg [7:0]  counter;
   reg [7:0]  cmd;
@@ -40,8 +40,10 @@ module flash (
 
