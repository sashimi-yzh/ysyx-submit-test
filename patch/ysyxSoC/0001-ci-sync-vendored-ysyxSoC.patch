+assign wb_sel_i = xip_master_sel ? xip_wb_sel   : in_pstrb;
+assign wb_we_i  = xip_master_sel ? xip_wb_we    : in_pwrite;
+assign wb_stb_i = xip_master_sel ? xip_wb_stb   : in_psel;
