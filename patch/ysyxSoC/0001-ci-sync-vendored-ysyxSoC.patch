+    XIP_RD_RX1: begin
+      xip_wb_adr = SPI_RX1_OFS;
+      xip_wb_we  = 1'b0;
+      xip_wb_stb = 1'b1;
+      xip_wb_cyc = 1'b1;
+    end
+    XIP_RD_RX0: begin
+      xip_wb_adr = SPI_RX0_OFS;
+      xip_wb_we  = 1'b0;
