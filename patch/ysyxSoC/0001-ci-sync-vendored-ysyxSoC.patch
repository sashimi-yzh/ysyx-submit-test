+          xip_req_valid <= 1'b1;
+          xip_addr <= in_paddr[23:0];
+          xip_state <= XIP_WR_DIV;
+        end
+      end
+      XIP_WR_DIV: begin
+        if (wb_ack_o) xip_state <= XIP_WR_SS;
+      end
+      XIP_WR_SS: begin
+        if (wb_ack_o) xip_state <= XIP_WR_TX1;
+      end
+      XIP_WR_TX1: begin
+        if (wb_ack_o) xip_state <= XIP_WR_TX0;
+      end
+      XIP_WR_TX0: begin
+        if (wb_ack_o) xip_state <= XIP_WR_CTRL_GO;
+      end
+      XIP_WR_CTRL_GO: begin
+        if (wb_ack_o) xip_state <= XIP_WAIT_IRQ;
+      end
+      XIP_WAIT_IRQ: begin
+        if (spi_irq_out) xip_state <= XIP_RD_RX1;
+      end
+      XIP_RD_RX1: begin
+        if (wb_ack_o) begin
+          xip_state <= XIP_RD_RX0;
+        end
+      end
+      XIP_RD_RX0: begin
+        if (wb_ack_o) begin
+          xip_rdata <= bswap32(wb_dat_o);
+          xip_state <= XIP_DONE;
+        end
+      end
+      XIP_DONE: begin
+        if (xip_resp_ready) begin
+          xip_req_valid <= 1'b0;
+          xip_state <= XIP_IDLE;
+        end
+      end
+      default: begin
+        xip_state <= XIP_IDLE;
+      end
+    endcase
+  end
+end
+
+`ifndef SYNTHESIS
+always @(posedge clock) begin
+  if (!reset && is_xip_write_req) begin
+    $fwrite(32'h80000002, "Assertion failed: write to flash XIP space addr=%x data=%x\n", in_paddr, in_pwdata);
