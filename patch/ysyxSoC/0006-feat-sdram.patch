 src/device/SDRAM.scala                       | 20 +++++--
 7 files changed, 55 insertions(+), 31 deletions(-)

diff --git a/perip/sdram/core_sdram_axi4/sdram_axi.v b/perip/sdram/core_sdram_axi4/sdram_axi.v
index e743eb16..1633352b 100644
--- a/perip/sdram/core_sdram_axi4/sdram_axi.v
+++ b/perip/sdram/core_sdram_axi4/sdram_axi.v
@@ -70,6 +70,7 @@ module sdram_axi
     ,output          sdram_clk_o
     ,output          sdram_cke_o
     ,output          sdram_cs_o
+    ,output          sdram_cs1_o
     ,output          sdram_ras_o
     ,output          sdram_cas_o
     ,output          sdram_we_o
@@ -178,6 +179,7 @@ u_core
     ,.sdram_clk_o(sdram_clk_o)
     ,.sdram_cke_o(sdram_cke_o)
     ,.sdram_cs_o(sdram_cs_o)
+    ,.sdram_cs1_o(sdram_cs1_o)
     ,.sdram_ras_o(sdram_ras_o)
     ,.sdram_cas_o(sdram_cas_o)
     ,.sdram_we_o(sdram_we_o)
diff --git a/perip/sdram/core_sdram_axi4/sdram_axi_core.v b/perip/sdram/core_sdram_axi4/sdram_axi_core.v
index ed254cca..a9e0e749 100644
--- a/perip/sdram/core_sdram_axi4/sdram_axi_core.v
+++ b/perip/sdram/core_sdram_axi4/sdram_axi_core.v
@@ -42,7 +42,7 @@ module sdram_axi_core
     ,input  [  7:0]  inport_len_i
     ,input  [ 31:0]  inport_addr_i
     ,input  [ 31:0]  inport_write_data_i
-    ,input  [ 31:0]  sdram_data_input_i
+    ,input  [SDRAM_DATA_W-1:0]  sdram_data_input_i
 
     // Outputs
     ,output          inport_accept_o
@@ -52,14 +52,15 @@ module sdram_axi_core
     ,output          sdram_clk_o
     ,output          sdram_cke_o
     ,output          sdram_cs_o
+    ,output          sdram_cs1_o
     ,output          sdram_ras_o
     ,output          sdram_cas_o
     ,output          sdram_we_o
-    ,output [  3:0]  sdram_dqm_o
-    ,output [ 12:0]  sdram_addr_o
-    ,output [  1:0]  sdram_ba_o
-    ,output [ 31:0]  sdram_data_output_o
-    ,output          sdram_data_out_en_o
+    ,output [SDRAM_DQM_W-1:0]  sdram_dqm_o
+    ,output [           12:0]  sdram_addr_o
+    ,output [            1:0]  sdram_ba_o
+    ,output [SDRAM_DATA_W-1:0]  sdram_data_output_o
+    ,output                    sdram_data_out_en_o
 );
 
 
@@ -162,8 +163,10 @@ wire [SDRAM_DATA_W-1:0] sdram_data_in_w;
 
 reg                    refresh_q;
 
-reg [SDRAM_BANKS-1:0]  row_open_q;
-reg [SDRAM_ROW_W-1:0]  active_row_q[0:SDRAM_BANKS-1];
+localparam SDRAM_WORD_GROUPS = 2;
+
+reg [SDRAM_BANKS-1:0]  row_open_q  [0:SDRAM_WORD_GROUPS-1];
+reg [SDRAM_ROW_W-1:0]  active_row_q[0:SDRAM_WORD_GROUPS-1][0:SDRAM_BANKS-1];
 
 reg  [STATE_W-1:0]     state_q;
 reg  [STATE_W-1:0]     next_state_r;
@@ -175,6 +178,7 @@ reg  [STATE_W-1:0]     delay_state_q;
 wire [SDRAM_ROW_W-1:0]  addr_col_w  = {{(SDRAM_ROW_W-SDRAM_COL_W){1'b0}}, ram_addr_w[SDRAM_COL_W:2], 1'b0};
 wire [SDRAM_ROW_W-1:0]  addr_row_w  = ram_addr_w[SDRAM_ADDR_W:SDRAM_COL_W+2+1];
 wire [SDRAM_BANK_W-1:0] addr_bank_w = ram_addr_w[SDRAM_COL_W+2:SDRAM_COL_W+2-1];
+wire                    addr_word_sel = ram_addr_w[SDRAM_ADDR_W];
 
 //-----------------------------------------------------------------
 // SDRAM State Machine
@@ -204,7 +208,7 @@ begin
         if (refresh_q)
         begin
             // Close open rows, then refresh
-            if (|row_open_q)
+            if (|row_open_q[0] | |row_open_q[1])
                 next_state_r = STATE_PRECHARGE;
             else
                 next_state_r = STATE_REFRESH;
@@ -215,7 +219,7 @@ begin
         else if (ram_req_w)
         begin
             // Open row hit
-            if (row_open_q[addr_bank_w] && addr_row_w == active_row_q[addr_bank_w])
+            if (row_open_q[addr_word_sel][addr_bank_w] && addr_row_w == active_row_q[addr_word_sel][addr_bank_w])
             begin
                 if (!ram_rd_w)
                     next_state_r = STATE_WRITE0;
@@ -223,7 +227,7 @@ begin
                     next_state_r = STATE_READ;
             end
             // Row miss, close row, open new row
-            else if (row_open_q[addr_bank_w])
+            else if (row_open_q[addr_word_sel][addr_bank_w])
             begin
                 next_state_r   = STATE_PRECHARGE;
 
@@ -270,7 +274,7 @@ begin
         if (!refresh_q && ram_req_w && ram_rd_w)
         begin
             // Open row hit
-            if (row_open_q[addr_bank_w] && addr_row_w == active_row_q[addr_bank_w])
+            if (row_open_q[addr_word_sel][addr_bank_w] && addr_row_w == active_row_q[addr_word_sel][addr_bank_w])
                 next_state_r = STATE_READ;
         end
     end
@@ -285,7 +289,7 @@ begin
         if (!refresh_q && ram_req_w && (ram_wr_w != 4'b0))
         begin
             // Open row hit
-            if (row_open_q[addr_bank_w] && addr_row_w == active_row_q[addr_bank_w])
+            if (row_open_q[addr_word_sel][addr_bank_w] && addr_row_w == active_row_q[addr_word_sel][addr_bank_w])
                 next_state_r = STATE_WRITE0;
         end
     end
@@ -352,7 +356,7 @@ begin
         if (!refresh_q && ram_req_w && ram_rd_w)
         begin
             // Open row hit
-            if (row_open_q[addr_bank_w] && addr_row_w == active_row_q[addr_bank_w])
+            if (row_open_q[addr_word_sel][addr_bank_w] && addr_row_w == active_row_q[addr_word_sel][addr_bank_w])
                 delay_r = 4'd0;
         end
     end
@@ -467,23 +471,24 @@ assign ram_read_data_w = rd_data_q;
 //-----------------------------------------------------------------
 // Command Output
 //-----------------------------------------------------------------
-integer idx;
+integer idx, idx2;
 
 always @ (posedge clk_i or posedge rst_i)
 if (rst_i)
 begin
     command_q       <= CMD_NOP;
-    data_q          <= 32'b0;
+    data_q          <= {SDRAM_DATA_W{1'b0}};
     addr_q          <= {SDRAM_ROW_W{1'b0}};
     bank_q          <= {SDRAM_BANK_W{1'b0}};
     cke_q           <= 1'b0;
     dqm_q           <= {SDRAM_DQM_W{1'b0}};
     data_rd_en_q    <= 1'b1;
 
-    for (idx=0;idx<SDRAM_BANKS;idx=idx+1)
-        active_row_q[idx] <= {SDRAM_ROW_W{1'b0}};
-
-    row_open_q      <= {SDRAM_BANKS{1'b0}};
+    for (idx=0;idx<SDRAM_WORD_GROUPS;idx=idx+1) begin
+        row_open_q[idx]   <= {SDRAM_BANKS{1'b0}};
+        for (idx2=0;idx2<SDRAM_BANKS;idx2=idx2+1)
+            active_row_q[idx][idx2] <= {SDRAM_ROW_W{1'b0}};
+    end
 end
 else
 begin
@@ -546,8 +551,8 @@ begin
         addr_q        <= addr_row_w;
         bank_q        <= addr_bank_w;
 
-        active_row_q[addr_bank_w]  <= addr_row_w;
-        row_open_q[addr_bank_w]    <= 1'b1;
+        active_row_q[addr_word_sel][addr_bank_w]  <= addr_row_w;
+        row_open_q[addr_word_sel][addr_bank_w]    <= 1'b1;
     end
     //-----------------------------------------
     // STATE_PRECHARGE
@@ -560,7 +565,8 @@ begin
             // Precharge all banks
             command_q           <= CMD_PRECHARGE;
             addr_q[ALL_BANKS]   <= 1'b1;
-            row_open_q          <= {SDRAM_BANKS{1'b0}};
+            for (idx=0;idx<SDRAM_WORD_GROUPS;idx=idx+1)
+                row_open_q[idx] <= {SDRAM_BANKS{1'b0}};
         end
         else
         begin
@@ -569,7 +575,7 @@ begin
             addr_q[ALL_BANKS]   <= 1'b0;
             bank_q              <= addr_bank_w;
 
-            row_open_q[addr_bank_w] <= 1'b0;
+            row_open_q[addr_word_sel][addr_bank_w] <= 1'b0;
         end
     end
     //-----------------------------------------
@@ -670,7 +676,8 @@ assign sdram_data_output_o   =  data_q;
 assign sdram_data_in_w       = sdram_data_input_i;
 
 assign sdram_cke_o  = cke_q;
-assign sdram_cs_o   = command_q[3];
+assign sdram_cs_o   = command_q[3] |  addr_word_sel;
+assign sdram_cs1_o  = command_q[3] | ~addr_word_sel;
 assign sdram_ras_o  = command_q[2];
 assign sdram_cas_o  = command_q[1];
 assign sdram_we_o   = command_q[0];
