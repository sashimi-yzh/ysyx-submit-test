diff --git a/src/SoC.scala b/src/SoC.scala
index e82b3ad1..1cf8f815 100644
--- a/src/SoC.scala
+++ b/src/SoC.scala
@@ -43,7 +43,7 @@ class ysyxSoCASIC(implicit p: Parameters) extends LazyModule {
   val lmrom = LazyModule(new AXI4MROM(AddressSet.misaligned(0x20000000, 0x1000)))
   val sramNode = AXI4RAM(AddressSet.misaligned(0x0f000000, 0x2000).head, false, true, 4, None, Nil, false)
 
-  val sdramAddressSet = AddressSet.misaligned(0xa0000000L, 0x2000000)
+  val sdramAddressSet = AddressSet.misaligned(0xa0000000L, 0x8000000)
   val lsdram_apb = if (!Config.sdramUseAXI) Some(LazyModule(new APBSDRAM (sdramAddressSet))) else None
   val lsdram_axi = if ( Config.sdramUseAXI) Some(LazyModule(new AXI4SDRAM(sdramAddressSet))) else None
 
diff --git a/src/device/SDRAM.scala b/src/device/SDRAM.scala
index 085703a7..dec79cd8 100644
--- a/src/device/SDRAM.scala
+++ b/src/device/SDRAM.scala
@@ -14,6 +14,7 @@ class SDRAMIO extends Bundle {
   val clk = Output(Bool())
   val cke = Output(Bool())
   val cs  = Output(Bool())
+  val cs1 = Output(Bool())
   val ras = Output(Bool())
   val cas = Output(Bool())
   val we  = Output(Bool())
@@ -211,11 +212,13 @@ class sdramChisel extends RawModule {
 
   val chip0 = Module(new sdramChip)
   val chip1 = Module(new sdramChip)
+  val chip2 = Module(new sdramChip)
+  val chip3 = Module(new sdramChip)
 
-  for (chip <- Seq(chip0, chip1)) {
+  for ((chip, cs) <- Seq((chip0, io.cs), (chip1, io.cs), (chip2, io.cs1), (chip3, io.cs1))) {
     chip.io.clk := io.clk
     chip.io.cke := io.cke
-    chip.io.cs  := io.cs
+    chip.io.cs  := cs
     chip.io.ras := io.ras
     chip.io.cas := io.cas
     chip.io.we  := io.we
@@ -225,16 +228,23 @@ class sdramChisel extends RawModule {
 
   chip0.io.dqm := io.dqm(1, 0)
   chip1.io.dqm := io.dqm(3, 2)
+  chip2.io.dqm := io.dqm(1, 0)
+  chip3.io.dqm := io.dqm(3, 2)
+
+  val doutA = Cat(chip1.io.dout, chip0.io.dout)
+  val doutB = Cat(chip3.io.dout, chip2.io.dout)
 
-  val dout   = Wire(UInt(32.W))
   val out_en = Wire(Bool())
+  val dout   = Wire(UInt(32.W))
   val din    = TriStateInBuf(io.dq, dout, out_en)
 
-  dout   := Cat(chip1.io.dout, chip0.io.dout)
-  out_en := chip0.io.out_en
+  dout   := Mux(io.cs1, doutA, doutB)
+  out_en := Mux(io.cs1, chip0.io.out_en, chip2.io.out_en)
 
   chip0.io.din := din(15, 0)
   chip1.io.din := din(31, 16)
+  chip2.io.din := din(15, 0)
+  chip3.io.din := din(31, 16)
 }
 
 class AXI4SDRAM(
