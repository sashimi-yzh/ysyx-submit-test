+// 定义参数结构体
+typedef struct {
+  void *tentry;
+  void *parameter;
+  void *texit;
+} WrapperArgs;
+// 包裹函数
+  static void wrapper_entry(void *arg) {
+    WrapperArgs *params = (WrapperArgs *)arg;
+
+    void (*entry_func)(void *) = (void (*)(void *))(params->tentry);
+    void (*exit_func)(void) = (void (*)(void))(params->texit);
+      
+    // 执行入口函数
+    entry_func(params->parameter);
+      
+    // 执行退出函数
+    exit_func();
+      
+    // 安全防护
+    while (1);
+  }
 rt_uint8_t *rt_hw_stack_init(void *tentry, void *parameter, rt_uint8_t *stack_addr, void *texit) {
-  assert(0);
-  return NULL;
+    // 对齐栈地址
+    uintptr_t aligned_stack = (uintptr_t)stack_addr;
+    aligned_stack &= ~0xF;
+
+    
+    uintptr_t args_addr = aligned_stack - sizeof(Context) - sizeof(WrapperArgs);
+    WrapperArgs *args = (WrapperArgs *)args_addr;
+    // WrapperArgs *args;
+    args->tentry = tentry;
+    args->parameter = parameter;
+    args->texit = texit;
+
+    // 设置 kcontext 的栈区域（确保覆盖参数和上下文）
+    Area kstack = {
+      .start = (void *)(aligned_stack - sizeof(WrapperArgs) - sizeof(Context)), // 栈起始地址
+      .end = (void *)aligned_stack // 栈结束地址（对齐后的栈顶）
+    };
+
+    // 调用 kcontext，使用包裹函数和参数指针
+    Context *c = kcontext(kstack, wrapper_entry, args);
+
+    return (rt_uint8_t *)c;
 }
