@@ -2,30 +2,155 @@
 #include <klib.h>
 #include <rtthread.h>
 
+// Context** ctx_from = NULL;
+int is_switch_to = 0;
+
 static Context* ev_handler(Event e, Context *c) {
+  // PCB
+  rt_thread_t current_thread = rt_thread_self();
+  // Context **temp_to = (Context **)(current_thread->user_data);
+
   switch (e.event) {
+    case EVENT_YIELD:
+       if (current_thread->ctx_to != NULL) {
+          // 获取目标上下文      
+          if(current_thread->ctx_from != NULL) {
+            *(current_thread->ctx_from) = c;
+          }     
+          Context *next = *(current_thread->ctx_to);   
+          return next;
+        }
+      break;
+    case EVENT_SYSCALL: 
+    case EVENT_PAGEFAULT: 
+    case EVENT_ERROR: 
+    case EVENT_IRQ_TIMER: 
+    case EVENT_IRQ_IODEV: return c;
     default: printf("Unhandled event ID = %d\n", e.event); assert(0);
   }
   return c;
 }
 
+
 void __am_cte_init() {
   cte_init(ev_handler);
 }
 
+//首次切换
 void rt_hw_context_switch_to(rt_ubase_t to) {
-  assert(0);
+  rt_thread_t current_thread = rt_thread_self();
+  rt_ubase_t temp_user_data = current_thread->user_data;  // 保存 user_data
+  //printf("current_thread->user_data = %ld\n", to);
+
+  current_thread->ctx_from = NULL; // 不需要保存
+  current_thread->user_data = to;
+  current_thread->ctx_to = (Context **)to;
+  is_switch_to = 1;
+  yield();
+
+  current_thread->user_data = temp_user_data;        // 恢复 user_data
 }
 
 void rt_hw_context_switch(rt_ubase_t from, rt_ubase_t to) {
-  assert(0);
+  rt_thread_t current_thread = rt_thread_self();
+  rt_ubase_t temp_user_data = current_thread->user_data;
+  //printf("current_thread->user_data = %ld\n", to);
+
+  current_thread->ctx_from = (Context**)from;
+  current_thread->ctx_to = (Context **)to;
+  current_thread->user_data = to;
+  is_switch_to = 0;
+  yield();
+
+  current_thread->user_data = temp_user_data;
 }
 
 void rt_hw_context_switch_interrupt(void *context, rt_ubase_t from, rt_ubase_t to, struct rt_thread *to_thread) {
   assert(0);
 }
 
