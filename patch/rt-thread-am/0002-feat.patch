 bsp/abstract-machine/src/context.c | 32 ++++++++++++++++++++++++++++--
 1 file changed, 30 insertions(+), 2 deletions(-)

diff --git a/bsp/abstract-machine/src/context.c b/bsp/abstract-machine/src/context.c
index 1f31eb4..11eeee5 100644
--- a/bsp/abstract-machine/src/context.c
+++ b/bsp/abstract-machine/src/context.c
@@ -4,7 +4,17 @@
 #include <rtthread.h>
 
 static Context *ev_handler(Event e, Context *c) {
+  rt_ubase_t *userData;
   switch (e.event) {
+  case EVENT_YIELD:
+    userData = (rt_ubase_t *)rt_thread_self()->user_data;
+    rt_ubase_t from = userData[0];
+    rt_ubase_t to = userData[1];
+    if (from) {
+      *((Context **)from) = c;
+    }
+    c = *(Context **)to;
+    break;
   default:
     printf("Unhandled event ID = %d\n", e.event);
     assert(0);
@@ -14,9 +24,27 @@ static Context *ev_handler(Event e, Context *c) {
 
 void __am_cte_init() { cte_init(ev_handler); }
 
-void rt_hw_context_switch_to(rt_ubase_t to) { assert(0); }
+void rt_hw_context_switch_to(rt_ubase_t to) {
+  rt_thread_t current = rt_thread_self();
+  rt_ubase_t data[2];
+  rt_ubase_t backup = (rt_ubase_t)current->user_data;
+  data[0] = 0;
+  data[1] = to;
+  current->user_data = (rt_ubase_t)data;
+  yield();
+  current->user_data = backup;
+}
 
-void rt_hw_context_switch(rt_ubase_t from, rt_ubase_t to) { assert(0); }
+void rt_hw_context_switch(rt_ubase_t from, rt_ubase_t to) {
+  rt_thread_t current = rt_thread_self();
+  rt_ubase_t data[2];
+  rt_ubase_t backup = (rt_ubase_t)current->user_data;
+  data[0] = from;
+  data[1] = to;
+  current->user_data = (rt_ubase_t)data;
+  yield();
+  current->user_data = backup;
+}
 
 void rt_hw_context_switch_interrupt(void *context, rt_ubase_t from,
                                     rt_ubase_t to,
-- 
