From 87fa5d55b8aa10bfb4dbeaa8452e1d87b99ba52a Mon Sep 17 00:00:00 2001
From: Runsen An <2634032821@qq.com>
Date: Tue, 2 Jun 2026 21:00:49 +0800
Subject: [PATCH 4/5] Modify the ld files

---
 bsp/abstract-machine/Makefile         |  2 -
 bsp/abstract-machine/extra.ld         | 45 ---------------------
 bsp/abstract-machine/extra_ysyxsoc.ld | 57 ---------------------------
 3 files changed, 104 deletions(-)
 delete mode 100644 bsp/abstract-machine/extra.ld
 delete mode 100644 bsp/abstract-machine/extra_ysyxsoc.ld

diff --git a/bsp/abstract-machine/Makefile b/bsp/abstract-machine/Makefile
index 96ecce089..168943321 100644
--- a/bsp/abstract-machine/Makefile
+++ b/bsp/abstract-machine/Makefile
@@ -8,8 +8,6 @@ NAME = rtthread
 SRCS = $(shell find src -name "*.c")
 CFLAGS += -DHAVE_CCONFIG_H -D__RTTHREAD__
 CFLAGS += -Wno-nonnull-compare
-LDFLAGS += -T extra.ld
-# LDFLAGS += -T extra_ysyxsoc.ld
 
 -include $(FILE_MK)
 -include $(AM_APPS_MK)
diff --git a/bsp/abstract-machine/extra.ld b/bsp/abstract-machine/extra.ld
deleted file mode 100644
index 5cdc65670..000000000
--- a/bsp/abstract-machine/extra.ld
+++ /dev/null
@@ -1,45 +0,0 @@
-SECTIONS {
-  .data.extra : {
-    /* section information for finsh shell */
-    __fsymtab_start = .;
-    KEEP(*(FSymTab))
-    __fsymtab_end = .;
-    . = ALIGN(8);
-    __vsymtab_start = .;
-    KEEP(*(VSymTab))
-    __vsymtab_end = .;
-    . = ALIGN(8);
-
-    /* section information for initial. */
-    . = ALIGN(8);
-    __rt_init_start = .;
-    KEEP(*(SORT(.rti_fn*)))
-    __rt_init_end = .;
-    . = ALIGN(8);
-
-    __rt_utest_tc_tab_start = .;
-    KEEP(*(UtestTcTab))
-    __rt_utest_tc_tab_end = .;
-
-    . = ALIGN(8);
-    __am_apps_data_start = .;
-    *(__am_apps.data*)
-    *(__am_apps.sdata*)
-    __am_apps_data_end = .;
-    . = ALIGN(8);
-  }
-}
-INSERT BEFORE .data;
-
-SECTIONS {
-  .bss.extra : {
-    . = ALIGN(8);
-    __am_apps_bss_start = .;
-    *(__am_apps.bss*)
-    *(__am_apps.sbss*)
-    *(__am_apps.scommon*)
-    __am_apps_bss_end = .;
-    . = ALIGN(8);
-  }
-}
-INSERT BEFORE .bss;
diff --git a/bsp/abstract-machine/extra_ysyxsoc.ld b/bsp/abstract-machine/extra_ysyxsoc.ld
deleted file mode 100644
index 697294d82..000000000
--- a/bsp/abstract-machine/extra_ysyxsoc.ld
+++ /dev/null
@@ -1,57 +0,0 @@
-MEMORY {
-  mrom : ORIGIN = 0x20000000, LENGTH = 4K
-  flash : ORIGIN = 0x30000000, LENGTH = 16M
-  psram : ORIGIN = 0x80000000, LENGTH = 4M
-  sram : ORIGIN = 0x0f000000, LENGTH = 8K
-  sdram : ORIGIN = 0xa0000000, LENGTH = 32M
-}
-
-SECTIONS {
-  .data.extra : ALIGN(8){
-    /* section information for finsh shell */
-    __fsymtab_start = .;
-    KEEP(*(FSymTab))
-    __fsymtab_end = .;
-    . = ALIGN(8);
-    __vsymtab_start = .;
-    KEEP(*(VSymTab))
-    __vsymtab_end = .;
-    . = ALIGN(8);
-
-    /* section information for initial. */
-    . = ALIGN(8);
-    __rt_init_start = .;
-    KEEP(*(SORT(.rti_fn*)))
-    __rt_init_end = .;
-    . = ALIGN(8);
-
-    __rt_utest_tc_tab_start = .;
-    KEEP(*(UtestTcTab))
-    __rt_utest_tc_tab_end = .;
-
-    . = ALIGN(8);
-    __am_apps_data_start = .;
-    *(__am_apps.data*)
-    *(__am_apps.sdata*)
-    __am_apps_data_end = .;
-    . = ALIGN(8);
-  } > sdram AT > flash :data
-
-  _data_extra_lma = LOADADDR(.data.extra);
-}
-INSERT BEFORE .data;
-
-SECTIONS {
-  .bss.extra : ALIGN(8){
-    . = ALIGN(8);
-    __am_apps_bss_start = .;
-    *(__am_apps.bss*)
-    *(__am_apps.sbss*)
-    *(__am_apps.scommon*)
-    __am_apps_bss_end = .;
-    . = ALIGN(8);
-  } > sdram AT > flash :bss
-
-  _bss_extra_lma = LOADADDR(.bss.extra);
-}
-INSERT BEFORE .bss;
