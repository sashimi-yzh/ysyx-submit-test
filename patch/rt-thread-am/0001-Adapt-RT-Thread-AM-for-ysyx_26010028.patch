diff --git a/bsp/abstract-machine/src/context.c b/bsp/abstract-machine/src/context.c
index ee38829ae..d56476dea 100644
--- a/bsp/abstract-machine/src/context.c
+++ b/bsp/abstract-machine/src/context.c
@@ -2,30 +2,75 @@
 #include <klib.h>
 #include <rtthread.h>
 
-static Context* ev_handler(Event e, Context *c) {
-  switch (e.event) {
-    default: printf("Unhandled event ID = %d\n", e.event); assert(0);
+typedef struct{
+  void (*tentry)(void *);
+  void *parameter;
+  void (*texit)(void);
+}thread_args;
+
+static Context **thread_from=NULL;
+static Context **thread_to=NULL;
+
+static void thread_entry_wrapper(void *args){
+  thread_args *thread_info=(thread_args *)args;
+  thread_info->tentry(thread_info->parameter);
+  thread_info->texit();
+}
+
+static Context* ev_handler(Event e,Context *c){
+  switch(e.event){
+    case EVENT_YIELD:
+    if(thread_from!=NULL){
+      *thread_from=c;
+    }
+    assert(thread_to!=NULL);
+    return *thread_to;
+    case EVENT_IRQ_TIMER:
+      return c;
+    default:
+      printf("This is a undefined evet, the ID is %d\n",e.event);
+      assert(0);
   }
   return c;
 }
 
-void __am_cte_init() {
+void __am_cte_init(){
   cte_init(ev_handler);
 }
 
 void rt_hw_context_switch_to(rt_ubase_t to) {
-  assert(0);
+  thread_from=NULL;
+  thread_to= (Context **)to;
+  yield();
 }
 
 void rt_hw_context_switch(rt_ubase_t from, rt_ubase_t to) {
-  assert(0);
+  thread_from= (Context **)from;
+  thread_to= (Context **)to;
+  yield();
 }
 
 void rt_hw_context_switch_interrupt(void *context, rt_ubase_t from, rt_ubase_t to, struct rt_thread *to_thread) {
-  assert(0);
+  thread_from=(Context **)from;
+  thread_to= (Context **)to;
+  yield();
 }
 
 rt_uint8_t *rt_hw_stack_init(void *tentry, void *parameter, rt_uint8_t *stack_addr, void *texit) {
-  assert(0);
-  return NULL;
+  uintptr_t top = (uintptr_t)stack_addr;
+  top &= ~(sizeof(uintptr_t) - 1);
+
+  top -= sizeof(thread_args);
+  thread_args *args = (thread_args*)top;
+  args->tentry = (void (*)(void *))tentry;
+  args->parameter = parameter;
+  args->texit = (void (*)(void))texit;
+
+  Area kstack = {
+    .start = (void *)((uintptr_t)stack_addr - 4096),
+    .end = (void *)top,
+  };
+
+  Context *cp = kcontext(kstack, thread_entry_wrapper, args);
+  return (rt_uint8_t *)cp;
 }
