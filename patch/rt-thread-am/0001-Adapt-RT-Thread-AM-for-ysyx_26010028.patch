   putch(c);
   return 1;
 }
 
+static int am_uart_getc_nonblock(void) {
+  AM_UART_RX_T rx;
+
+  /*
+   * 这里必须用 ioe_read(reg, buf)。
+   * 你当前 AM 里面没有 io_read(reg) 这种返回结构体的接口。
+   */
+  ioe_read(AM_UART_RX, &rx);
+
+  if (rx.data == 0xff) {
+    return -1;
+  }
+
+  if (rx.data == '\r') {
+    return '\n';
+  }
+
+  return (int)rx.data;
+}
+
 static int _uart_getc(struct rt_serial_device *serial) {
-  static const char *p = "help\ndate\nversion\nfree\nps\npwd\nls\nmemtrace\nmemcheck\nutest_list\n";
-  return (*p != '\0' ? *(p ++) : -1);
+  (void)serial;
+
+  /*
+   * 启动后自动执行的命令。
+   * 如果你不想自动执行命令，可以改成：
+   * static const char *p = "";
+   */
+  static const char *p =
+      "help\n"
+      "date\n"
+      "version\n"
+      "free\n"
+      "ps\n"
+      "pwd\n"
+      "ls\n"
+      "memtrace\n"
+      "memcheck\n"
+      "utest_list\n";
+
+  if (*p != '\0') {
+    return *(p++);
+  }
+
+  /*
+   * 内置命令执行完后，从真实 UART RX 读取用户输入。
+   */
+  return am_uart_getc_nonblock();
 }
 
