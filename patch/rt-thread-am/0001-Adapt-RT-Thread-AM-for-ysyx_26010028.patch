diff --git a/bsp/abstract-machine/Makefile b/bsp/abstract-machine/Makefile
index 8d70f310b..1582b2be9 100644
--- a/bsp/abstract-machine/Makefile
+++ b/bsp/abstract-machine/Makefile
@@ -1,40 +1,82 @@
 ARCH ?= native
-AM_APPS_MK = build/${ARCH}/am-apps.mk
+CROSS_COMPILE ?= riscv64-linux-gnu-
+
+AM_APPS_C  = build/am-apps.c
+AM_APPS_MK = build/$(ARCH)/am-apps.mk
+
 FILE_MK = files.mk
 FILE_TMP = .tmp.$(FILE_MK)
 RTCONFIG_H = rtconfig.h
 
 NAME = rtthread
 SRCS = $(shell find src -name "*.c")
+
 CFLAGS += -DHAVE_CCONFIG_H -D__RTTHREAD__
 CFLAGS += -Wno-nonnull-compare
+
 LDFLAGS += -T extra.ld
+
+# ============================================================
+# Auto-generate AM apps integration files
+# ============================================================
+# integrate-am-apps.py 会同时生成：
+#   build/am-apps.c
+#   build/$(ARCH)/am-apps.mk
+#
+# 原来的问题是 Makefile 只知道怎么生成 am-apps.mk，
+# 但是不知道怎么生成 build/am-apps.c。
+# run-flash 过程中 build 目录被清理后，
+# build/am-apps.c 消失，于是编译 am-apps.o 时就报：
+#   No rule to make target 'build/am-apps.c'
+# ============================================================
+
+ifneq ($(filter clean,$(MAKECMDGOALS)),clean)
+
+update: $(AM_APPS_C) $(AM_APPS_MK)
+	@printf '[rt-thread][apps] ready arch=%s source=%s manifest=%s\n' '$(ARCH)' '$(AM_APPS_C)' '$(AM_APPS_MK)'
+
+$(AM_APPS_C) $(AM_APPS_MK): integrate-am-apps.py
+	@printf '[rt-thread][apps] generating arch=%s cross_compile=%s\n' '$(ARCH)' '$(CROSS_COMPILE)'
+	@mkdir -p build/$(ARCH)
+	@python3 $< ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE)
+	@printf '[rt-thread][apps] generated source=%s manifest=%s\n' '$(AM_APPS_C)' '$(AM_APPS_MK)'
+
+# AM_HOME/Makefile 会把 build/am-apps.c 编译成：
+#   build/$(ARCH)/build/am-apps.o
+# 所以这里显式告诉 make：这个目标依赖 build/am-apps.c。
+build/$(ARCH)/build/am-apps.o: $(AM_APPS_C)
+
+endif
+
+# ============================================================
+# Include generated source lists
+# ============================================================
+
 -include $(FILE_MK)
 -include $(AM_APPS_MK)
+
 include $(AM_HOME)/Makefile
 
 $(RTCONFIG_H):
+	@printf '[rt-thread][config] generating from=.config output=%s\n' '$(RTCONFIG_H)'
 	touch $@
 	scons --useconfig=.config
 	if [ "`sed -n '3p' $@`"x = x ]; then sed -i -e '2a#include "extra.h"' $@; fi
+	@printf '[rt-thread][config] ready output=%s\n' '$(RTCONFIG_H)'
 
 init: $(RTCONFIG_H)
+	@printf '[rt-thread][init] scanning sources arch=%s\n' '$(ARCH)'
 	scons -c
 	scons --verbose -n > $(FILE_TMP)
 	cat $(FILE_TMP) | grep -o '[^ ]*.c$$' | awk '{print "SRCS += " $$1}' > $(FILE_MK)
 	cat $(FILE_TMP) | grep 'gcc ' | head -n 1 | grep -o " -I[^ ]*" | awk '{print "CFLAGS += " $$1}' >> $(FILE_MK)
 	rm $(FILE_TMP)
+	@printf '[rt-thread][init] ready manifest=%s sources=%s include_groups=%s\n' '$(FILE_MK)' "$$(grep -c '^SRCS +=' '$(FILE_MK)')" "$$(grep -c '^CFLAGS +=' '$(FILE_MK)')"
 
 menuconfig:
+	@printf '[rt-thread][config] opening menuconfig\n'
 	scons --menuconfig
 	scons --genconfig
 	$(MAKE) init
 
-ifneq ($(MAKECMDGOALS),clean)
-update: $(AM_APPS_MK)
-$(AM_APPS_MK): integrate-am-apps.py
-	mkdir -p $(@D)
-	python3 $^ ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE)
-endif
-
 .PHONY: init menuconfig update
