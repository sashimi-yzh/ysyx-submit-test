diff --git a/bsp/abstract-machine/src/context.c b/bsp/abstract-machine/src/context.c
index ee38829ae..def3d0a58 100644
--- a/bsp/abstract-machine/src/context.c
+++ b/bsp/abstract-machine/src/context.c
@@ -2,8 +2,22 @@
 #include <klib.h>
 #include <rtthread.h>
 
+typedef struct {
+  Context **from, **to;
+} switch_args_t;
+
 static Context* ev_handler(Event e, Context *c) {
   switch (e.event) {
+    case EVENT_IRQ_TIMER: break;
+    case EVENT_IRQ_IODEV: break;
+    case EVENT_YIELD: {
+      switch_args_t *switch_args = (switch_args_t *)rt_thread_self()->user_data;
+      if (switch_args->from) {
+        *switch_args->from = c;
+      }
+      assert(switch_args->to);
+      return *switch_args->to;
+    }
     default: printf("Unhandled event ID = %d\n", e.event); assert(0);
   }
   return c;
@@ -13,19 +27,49 @@ void __am_cte_init() {
   cte_init(ev_handler);
 }
 
+void rt_hw_context_switch(rt_ubase_t from, rt_ubase_t to) {
+  rt_thread_t cur = rt_thread_self();
+  rt_ubase_t tmp = cur->user_data;
+  switch_args_t switch_args = {.from = (Context **)from, .to = (Context **)to};
+  cur->user_data = (rt_ubase_t)&switch_args;
+  yield();
+  cur->user_data = tmp;
+}
+
 void rt_hw_context_switch_to(rt_ubase_t to) {
-  assert(0);
+  rt_hw_context_switch((rt_ubase_t)NULL, to);
 }
 
-void rt_hw_context_switch(rt_ubase_t from, rt_ubase_t to) {
+// void rt_hw_context_switch_interrupt(void *context, rt_ubase_t from, rt_ubase_t to, struct rt_thread *to_thread) {
+//   assert(0);
+// }
+void rt_hw_context_switch_interrupt(rt_ubase_t from, rt_ubase_t to, rt_thread_t from_thread, rt_thread_t to_thread) {
   assert(0);
 }
 
-void rt_hw_context_switch_interrupt(void *context, rt_ubase_t from, rt_ubase_t to, struct rt_thread *to_thread) {
-  assert(0);
+typedef struct {
+  void (*tentry)(void *);
+  void *parameter; 
+  void (*texit)(void);
+} pw_args_t;
+
+static void process_wrapper(void *args) {
+  pw_args_t *pw_args = (pw_args_t *)args;
+  pw_args->tentry(pw_args->parameter);
+  pw_args->texit();
 }
 
 rt_uint8_t *rt_hw_stack_init(void *tentry, void *parameter, rt_uint8_t *stack_addr, void *texit) {
-  assert(0);
-  return NULL;
+  uintptr_t sta_addr = (uintptr_t)(stack_addr) & ~(sizeof(uintptr_t) - 1);
+  sta_addr -= sizeof(pw_args_t);
+  pw_args_t *pw_args = (pw_args_t *)sta_addr;
+  pw_args->tentry = tentry;
+  pw_args->parameter = parameter;
+  pw_args->texit = texit;
+
+  sta_addr = (uintptr_t)(sta_addr) & ~(sizeof(uintptr_t) - 1);
+  Context *ctx = kcontext((Area){.start = 0u, .end = (void *)sta_addr}, 
+      process_wrapper, pw_args);
+  
+  return (rt_uint8_t *)ctx;
 }
