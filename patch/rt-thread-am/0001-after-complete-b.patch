diff --git a/bsp/abstract-machine/src/context.c b/bsp/abstract-machine/src/context.c
index ee38829ae..fb9583fd7 100644
--- a/bsp/abstract-machine/src/context.c
+++ b/bsp/abstract-machine/src/context.c
@@ -1,12 +1,28 @@
 #include <am.h>
 #include <klib.h>
 #include <rtthread.h>
-
+static Context** boot_to=NULL;
 static Context* ev_handler(Event e, Context *c) {
-  switch (e.event) {
-    default: printf("Unhandled event ID = %d\n", e.event); assert(0);
-  }
-  return c;
+    switch (e.event) {
+        case EVENT_YIELD:{
+            rt_thread_t rt=rt_thread_self();
+            if(boot_to!=NULL){
+                Context * tmp=*boot_to;
+                boot_to=NULL;
+                return tmp;
+            }
+            rt_ubase_t *switchdata=(rt_ubase_t*)rt->user_data;
+            Context** boot_from=(Context**)(switchdata[0]);
+            if(boot_from!=NULL){
+                *boot_from=c;
+            }
+            boot_from=NULL;
+            return *(Context**)switchdata[1];
+            }
+        case EVENT_IRQ_TIMER:break;
+        default: printf("Unhandled event ID = %d\n", e.event); assert(0);
+    }
+    return c;
 }
 
 void __am_cte_init() {
@@ -14,18 +30,43 @@ void __am_cte_init() {
 }
 
 void rt_hw_context_switch_to(rt_ubase_t to) {
-  assert(0);
+    boot_to=(Context**)to;
+    yield();
 }
 
 void rt_hw_context_switch(rt_ubase_t from, rt_ubase_t to) {
-  assert(0);
+    rt_thread_t rt=rt_thread_self();
+    rt_ubase_t tmp=rt->user_data;    
+    rt_ubase_t switchdata[2]={from,to};
+    rt->user_data=(rt_ubase_t)switchdata;
+    yield();
+    rt->user_data=tmp;
 }
 
 void rt_hw_context_switch_interrupt(void *context, rt_ubase_t from, rt_ubase_t to, struct rt_thread *to_thread) {
   assert(0);
 }
-
+struct wrapper_data{
+    void *tentry;
+    void *parameter;
+    void *texit;
+};
+static void wrapper(void *wrapper_arg){
+    struct wrapper_data *arg=(struct wrapper_data*)wrapper_arg;
+    void (*entry_f)(void *)=(void(*)(void *))(arg->tentry); 
+    void (*exit_f)()=(void (*)())(arg->texit);
+    entry_f(arg->parameter);
+    exit_f();
+}
 rt_uint8_t *rt_hw_stack_init(void *tentry, void *parameter, rt_uint8_t *stack_addr, void *texit) {
-  assert(0);
-  return NULL;
+    uintptr_t stack_end=(uintptr_t)stack_addr;
+    stack_end=stack_end&(~(sizeof(uintptr_t)-1));
+    struct wrapper_data* wrapper_arg=(struct wrapper_data*)(stack_end-sizeof(struct wrapper_data));
+    wrapper_arg->tentry=tentry;
+    wrapper_arg->parameter=parameter;
+    wrapper_arg->texit=texit;
+    Area area_arg;
+    area_arg.end=(void*)wrapper_arg;
+    Context *cp=kcontext(area_arg,wrapper,wrapper_arg);
+    return (rt_uint8_t*)cp;
 }
diff --git a/bsp/abstract-machine/src/uart.c b/bsp/abstract-machine/src/uart.c
index e4eb86689..0f0ca8bc0 100644
--- a/bsp/abstract-machine/src/uart.c
+++ b/bsp/abstract-machine/src/uart.c
@@ -11,6 +11,7 @@
 #include <rtthread.h>
 #include <am.h>
 #include <klib.h>
+#include<klib-macros.h>
 
 #define UART_DEFAULT_BAUDRATE 115200
 
@@ -37,8 +38,19 @@ static int _uart_putc(struct rt_serial_device *serial, char c) {
 }
 
 static int _uart_getc(struct rt_serial_device *serial) {
-  static const char *p = "help\ndate\nversion\nfree\nps\npwd\nls\nmemtrace\nmemcheck\nutest_list\n";
-  return (*p != '\0' ? *(p ++) : -1);
+#if defined(__ISA_NATIVE__)
+    AM_UART_RX_T rx=io_read(AM_UART_RX);
+    return rx.data;
+#else
+    static const char *p = "help\ndate\nversion\nfree\nps\npwd\nls\nmemtrace\nmemcheck\nutest_list\n";
+    if(*p!='\0') return *(p++);
+#endif
+#if defined(__PLATFORM_YSYXSOC)
+    AM_UART_RX_T rx = io_read(AM_UART_RX);
+    return rx.data == 0xff ? -1 : rx.data;
+#else
+    return -1;
+#endif
 }
 
