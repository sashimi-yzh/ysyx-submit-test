 if len(sys.argv) != 3:
diff --git a/bsp/abstract-machine/src/context.c b/bsp/abstract-machine/src/context.c
index ee38829ae..25d696b1f 100644
--- a/bsp/abstract-machine/src/context.c
+++ b/bsp/abstract-machine/src/context.c
@@ -2,8 +2,38 @@
 #include <klib.h>
 #include <rtthread.h>
 
+static rt_ubase_t rt_from;
+static rt_ubase_t rt_to;
+static bool is_rt_to = false;
+
+struct stack_args{
+  void *tentry;
+  void *parameter;
+  void *texit;
+};
+
+static void __am_twrap(void *arg) {
+  struct stack_args *args = (struct stack_args *)arg;
+  ((void (*)(void *))args->tentry)(args->parameter);
+  ((void (*)(void))args->texit)();
+
+  while (1);
+}
+
 static Context* ev_handler(Event e, Context *c) {
   switch (e.event) {
+    case EVENT_YIELD:
+      if (rt_from != 0) {
+        *(Context **)rt_from = c;
+        rt_from = 0;
+      }
+      
+      if (rt_to != 0) {
+        Context *next_ctx = *(Context **)rt_to;
+        rt_to = 0;
+        return next_ctx;
+      }
+      break;
     default: printf("Unhandled event ID = %d\n", e.event); assert(0);
   }
   return c;
@@ -13,12 +43,17 @@ void __am_cte_init() {
   cte_init(ev_handler);
 }
 
-void rt_hw_context_switch_to(rt_ubase_t to) {
-  assert(0);
+ void rt_hw_context_switch_to(rt_ubase_t to) {
+  rt_to = to;
+  is_rt_to = true;
+  yield();
 }
 
 void rt_hw_context_switch(rt_ubase_t from, rt_ubase_t to) {
-  assert(0);
+  rt_from = from;
+  rt_to = to;
+  is_rt_to = false;
+  yield();
 }
 
 void rt_hw_context_switch_interrupt(void *context, rt_ubase_t from, rt_ubase_t to, struct rt_thread *to_thread) {
@@ -26,6 +61,19 @@ void rt_hw_context_switch_interrupt(void *context, rt_ubase_t from, rt_ubase_t t
 }
 
 rt_uint8_t *rt_hw_stack_init(void *tentry, void *parameter, rt_uint8_t *stack_addr, void *texit) {
-  assert(0);
-  return NULL;
+  uintptr_t aligned_addr = (uintptr_t)stack_addr & ~(sizeof(uintptr_t) - 1);
+  aligned_addr -= sizeof(struct stack_args);
+  struct stack_args *args = (struct stack_args *)aligned_addr;
+
+  args->tentry = tentry;
+  args->parameter = parameter;
+  args->texit = texit;
+
+  Area kstack = (Area){
+    .start = stack_addr - 4096,
+    .end   = (void *)aligned_addr
+  };
+
+  Context *ctx = kcontext(kstack, __am_twrap, args);
+  return (rt_uint8_t *)ctx;
 }
diff --git a/bsp/abstract-machine/src/uart.c b/bsp/abstract-machine/src/uart.c
index e4eb86689..02f519f47 100644
--- a/bsp/abstract-machine/src/uart.c
+++ b/bsp/abstract-machine/src/uart.c
@@ -38,7 +38,17 @@ static int _uart_putc(struct rt_serial_device *serial, char c) {
 
 static int _uart_getc(struct rt_serial_device *serial) {
   static const char *p = "help\ndate\nversion\nfree\nps\npwd\nls\nmemtrace\nmemcheck\nutest_list\n";
-  return (*p != '\0' ? *(p ++) : -1);
+  if (*p != '\0') return *p++;
+  else {
+#ifndef CONFIG_SOC
+    AM_UART_RX_T uart_rx;
+    ioe_read(AM_UART_RX, &uart_rx);
+    return uart_rx.data;
+#else
+    // asm volatile("mv a0, %0; ebreak" : :"r"(0));
+    return -1;
+#endif
+  }
 }
 
 const struct rt_uart_ops _uart_ops = {
