From 10dfb43665cfe57b82b3cd71152d92e66f24298b Mon Sep 17 00:00:00 2001
From: "24110012-Wang, Yuan" <hallo_sun@hotmail.com>
Date: Wed, 18 Nov 2026 21:49:32 +0800
Subject: [PATCH 10/13] [uart] update uart default input

The uart of rt-thread expect -1 for no data.

Signed-off-by: 24110012-Wang, Yuan <hallo_sun@hotmail.com>
---
 bsp/abstract-machine/src/uart.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/bsp/abstract-machine/src/uart.c b/bsp/abstract-machine/src/uart.c
index 97bf8b39d..69206386d 100644
--- a/bsp/abstract-machine/src/uart.c
+++ b/bsp/abstract-machine/src/uart.c
@@ -39,7 +39,9 @@ static int _uart_putc(struct rt_serial_device *serial, char c) {
 static int _uart_getc(struct rt_serial_device *serial) {
   //static const char *p = "help\ndate\nversion\nfree\nps\npwd\nls\nmemtrace\nmemcheck\nutest_list\n";
   //return (*p != '\0' ? *(p ++) : -1);
-  return getch();
+  // getch() returns 0xff when no data; rt-thread serial expects -1
+  char ch = getch();
+  return ch == (char)0xff ? -1 : (unsigned char)ch;
 }
 
 const struct rt_uart_ops _uart_ops = {
-- 
2.34.1

