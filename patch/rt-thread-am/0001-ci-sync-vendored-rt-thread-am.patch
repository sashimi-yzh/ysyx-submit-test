--- a/bsp/abstract-machine/src/uart.c
+++ b/bsp/abstract-machine/src/uart.c
@@ -11,6 +11,7 @@
 #include <rtthread.h>
 #include <am.h>
 #include <klib.h>
+#include <klib-macros.h>
 
 #define UART_DEFAULT_BAUDRATE 115200
 
@@ -38,7 +39,14 @@ static int _uart_putc(struct rt_serial_device *serial, char c) {
 
 static int _uart_getc(struct rt_serial_device *serial) {
   static const char *p = "help\ndate\nversion\nfree\nps\npwd\nls\nmemtrace\nmemcheck\nutest_list\n";
-  return (*p != '\0' ? *(p ++) : -1);
+  if (*p != '\0') {
+    return *(p ++);
+  }
+
+  AM_UART_RX_T rx = io_read(AM_UART_RX);
+  uint8_t data = (uint8_t)rx.data;
+  // IOE uses 0xff as "no data"; RT-Thread serial getc uses -1 for that.
+  return (data == 0xffu) ? -1 : (int)data;
 }
 
 const struct rt_uart_ops _uart_ops = {
