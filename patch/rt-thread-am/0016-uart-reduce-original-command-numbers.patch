From 9a81c4a6967eb476a4a990c9785cb115e4fd39a6 Mon Sep 17 00:00:00 2001
From: "24110012-Wang, Yuan" <hallo_sun@hotmail.com>
Date: Sun, 22 Nov 2026 12:36:09 +0800
Subject: [PATCH] [uart] reduce original command numbers

Signed-off-by: 24110012-Wang, Yuan <hallo_sun@hotmail.com>
---
 bsp/abstract-machine/src/uart.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bsp/abstract-machine/src/uart.c b/bsp/abstract-machine/src/uart.c
index 90c7711d9..828712498 100644
--- a/bsp/abstract-machine/src/uart.c
+++ b/bsp/abstract-machine/src/uart.c
@@ -38,7 +38,7 @@ static int _uart_putc(struct rt_serial_device *serial, char c) {
 
 static int _uart_getc(struct rt_serial_device *serial) {
   // feed the preset commands first, then switch to manual input
-  static const char *p = "help\ndate\nversion\nfree\nps\npwd\nls\nmemtrace\nmemcheck\nutest_list\nam_hello\n";
+  static const char *p = "help\ndate\nversion\nfree\nps\npwd\nls\n";
   if (*p != '\0') return *(p ++);
   // getch() returns 0xff when no data; rt-thread serial expects -1
   char ch = getch();
-- 
