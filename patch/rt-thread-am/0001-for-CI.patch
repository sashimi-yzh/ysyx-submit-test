 #define rewinddir rt_rewinddir
-#define closedir  rt_closedir
-#define chdir     rt_chdir
-#define access    rt_access
-#define setcwd    rt_setcwd
-#define getcwd    rt_getcwd
+#define closedir rt_closedir
+#define chdir rt_chdir
