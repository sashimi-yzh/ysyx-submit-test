From 844e7e0ea62abc217060859e97182e9e005138fd Mon Sep 17 00:00:00 2001
From: FZ_XiaoXi <FZXiaoxi@outlook.com>
Date: Sat, 22 Aug 2026 10:37:52 +0800
Subject: [PATCH 4/4] Ready CI

---
 bsp/abstract-machine/Makefile                 |  5 ++
 bsp/abstract-machine/extra.ld                 |  8 ++--
 .../extra_riscv32e-ysyxsoc.ld                 | 48 +++++++++++++++++++
 bsp/abstract-machine/src/init.c               |  3 ++
 4 files changed, 59 insertions(+), 5 deletions(-)
 create mode 100644 bsp/abstract-machine/extra_riscv32e-ysyxsoc.ld

diff --git a/bsp/abstract-machine/Makefile b/bsp/abstract-machine/Makefile
index 8d70f310b..615e0c307 100644
--- a/bsp/abstract-machine/Makefile
+++ b/bsp/abstract-machine/Makefile
@@ -8,7 +8,12 @@ NAME = rtthread
 SRCS = $(shell find src -name "*.c")
 CFLAGS += -DHAVE_CCONFIG_H -D__RTTHREAD__
 CFLAGS += -Wno-nonnull-compare
+ifeq ($(ARCH),riscv32e-ysyxsoc)
+LDFLAGS += -T extra_riscv32e-ysyxsoc.ld
+CFLAGS  += -DUSE_RV32E_YSYXSOC
+else
 LDFLAGS += -T extra.ld
+endif
 -include $(FILE_MK)
 -include $(AM_APPS_MK)
 include $(AM_HOME)/Makefile
diff --git a/bsp/abstract-machine/extra.ld b/bsp/abstract-machine/extra.ld
index 772a18523..61e9f2b22 100644
--- a/bsp/abstract-machine/extra.ld
+++ b/bsp/abstract-machine/extra.ld
@@ -27,10 +27,7 @@ SECTIONS {
     *(__am_apps.sdata*)
     __am_apps_data_end = .;
     . = ALIGN(8);
-  } > sdram AT> flash
-  __extra_data_lma_start = LOADADDR(.data.extra);
-  __extra_data_vma_start = ADDR(.data.extra);
-  __extra_data_size = SIZEOF(.data.extra);
+  }
 }
 INSERT BEFORE .data;
 
@@ -43,6 +40,7 @@ SECTIONS {
     *(__am_apps.scommon*)
     __am_apps_bss_end = .;
     . = ALIGN(8);
-  } > sdram AT> flash
+  }
 }
 INSERT BEFORE .bss;
+
diff --git a/bsp/abstract-machine/extra_riscv32e-ysyxsoc.ld b/bsp/abstract-machine/extra_riscv32e-ysyxsoc.ld
new file mode 100644
index 000000000..772a18523
--- /dev/null
+++ b/bsp/abstract-machine/extra_riscv32e-ysyxsoc.ld
@@ -0,0 +1,48 @@
+SECTIONS {
+  .data.extra : {
+    /* section information for finsh shell */
+    __fsymtab_start = .;
+    KEEP(*(FSymTab))
+    __fsymtab_end = .;
+    . = ALIGN(8);
+    __vsymtab_start = .;
+    KEEP(*(VSymTab))
+    __vsymtab_end = .;
+    . = ALIGN(8);
+
+    /* section information for initial. */
+    . = ALIGN(8);
+    __rt_init_start = .;
+    KEEP(*(SORT(.rti_fn*)))
+    __rt_init_end = .;
+    . = ALIGN(8);
+
+    __rt_utest_tc_tab_start = .;
+    KEEP(*(UtestTcTab))
+    __rt_utest_tc_tab_end = .;
+
+    . = ALIGN(8);
+    __am_apps_data_start = .;
+    *(__am_apps.data*)
+    *(__am_apps.sdata*)
+    __am_apps_data_end = .;
+    . = ALIGN(8);
+  } > sdram AT> flash
+  __extra_data_lma_start = LOADADDR(.data.extra);
+  __extra_data_vma_start = ADDR(.data.extra);
+  __extra_data_size = SIZEOF(.data.extra);
+}
+INSERT BEFORE .data;
+
+SECTIONS {
+  .bss.extra : {
+    . = ALIGN(8);
+    __am_apps_bss_start = .;
+    *(__am_apps.bss*)
+    *(__am_apps.sbss*)
+    *(__am_apps.scommon*)
+    __am_apps_bss_end = .;
+    . = ALIGN(8);
+  } > sdram AT> flash
+}
+INSERT BEFORE .bss;
diff --git a/bsp/abstract-machine/src/init.c b/bsp/abstract-machine/src/init.c
index 13ae8fc80..034822907 100644
--- a/bsp/abstract-machine/src/init.c
+++ b/bsp/abstract-machine/src/init.c
@@ -14,12 +14,15 @@ void rt_hw_board_init() {
   int rt_hw_uart_init(void);
   rt_hw_uart_init();
 
+  #ifdef USE_RV32E_YSYXSOC
   /* copy .data.extra from flash LMA to VMA before accessing */
+  printf("Loading .data.extra from flash to memory...\n");
   extern char __extra_data_lma_start, __extra_data_vma_start, __extra_data_size;
   uint32_t extra_data_size = (uint32_t)&__extra_data_size;
   if (extra_data_size > 0) {
     memcpy(&__extra_data_vma_start, &__extra_data_lma_start, extra_data_size);
   }
+  #endif
 
 #ifdef RT_USING_HEAP
   /* initialize memory system */
-- 
2.43.0

