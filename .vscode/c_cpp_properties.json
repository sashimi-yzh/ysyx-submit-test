{
    "version": 4,
    "configurations": [
        {
            "name": "NEMU",
            "compilerPath": "/usr/bin/gcc",
            "intelliSenseMode": "linux-gcc-x64",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "compileCommands": "${workspaceFolder}/.vscode/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/nemu/include",
                "${workspaceFolder}/nemu/src/isa/riscv32/include",
                "${workspaceFolder}/nemu/src/engine/interpreter",
                "${workspaceFolder}/nemu/tools/capstone/repo/include"
            ],
            "defines": [
                "__GUEST_ISA__=riscv32",
                "DEBUG",
                "ITRACE_COND=true",
                "MTRACE_COND=true"
            ],
            "forcedInclude": [
                "${workspaceFolder}/nemu/include/generated/autoconf.h"
            ]
        },
        {
            "name": "NPC",
            "compilerPath": "/usr/bin/g++",
            "intelliSenseMode": "linux-gcc-x64",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "compileCommands": "${workspaceFolder}/.vscode/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/npc/include",
                "${workspaceFolder}/npc/src/isa/riscv32/include",
                "${workspaceFolder}/npc/src/engine/interpreter",
                "${workspaceFolder}/npc/vsrc",
                "${workspaceFolder}/npc/vsrc/core",
                "${workspaceFolder}/npc/tools/capstone/repo/include",
                "${workspaceFolder}/nvboard/usr/include"
            ],
            "defines": [
                "__GUEST_ISA__=riscv32",
                "DEBUG",
                "ITRACE_COND=true",
                "MTRACE_COND=true",
                "NPC_UART_STDOUT_RTL"
            ],
            "forcedInclude": [
                "${workspaceFolder}/npc/include/generated/autoconf.h"
            ]
        }
    ]
}
